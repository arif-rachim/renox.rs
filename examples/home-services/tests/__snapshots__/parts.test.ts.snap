      <p><label>الاسم (بالعربية) <input name="name_ar" dir="rtl" maxlength="120" required value="" id="f-name_ar" aria-required="true"></label></p>
      <p><label>الوحدة <select name="unit" id="f-unit"><option value="piece" selected dir="auto">قطعة</option><option value="metre" dir="auto">متر</option><option value="litre" dir="auto">لتر</option><option value="kg" dir="auto">كيلوغرام</option><option value="box" dir="auto">علبة</option></select></label></p>
      <p><label>التكلفة (درهم) <input name="cost" dir="ltr" inputmode="decimal" size="10" value="0.00" id="f-cost"></label></p>
      <p><label>سعر البيع (درهم) <input name="sell" dir="ltr" inputmode="decimal" size="10" value="0.00" id="f-sell"></label></p>
      <p><label>ضريبة القيمة المضافة <select name="vat_rate" id="f-vat_rate"><option value="5" selected>5%</option><option value="0">0%</option></select></label></p>
      <p><label>الحد الأدنى للمخزون <input name="min_stock" dir="ltr" inputmode="decimal" size="10" value="0" id="f-min_stock"></label></p>
      <p>
        <button type="submit" class="btn-brand" id="save-part">أضف القطعة</button>
        
      </p>
    </form>
  </section>

    </main>
  </div>
  <footer><small dir="auto">فيكس إت للخدمات ذ.م.م، دبي</small></footer>


</body></html>"
`;

exports[`the pages, as the owner sees them /admin/suppliers lists the suppliers with the add form, in English and in Arabic: role: suppliers, owner, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>Suppliers · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Omar Owner</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">Notifications <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/admin/suppliers">
    <select name="org" aria-label="Organisation">
      <option value="org_dubai" selected dir="auto">Dubai · owner</option><option value="org_sharjah" dir="auto">Sharjah · owner</option>
    </select>
    <button type="submit">Switch</button>
    <a href="/org/members">Members</a>
  </form>
</span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/admin/suppliers?lang=ar" lang="ar">العربية</a>
    </nav>
  </header>
  <div class="backoffice">
    <nav class="backoffice-nav" aria-label="Back office">
      <a href="/admin">Dashboard</a>
      <a href="/admin/settings">Branding</a>
      <a href="/admin/branches">Branches</a>
      <a href="/admin/import">Import</a>
      <a href="/admin/parts">Parts</a>
      <a href="/admin/suppliers">Suppliers</a>
      <a href="/admin/whatsapp">WhatsApp</a>
      <a href="/admin/people">People</a>
      <a href="/admin/audit">Audit trail</a>
      <a href="/">Work list</a>
    </nav>
    <main id="main" tabindex="-1">
      
  
  <h1>Suppliers</h1>
  
  <div class="table-scroll" tabindex="0"><table id="suppliers">
    <caption class="visually-hidden">Suppliers</caption>
    <thead>
      <tr><th scope="col">Name</th><th scope="col">TRN</th><th scope="col">Phone</th><th scope="col">Email</th><th scope="col">Status</th><th scope="col">Actions</th></tr>
    </thead>
    <tbody>
      <tr id="supplier-su_00000000000000a1">
        <td dir="auto">Al Noor Trading</td>
        <td dir="ltr">100123456700003</td>
        <td dir="ltr">+97144110088</td>
        <td dir="ltr">orders@alnoor.example</td>
        <td>Active</td>
        <td>
          <a href="/admin/suppliers?edit=su_00000000000000a1#supplier-form" id="edit-su_00000000000000a1">Edit</a>
          <form method="post" action="?/active" hx-post="?/active" class="inline"><input type="hidden" name="_csrf" value="<csrf>">
            <input type="hidden" name="id" value="su_00000000000000a1">
            <input type="hidden" name="active" value="0">
            <button type="submit" id="active-su_00000000000000a1">Deactivate</button>
          </form>
        </td>
      </tr><tr id="supplier-su_00000000000d0002">
        <td dir="auto">Emirates Plumbing Trading</td>
        <td dir="ltr">100456789000003</td>
        <td dir="ltr">+97165550202</td>
        <td dir="ltr">sales@emiratesplumbing.example</td>
        <td>Active</td>
        <td>
          <a href="/admin/suppliers?edit=su_00000000000d0002#supplier-form" id="edit-su_00000000000d0002">Edit</a>
          <form method="post" action="?/active" hx-post="?/active" class="inline"><input type="hidden" name="_csrf" value="<csrf>">
            <input type="hidden" name="id" value="su_00000000000d0002">
            <input type="hidden" name="active" value="0">
            <button type="submit" id="active-su_00000000000d0002">Deactivate</button>
          </form>
        </td>
      </tr><tr id="supplier-su_00000000000d0001">
        <td dir="auto">Gulf Cooling Supplies LLC</td>
        <td dir="ltr">100345678900003</td>
        <td dir="ltr">+97143330101</td>
        <td dir="ltr">orders@gulfcooling.example</td>
        <td>Active</td>
        <td>
          <a href="/admin/suppliers?edit=su_00000000000d0001#supplier-form" id="edit-su_00000000000d0001">Edit</a>
          <form method="post" action="?/active" hx-post="?/active" class="inline"><input type="hidden" name="_csrf" value="<csrf>">
            <input type="hidden" name="id" value="su_00000000000d0001">
            <input type="hidden" name="active" value="0">
            <button type="submit" id="active-su_00000000000d0001">Deactivate</button>
          </form>
        </td>
      </tr><tr id="supplier-su_00000000000000a2">
        <td dir="auto">Old Pipes LLC</td>
        <td dir="ltr"></td>
        <td dir="ltr"></td>
        <td dir="ltr"></td>
        <td>Off</td>
        <td>
          <a href="/admin/suppliers?edit=su_00000000000000a2#supplier-form" id="edit-su_00000000000000a2">Edit</a>
          <form method="post" action="?/active" hx-post="?/active" class="inline"><input type="hidden" name="_csrf" value="<csrf>">
            <input type="hidden" name="id" value="su_00000000000000a2">
            <input type="hidden" name="active" value="1">
            <button type="submit" id="active-su_00000000000000a2">Activate</button>
          </form>
        </td>
      </tr>
    </tbody>
  </table></div>
  <section id="supplier-form">
    <h2>Add a supplier</h2>
    <form method="post" action="?/save" hx-post="?/save" class="stack narrow"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="id" value="">
      <p><label>Name <input name="name" maxlength="120" required value="" id="f-name" aria-required="true" dir="auto"></label></p>
      <p><label>TRN <input name="trn" dir="ltr" maxlength="40" value="" id="f-trn"></label></p>
      <p><label>Phone <input name="phone" type="tel" dir="ltr" maxlength="40" value="" id="f-phone"></label></p>
      <p><label>Email <input name="email" type="email" dir="ltr" maxlength="254" value="" id="f-email"></label></p>
      <p><label>Address <input name="address" maxlength="300" value="" id="f-address" dir="auto"></label></p>
      <p><label>Notes <textarea name="notes" rows="3" maxlength="1000" id="f-notes" dir="auto"></textarea></label></p>
      <p>
        <button type="submit" class="btn-brand" id="save-supplier">Add the supplier</button>
        
      </p>
    </form>
  </section>

    </main>
  </div>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
`;

