  <title>قطع الغيار · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  
</head>
<body>
  <a class="skip" href="#main">تخطَّ إلى المحتوى الرئيسي</a>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Omar Owner</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">الإشعارات <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/admin/parts">
    <select name="org" aria-label="المؤسسة">
      <option value="org_dubai" selected dir="auto">Dubai · مالك</option><option value="org_sharjah" dir="auto">Sharjah · مالك</option>
    </select>
    <button type="submit">تبديل</button>
    <a href="/org/members">الأعضاء</a>
  </form>
</span>
    <nav class="i18n-language" aria-label="اللغة">
      <a href="/admin/parts?lang=en" lang="en">English</a><strong lang="ar">العربية</strong>
    </nav>
  </header>
  <div class="backoffice">
    <nav class="backoffice-nav" aria-label="المكتب الإداري">
      <a href="/admin">الرئيسية</a>
      <a href="/admin/settings">الهوية</a>
      <a href="/admin/branches">الفروع</a>
      <a href="/admin/import">الاستيراد</a>
      <a href="/admin/parts">قطع الغيار</a>
      <a href="/admin/suppliers">الموردون</a>
      <a href="/admin/whatsapp">واتساب</a>
      <a href="/admin/people">الأشخاص</a>
      <a href="/admin/audit">سجل التدقيق</a>
      <a href="/">قائمة العمل</a>
    </nav>
    <main id="main" tabindex="-1">
      
  
  <h1>قطع الغيار</h1>
  
  <form class="search" role="search" action="/admin/parts" method="get">
    <input type="search" name="q" value="" placeholder="ابحث برمز الصنف أو الاسم" aria-label="ابحث برمز الصنف أو الاسم" autocomplete="off" dir="auto">
    <button type="submit">بحث</button>
  </form>
  <div class="table-scroll" tabindex="0"><table id="parts">
    <caption class="visually-hidden">قطع الغيار</caption>
    <thead>
      <tr><th scope="col">رمز الصنف (SKU)</th><th scope="col">الاسم</th><th scope="col">الوحدة</th><th scope="col">التكلفة (درهم)</th><th scope="col">سعر البيع (درهم)</th><th scope="col">الحد الأدنى للمخزون</th><th scope="col">الحالة</th><th scope="col">الإجراءات</th></tr>
    </thead>
    <tbody>
      <tr id="part-pt_00000000000000a2">
        <td dir="ltr">GAS-R32</td>
        <td dir="auto">غاز التبريد R32</td>
        <td dir="auto">كيلوغرام</td>
        <td dir="ltr">45.00 د.إ.</td>
        <td dir="ltr">0.00 د.إ.</td>
        <td dir="ltr">3.5</td>
        <td>متوقفة</td>
        <td>
          <a href="/admin/parts?edit=pt_00000000000000a2#part-form" id="edit-pt_00000000000000a2">تعديل</a>
          <form method="post" action="?/active" hx-post="?/active" class="inline"><input type="hidden" name="_csrf" value="<csrf>">
            <input type="hidden" name="id" value="pt_00000000000000a2">
            <input type="hidden" name="active" value="1">
            <button type="submit" id="active-pt_00000000000000a2">تفعيل</button>
          </form>
        </td>
      </tr><tr id="part-pt_00000000000000a1">
        <td dir="ltr">PIPE-15</td>
        <td dir="auto">أنبوب نحاسي 15 مم</td>
        <td dir="auto">متر</td>
        <td dir="ltr">8.50 د.إ.</td>
        <td dir="ltr">14.00 د.إ.</td>
        <td dir="ltr">20</td>
        <td>نشطة</td>
        <td>
          <a href="/admin/parts?edit=pt_00000000000000a1#part-form" id="edit-pt_00000000000000a1">تعديل</a>
          <form method="post" action="?/active" hx-post="?/active" class="inline"><input type="hidden" name="_csrf" value="<csrf>">
            <input type="hidden" name="id" value="pt_00000000000000a1">
            <input type="hidden" name="active" value="0">
            <button type="submit" id="active-pt_00000000000000a1">إيقاف</button>
          </form>
        </td>
      </tr>
    </tbody>
  </table></div>
  
  <section id="part-form">
    <h2>إضافة قطعة</h2>
    <form method="post" action="?/save" hx-post="?/save" class="stack narrow"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="id" value="">
      <p><label>رمز الصنف (SKU) <input name="sku" dir="ltr" maxlength="32" required autocapitalize="characters" value="" id="f-sku" aria-required="true"></label></p>
      <p><label>الاسم (بالإنجليزية) <input name="name_en" maxlength="120" required value="" id="f-name_en" aria-required="true" dir="auto"></label></p>
      <p><label>الاسم (بالعربية) <input name="name_ar" dir="rtl" maxlength="120" required value="" id="f-name_ar" aria-required="true"></label></p>
      <p><label>الوحدة <select name="unit" id="f-unit"><option value="piece" selected dir="auto">قطعة</option><option value="metre" dir="auto">متر</option><option value="litre" dir="auto">لتر</option><option value="kg" dir="auto">كيلوغرام</option><option value="box" dir="auto">علبة</option></select></label></p>
      <p><label>التكلفة (درهم) <input name="cost" dir="ltr" inputmode="decimal" size="10" value="0.00" id="f-cost"></label></p>
      <p><label>سعر البيع (درهم) <input name="sell" dir="ltr" inputmode="decimal" size="10" value="0.00" id="f-sell"></label></p>
      <p><label>ضريبة القيمة المضافة <select name="vat_rate" id="f-vat_rate"><option value="5" selected>5%</option><option value="0">0%</option></select></label></p>
      <p><label>الحد الأدنى للمخزون <input name="min_stock" dir="ltr" inputmode="decimal" size="10" value="0" id="f-min_stock"></label></p>
      <p>
        <button type="submit" class="btn-brand" id="save-part">أضف القطعة</button>
        
      </p>
    </form>
  </section>

    </main>
  </div>
  <footer><small dir="auto">فيكس إت للخدمات ذ.م.م، دبي</small></footer>


</body></html>"
`;

exports[`the pages, as the owner sees them /admin/suppliers lists the suppliers with the add form, in English and in Arabic: role: suppliers, owner, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
