exports[`the pages, as the owner sees them /admin/parts lists the parts with the add form, in English and in Arabic: role: parts, owner, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>Parts · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Omar Owner</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">Notifications <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/admin/parts">
    <select name="org" aria-label="Organisation">
      <option value="org_dubai" selected dir="auto">Dubai · owner</option><option value="org_sharjah" dir="auto">Sharjah · owner</option>
    </select>
    <button type="submit">Switch</button>
    <a href="/org/members">Members</a>
  </form>
</span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/admin/parts?lang=ar" lang="ar">العربية</a>
    </nav>
  </header>
  <div class="backoffice">
    <nav class="backoffice-nav" aria-label="Back office">
      <a href="/admin">Dashboard</a>
      <a href="/admin/settings">Branding</a>
      <a href="/admin/branches">Branches</a>
      <a href="/admin/import">Import</a>
      <a href="/admin/parts">Parts</a>
      <a href="/admin/suppliers">Suppliers</a>
      <a href="/admin/whatsapp">WhatsApp</a>
      <a href="/admin/people">People</a>
      <a href="/admin/audit">Audit trail</a>
      <a href="/">Work list</a>
    </nav>
    <main id="main" tabindex="-1">
      
  
  <h1>Parts</h1>
  
  <form class="search" role="search" action="/admin/parts" method="get">
    <input type="search" name="q" value="" placeholder="Search by SKU or name" aria-label="Search by SKU or name" autocomplete="off" dir="auto">
    <button type="submit">Search</button>
  </form>
  <div class="table-scroll" tabindex="0"><table id="parts">
    <caption class="visually-hidden">Parts</caption>
    <thead>
      <tr><th scope="col">SKU</th><th scope="col">Name</th><th scope="col">Unit</th><th scope="col">Cost (AED)</th><th scope="col">Selling price (AED)</th><th scope="col">Minimum stock</th><th scope="col">Status</th><th scope="col">Actions</th></tr>
    </thead>
    <tbody>
      <tr id="part-pt_00000000000000a2">
        <td dir="ltr">GAS-R32</td>
        <td dir="auto">R32 refrigerant</td>
        <td dir="auto">kg</td>
        <td dir="ltr">AED 45.00</td>
        <td dir="ltr">AED 0.00</td>
        <td dir="ltr">3.5</td>
        <td>Off</td>
        <td>
          <a href="/admin/parts?edit=pt_00000000000000a2#part-form" id="edit-pt_00000000000000a2">Edit</a>
          <form method="post" action="?/active" hx-post="?/active" class="inline"><input type="hidden" name="_csrf" value="<csrf>">
            <input type="hidden" name="id" value="pt_00000000000000a2">
            <input type="hidden" name="active" value="1">
            <button type="submit" id="active-pt_00000000000000a2">Activate</button>
          </form>
        </td>
      </tr><tr id="part-pt_00000000000000a1">
        <td dir="ltr">PIPE-15</td>
        <td dir="auto">Copper pipe 15 mm</td>
        <td dir="auto">metre</td>
        <td dir="ltr">AED 8.50</td>
        <td dir="ltr">AED 14.00</td>
        <td dir="ltr">20</td>
        <td>Active</td>
        <td>
          <a href="/admin/parts?edit=pt_00000000000000a1#part-form" id="edit-pt_00000000000000a1">Edit</a>
          <form method="post" action="?/active" hx-post="?/active" class="inline"><input type="hidden" name="_csrf" value="<csrf>">
            <input type="hidden" name="id" value="pt_00000000000000a1">
            <input type="hidden" name="active" value="0">
            <button type="submit" id="active-pt_00000000000000a1">Deactivate</button>
          </form>
        </td>
      </tr>
    </tbody>
  </table></div>
  
  <section id="part-form">
    <h2>Add a part</h2>
    <form method="post" action="?/save" hx-post="?/save" class="stack narrow"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="id" value="">
      <p><label>SKU <input name="sku" dir="ltr" maxlength="32" required autocapitalize="characters" value="" id="f-sku" aria-required="true"></label></p>
      <p><label>Name (English) <input name="name_en" maxlength="120" required value="" id="f-name_en" aria-required="true" dir="auto"></label></p>
      <p><label>Name (Arabic) <input name="name_ar" dir="rtl" maxlength="120" required value="" id="f-name_ar" aria-required="true"></label></p>
      <p><label>Unit <select name="unit" id="f-unit"><option value="piece" selected dir="auto">piece</option><option value="metre" dir="auto">metre</option><option value="litre" dir="auto">litre</option><option value="kg" dir="auto">kg</option><option value="box" dir="auto">box</option></select></label></p>
      <p><label>Cost (AED) <input name="cost" dir="ltr" inputmode="decimal" size="10" value="0.00" id="f-cost"></label></p>
      <p><label>Selling price (AED) <input name="sell" dir="ltr" inputmode="decimal" size="10" value="0.00" id="f-sell"></label></p>
      <p><label>VAT <select name="vat_rate" id="f-vat_rate"><option value="5" selected>5%</option><option value="0">0%</option></select></label></p>
      <p><label>Minimum stock <input name="min_stock" dir="ltr" inputmode="decimal" size="10" value="0" id="f-min_stock"></label></p>
      <p>
        <button type="submit" class="btn-brand" id="save-part">Add the part</button>
        
      </p>
    </form>
  </section>

    </main>
  </div>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
`;

exports[`the pages, as the owner sees them /admin/parts lists the parts with the add form, in English and in Arabic: role: parts, owner, ar 1`] = `
"<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
