      <tr><th scope="row" colspan="3">الإجمالي</th><td dir="ltr"><strong dir="auto">357.00 د.إ.</strong></td></tr>
      <tr><th scope="row" colspan="3">الرصيد</th><td dir="ltr" id="invoice-balance">207.00 د.إ.</td></tr>
    </tfoot>
  </table></div>
