  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>زيارتك · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  <link rel="preload" as="font" type="font/woff2" crossorigin="" href="/fonts/noto-sans-arabic-arabic-400-normal.woff2">
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  <meta name="theme-color" content="#1f6f5c">
</head>
<body>
  <a class="skip" href="#main">تخطَّ إلى المحتوى الرئيسي</a>
  <header class="site-header">
    <a href="/my" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <nav class="i18n-language" aria-label="اللغة">
      <a href="/my/visits/jb_seed_13?lang=en" lang="en">English</a><strong lang="ar">العربية</strong>
    </nav>
    <form method="post" action="?/signout" hx-post="?/signout" class="inline"><input type="hidden" name="_csrf" value="<csrf>"><button type="submit">تسجيل الخروج</button></form>
  </header>
  <main id="main" tabindex="-1">
    
  
  <p><a href="/my">العودة إلى حسابي</a></p>
  <h1 dir="auto">سباكة <span dir="ltr">J-000013</span></h1>
  <p><span class="status status-invoiced" id="visit-status" dir="auto">تمت</span></p>
  <dl class="detail" id="visit-detail">
    <dt>الموعد</dt>
    <dd dir="auto"><weekday> <span dir="ltr"><day></span> <span dir="ltr"><time>–<time></span></dd>
    <dt>المكان</dt>
    <dd dir="auto">Apartment · Marina Crown, flat 1203, Dubai Marina</dd>
    <dt>الفني:</dt>
    <dd id="visit-technician" dir="auto">Bilal</dd>
    
    
    <dt>لديك سؤال؟ اتصل بنا</dt>
    <dd dir="auto">دبي · <a href="tel:+97140000001" dir="ltr" id="branch-phone">+97140000001</a></dd>
  </dl>

  <section aria-labelledby="timeline-title">
    <h2 id="timeline-title">ما تم حتى الآن</h2>
    <ol class="my-timeline" id="timeline">
      <li dir="auto">تم الطلب · <span dir="ltr"><day> <time></span></li>
    </ol>
  </section>

  <section aria-labelledby="report-title" id="visit-report">
    <h2 id="report-title">تقرير الزيارة</h2>
    
      <h3>ما تم إنجازه</h3>
      <p dir="auto" id="report-summary">تم استبدال صنبور المطبخ بخلاط جديد. كان الصنبور القديم يحتوي على حشية متآكلة.</p>
    
    
      <h3>القطع المستخدمة</h3>
      <ul id="report-parts">
        <li dir="auto">Kitchen mixer tap × <span dir="ltr">1</span></li>
      </ul>
    
    
      <h3>قبل</h3>
      <ul class="photos" id="photos-before">
        <li><a href="/my/visits/jb_seed_13/photo/1">فتح الصورة</a><small dir="auto">The old tap</small></li>
      </ul>
    
    
      <h3>بعد</h3>
      <ul class="photos" id="photos-after">
        <li><a href="/my/visits/jb_seed_13/photo/2">فتح الصورة</a><small dir="auto">The new mixer</small></li>
      </ul>
    
    <p id="report-signed" dir="auto">وقّع Customer · <span dir="ltr"><day> <time></span></p>
    <p><a href="/my/visits/jb_seed_13/report" class="btn-brand" id="report-pdf">تنزيل التقرير (PDF)</a></p>
  </section>

  </main>
  <footer><small dir="auto">فيكس إت للخدمات ذ.م.م، دبي</small></footer>


</body></html>"
`;

