  </header>
  <main id="main" tabindex="-1">
    
  
  <p><a href="/my">العودة إلى حسابي</a></p>
  <h1>الفواتير</h1>
  <p class="notice" id="open-sum">المبلغ المستحق على فواتيرك المفتوحة: <strong dir="ltr">207.00 د.إ.</strong> (<span dir="ltr">1</span> مفتوحة)</p>
  <div class="table-scroll" tabindex="0"><table id="my-invoices">
    <caption class="visually-hidden">الفواتير</caption>
    <thead><tr><th scope="col">الفاتورة</th><th scope="col">التاريخ</th><th scope="col">مقابل</th><th scope="col">الإجمالي شامل الضريبة</th><th scope="col">الحالة</th></tr></thead>
    <tbody>
      <tr id="invoice-INV-000001">
        <td dir="ltr"><a href="/my/invoices/INV-000001" dir="auto">INV-000001</a></td>
        <td dir="ltr"><day></td>
        <td>سباكة</td>
        <td dir="ltr">357.00 د.إ.</td>
        <td>
          <span class="status status-open">مفتوحة، تستحق في</span> <span dir="ltr"><day></span>
        </td>
      </tr>
    </tbody>
  </table></div>
  

  </main>
  <footer><small dir="auto">فيكس إت للخدمات ذ.م.م، دبي</small></footer>


</body></html>"
`;

