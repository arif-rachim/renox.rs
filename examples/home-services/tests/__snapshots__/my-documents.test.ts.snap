  <p><span class="status status-part-paid" id="invoice-status" dir="auto">مدفوعة جزئياً</span> · تاريخ الإصدار: <span dir="ltr"><day></span></p>
  <div class="table-scroll" tabindex="0"><table id="invoice-lines">
    <caption class="visually-hidden">البنود</caption>
    <thead><tr><th scope="col">الوصف</th><th scope="col">الكمية</th><th scope="col">الصافي</th><th scope="col">الضريبة</th></tr></thead>
    <tbody>
      <tr>
        <td dir="auto">Plumbing</td>
        <td dir="ltr">1</td>
        <td dir="ltr">160.00 د.إ.</td>
        <td dir="ltr">8.00 د.إ. <bdi dir="ltr">(5 %)</bdi></td>
      </tr><tr>
        <td dir="auto">Kitchen mixer tap</td>
        <td dir="ltr">1</td>
        <td dir="ltr">180.00 د.إ.</td>
        <td dir="ltr">9.00 د.إ. <bdi dir="ltr">(5 %)</bdi></td>
      </tr>
    </tbody>
