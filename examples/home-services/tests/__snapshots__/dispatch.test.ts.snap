// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`the board page columns by status, with the branch's cards and the socket of its branch: role: dispatch board, dispatcher, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>Dispatch board · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  <link rel="manifest" href="/me/manifest" crossorigin="use-credentials">
  <meta name="theme-color" content="#1f6f5c">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href="/icons/icon-192.<hash>.png">
  <script src="/me.<hash>.js" defer nonce="<nonce>"></script>
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Dina Dispatcher</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">Notifications <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/dispatch">
    <select name="org" aria-label="Organisation">
      <option value="org_dubai" selected dir="auto">Dubai · member</option>
    </select>
    <button type="submit">Switch</button>
    
  </form>
</span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/dispatch?lang=ar" lang="ar">العربية</a>
    </nav>
  </header>
  <main id="main" tabindex="-1">
    
  
  <h1>Dispatch board</h1>
  <p class="muted" id="board-state" data-socket="/ws/dispatch/dubai" data-offline="Not connected. Reload the page.">Live: the board updates when a job changes.</p>
  <div aria-live="polite" class="visually-hidden" id="board-announcer" data-new="New job {number} in {column}." data-moved="Job {number} moved to {column}." data-updated="Job {number} updated in {column}."></div>
  <div class="board" id="board">
    <section class="board-column" aria-labelledby="head-new">
      <h2 id="head-new" dir="auto">New</h2>
      <div id="col-new" class="board-cards">
        <article id="job-jb_seed_01" class="job-card priority-urgent"><a href="/jobs/jb_seed_01" dir="ltr">J-000001</a> <strong dir="auto">Layla Haddad</strong> <span dir="auto">AC repair</span> <small></small>  <span class="priority" dir="auto">Urgent</span></article><article id="job-jb_seed_02" class="job-card priority-normal"><a href="/jobs/jb_seed_02" dir="ltr">J-000002</a> <strong dir="auto">Peter Nowak</strong> <span dir="auto">Electrical</span> <small></small>  </article><article id="job-jb_seed_03" class="job-card priority-high"><a href="/jobs/jb_seed_03" dir="ltr">J-000003</a> <strong dir="auto">Marina Heights Property Management</strong> <span dir="auto">Plumbing</span> <small></small>  <span class="priority" dir="auto">High</span></article><article id="job-jb_seed_04" class="job-card priority-low"><a href="/jobs/jb_seed_04" dir="ltr">J-000004</a> <strong dir="auto">Al Barsha Facilities LLC</strong> <span dir="auto">Handyman</span> <small></small>  <span class="priority" dir="auto">Low</span></article>
      </div>
    </section><section class="board-column" aria-labelledby="head-scheduled">
      <h2 id="head-scheduled" dir="auto">Scheduled</h2>
      <div id="col-scheduled" class="board-cards">
        <article id="job-jb_seed_05" class="job-card priority-normal"><a href="/jobs/jb_seed_05" dir="ltr">J-000005</a> <strong dir="auto">Layla Haddad</strong> <span dir="auto">AC service</span> <small></small> <em dir="auto">Ali Hassan</em> </article><article id="job-jb_seed_06" class="job-card priority-normal"><a href="/jobs/jb_seed_06" dir="ltr">J-000006</a> <strong dir="auto">Peter Nowak</strong> <span dir="auto">Pest control</span> <small></small> <em dir="auto">Ali Hassan</em> </article><article id="job-jb_seed_07" class="job-card priority-high"><a href="/jobs/jb_seed_07" dir="ltr">J-000007</a> <strong dir="auto">Marina Heights Property Management</strong> <span dir="auto">Plumbing</span> <small></small> <em dir="auto">Bilal Raza</em> <span class="priority" dir="auto">High</span></article><article id="job-jb_seed_08" class="job-card priority-normal"><a href="/jobs/jb_seed_08" dir="ltr">J-000008</a> <strong dir="auto">Fatima Al Suwaidi</strong> <span dir="auto">Deep cleaning</span> <small></small> <em dir="auto">Bilal Raza</em> </article>
      </div>
    </section><section class="board-column" aria-labelledby="head-en_route">
      <h2 id="head-en_route" dir="auto">En route</h2>
      <div id="col-en_route" class="board-cards">
        <article id="job-jb_seed_09" class="job-card priority-high"><a href="/jobs/jb_seed_09" dir="ltr">J-000009</a> <strong dir="auto">Marina Heights Property Management</strong> <span dir="auto">Electrical</span> <small></small> <em dir="auto">Bilal Raza</em> <span class="priority" dir="auto">High</span></article>
      </div>
    </section><section class="board-column" aria-labelledby="head-in_progress">
      <h2 id="head-in_progress" dir="auto">In progress</h2>
      <div id="col-in_progress" class="board-cards">
        <article id="job-jb_seed_10" class="job-card priority-normal"><a href="/jobs/jb_seed_10" dir="ltr">J-000010</a> <strong dir="auto">Al Barsha Facilities LLC</strong> <span dir="auto">AC repair</span> <small></small> <em dir="auto">Ali Hassan</em> </article>
      </div>
    </section><section class="board-column" aria-labelledby="head-done">
      <h2 id="head-done" dir="auto">Done</h2>
      <div id="col-done" class="board-cards">
        <article id="job-jb_seed_11" class="job-card priority-normal"><a href="/jobs/jb_seed_11" dir="ltr">J-000011</a> <strong dir="auto">Peter Nowak</strong> <span dir="auto">Handyman</span> <small></small> <em dir="auto">Bilal Raza</em> </article>
      </div>
    </section>
  </div>
  <p><a href="/jobs">Jobs</a></p>
  <script nonce="<nonce>">
    (() => {
      // One socket per page. Every message is a fragment the server rendered
      // (partials/job-card.html): a \`delete\` of the card's old place, then the
      // card put first in its column. The feed's \`{ table, rowid, op }\` frames
      // are JSON, not HTML, and are skipped. Every change is also written, as
      // one sentence, to the polite live region (#board-announcer) for a screen
      // reader: a new card, a card in another column, a card changed in place.
      const state = document.getElementById("board-state");
      const announcer = document.getElementById("board-announcer");
      const say = (text) => {
        announcer.textContent = "";
        setTimeout(() => { announcer.textContent = text; }, 50);
      };
      const sentence = (kind, number, column) => (announcer.dataset[kind] || "").replace("{number}", number).replace("{column}", column);
      const columnName = (colId) => { const h = document.getElementById("head-" + colId.slice(4)); return h ? h.textContent.trim() : ""; };
      const url = new URL(state.dataset.socket, location.href);
      url.protocol = location.protocol === "https:" ? "wss:" : "ws:";
      const socket = new WebSocket(url);
      socket.addEventListener("message", (e) => {
        if (typeof e.data !== "string" || e.data.trimStart().startsWith("{")) return;
        const tpl = document.createElement("template");
        tpl.innerHTML = e.data;
        const was = new Map();
        for (const el of tpl.content.querySelectorAll("[hx-swap-oob]")) {
          const mode = el.getAttribute("hx-swap-oob");
          if (mode === "delete") {
            const old = document.getElementById(el.id);
            if (old) {
              was.set(el.id, old.parentElement ? old.parentElement.id : "");
              old.remove();
            }
          } else if (mode === "afterbegin") {
            const col = document.getElementById(el.id);
            if (!col) continue;
            const card = el.firstElementChild;
            col.prepend(...el.childNodes);
            const number = card && card.querySelector("a") ? card.querySelector("a").textContent.trim() : "";
            const before = card ? was.get(card.id) : undefined;
            if (before === undefined) say(sentence("new", number, columnName(el.id)));
            else if (before !== el.id) say(sentence("moved", number, columnName(el.id)));
            else say(sentence("updated", number, columnName(el.id)));
          }
        }
      });
      socket.addEventListener("close", () => { state.textContent = state.dataset.offline || "Not connected. Reload the page."; say(state.textContent); });
    })();
  </script>

  </main>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
`;
