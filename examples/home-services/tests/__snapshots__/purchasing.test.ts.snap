    <form method="post" action="?/cancel" hx-post="?/cancel" class="inline"><input type="hidden" name="_csrf" value="<csrf>">
      <button type="submit" id="cancel-po">Cancel the order</button>
    </form>
  </section>

    </main>
  </div>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
`;

