        <td dir="ltr">AED 9.00</td>
        <td dir="ltr">AED 22.50</td>
        <td dir="ltr">AED 1.13 <bdi dir="ltr">(5%)</bdi></td>
        <td dir="ltr">AED 23.63</td>
        <td dir="ltr">0</td>
        
      </tr>
