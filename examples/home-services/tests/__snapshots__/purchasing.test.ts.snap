  <h1 dir="ltr">PO-000010</h1>
  <p><span class="status status-sent" id="po-status" dir="auto">Sent</span></p>
  
  
  <dl class="detail">
    <dt>Supplier</dt>
    <dd><span dir="auto">Al Noor Trading<br><span>TRN: <bdi dir="ltr">100123456700003</bdi><br></span><bdi dir="ltr">orders@alnoor.example</bdi></span></dd>
