    </tfoot>
  </table></div>
  <p id="pdf-links">PDF: <a id="pdf-en" href="/admin/purchasing/po_<id>/pdf?lang=en" lang="en">English</a> · <a id="pdf-ar" href="/admin/purchasing/po_<id>/pdf?lang=ar" lang="ar">العربية</a></p>

  <section id="line-form">
    <h2>Add a line</h2>
    <form method="post" action="?/add_line" hx-post="?/add_line" class="stack narrow" id="add-line-form"><input type="hidden" name="_csrf" value="<csrf>">
      <p><label>Part <select name="part" id="f-line-part" required aria-required="true"><option value=""></option><option value="pt_0000000000815a01" dir="auto">AC-FILTER: AC filter (6.00)</option><option value="pt_00000000000d0003" dir="auto">CAP-35UF: Run capacitor 35 uF (22.00)</option><option value="pt_00000000000d0004" dir="auto">CAP-45UF: Run capacitor 45 uF (26.00)</option><option value="pt_00000000000d000c" dir="auto">DESCALE-KIT: Descaling kit (20.00)</option><option value="pt_00000000000d0002" dir="auto">FIL-AC-C: AC filter, cassette unit (18.00)</option><option value="pt_00000000000d0001" dir="auto">FIL-AC-S: AC filter, split unit (12.00)</option><option value="pt_00000000000d000b" dir="auto">MIXER-TAP: Kitchen mixer tap (110.00)</option><option value="pt_0000000000815a02" dir="auto">PIPE-15: Copper pipe 15 mm (10.00)</option><option value="pt_00000000000d0007" dir="auto">PVC-ELB-25: PVC elbow 25 mm (1.50)</option><option value="pt_00000000000d0009" dir="auto">PVC-PIPE-25: PVC pipe 25 mm (4.50)</option><option value="pt_00000000000d0008" dir="auto">PVC-TEE-25: PVC tee 25 mm (2.00)</option><option value="pt_00000000000d0006" dir="auto">REF-R22: Refrigerant R22 (45.00)</option><option value="pt_00000000000d0005" dir="auto">REF-R410A: Refrigerant R410A (38.00)</option><option value="pt_00000000000d000a" dir="auto">SEAL-SIL-CL: Silicone sealant, clear (11.00)</option></select></label></p>
      <p><label>Quantity <input name="qty" dir="ltr" inputmode="decimal" size="10" required aria-required="true" id="f-line-qty" value=""></label></p>
      <p><label>Unit cost (AED) <input name="unit_cost" dir="ltr" inputmode="decimal" size="10" id="f-line-unit_cost" value=""></label> <small class="muted">Leave blank for the part&#39;s cost.</small></p>
      <p><button type="submit" class="btn-brand" id="add-line">Add the line</button></p>
    </form>
  </section>

  

  <section id="po-actions">
    <form method="post" action="?/send" hx-post="?/send" class="inline"><input type="hidden" name="_csrf" value="<csrf>">
      <button type="submit" class="btn-brand" id="send-po">Send to the supplier</button>
