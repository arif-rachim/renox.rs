    </nav>
    <main id="main" tabindex="-1">
      
  
  <p><a href="/admin/purchasing">Back to purchase orders</a></p>
  <h1 dir="ltr">PO-<n></h1>
  <p><span class="status status-draft" id="po-status" dir="auto">Draft</span></p>
  
  
  <dl class="detail">
    <dt>Supplier</dt>
    <dd><span dir="auto">Al Noor Trading<br><span>TRN: <bdi dir="ltr">100123456700003</bdi><br></span><bdi dir="ltr">orders@alnoor.example</bdi></span></dd>
    <dt>Delivery branch</dt>
    <dd dir="auto">Dubai</dd>
    <dt>Language of the document</dt>
    <dd dir="auto">English</dd>
    <dt>Created</dt>
    <dd dir="ltr"><date></dd>
    
    
    
    
    
    
  </dl>
  
