exports[`snapshots the list and an order, in English and in Arabic: role: purchase orders sent, manager, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>Purchase orders · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Mona Manager</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">Notifications <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/admin/purchasing">
    <select name="org" aria-label="Organisation">
      <option value="org_dubai" selected dir="auto">Dubai · admin</option>
    </select>
    <button type="submit">Switch</button>
    <a href="/org/members">Members</a>
  </form>
</span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/admin/purchasing?status=sent&amp;lang=ar" lang="ar">العربية</a>
    </nav>
  </header>
  <div class="backoffice">
    <nav class="backoffice-nav" aria-label="Back office">
      <a href="/admin">Dashboard</a>
      <a href="/admin/settings">Branding</a>
      <a href="/admin/branches">Branches</a>
      <a href="/admin/import">Import</a>
      <a href="/admin/parts">Parts</a>
      <a href="/admin/suppliers">Suppliers</a>
      <a href="/admin/whatsapp">WhatsApp</a>
      <a href="/admin/people">People</a>
      <a href="/admin/audit">Audit trail</a>
      <a href="/">Work list</a>
    </nav>
    <main id="main" tabindex="-1">
      
  
  <h1>Purchase orders</h1>
  <h2 id="branch-name" dir="auto">Dubai</h2>
  <form class="search" role="search" action="/admin/purchasing" method="get">
    <label>Status
      <select name="status">
        <option value="">—</option>
        <option value="draft" dir="auto">Draft</option><option value="sent" selected dir="auto">Sent</option><option value="partly_received" dir="auto">Partly received</option><option value="received" dir="auto">Received</option><option value="cancelled" dir="auto">Cancelled</option>
      </select></label>
    <label>Supplier
      <select name="supplier">
        <option value="">—</option>
        <option value="su_0000000000815a01" dir="auto">Al Noor Trading</option><option value="su_0000000000815a03" dir="auto">Closed Supplier</option><option value="su_00000000000d0002" dir="auto">Emirates Plumbing Trading</option><option value="su_00000000000d0001" dir="auto">Gulf Cooling Supplies LLC</option><option value="su_0000000000815a02" dir="auto">Walk-in Pipes</option>
      </select></label>
    <button type="submit">Filter</button>
  </form>
  <div class="table-scroll" tabindex="0"><table id="orders">
    <caption class="visually-hidden">Purchase orders</caption>
    <thead>
      <tr><th scope="col">Number</th><th scope="col">Supplier</th><th scope="col">Status</th><th scope="col">Created</th><th scope="col">Expected on</th><th scope="col">Total</th></tr>
    </thead>
    <tbody>
      <tr id="po-po_<id>">
        <td dir="ltr"><a href="/admin/purchasing/po_<id>" dir="auto">PO-000010</a></td>
        <td dir="auto">Al Noor Trading</td>
        <td><span class="status status-sent" dir="auto">Sent</span></td>
        <td dir="ltr"><date></td>
        <td dir="ltr"><date></td>
        <td dir="ltr">AED 40.96</td>
      </tr><tr id="po-po_<id>">
        <td dir="ltr"><a href="/admin/purchasing/po_<id>" dir="auto">PO-DEMO02</a></td>
        <td dir="auto">Gulf Cooling Supplies LLC</td>
        <td><span class="status status-sent" dir="auto">Sent</span></td>
        <td dir="ltr"><date></td>
        <td dir="ltr"><date></td>
        <td dir="ltr">AED 945.00</td>
      </tr>
    </tbody>
  </table></div>
  
  <section id="po-form">
    <h2>New purchase order</h2>
    <form method="post" action="?/create" hx-post="?/create" class="stack narrow"><input type="hidden" name="_csrf" value="<csrf>">
      <p><label>Supplier <select name="supplier" id="f-supplier" required aria-required="true"><option value=""></option><option value="su_0000000000815a01" dir="auto">Al Noor Trading</option><option value="su_00000000000d0002" dir="auto">Emirates Plumbing Trading</option><option value="su_00000000000d0001" dir="auto">Gulf Cooling Supplies LLC</option><option value="su_0000000000815a02" dir="auto">Walk-in Pipes</option></select></label></p>
      <p><label>Language of the document <select name="language" id="f-language"><option value="en" selected>English</option><option value="ar">العربية</option></select></label></p>
      <p><label>Expected on <input name="expected_on" type="date" dir="ltr" id="f-expected_on"></label></p>
      <p><label>Notes <textarea name="notes" rows="3" maxlength="1000" id="f-notes" dir="auto"></textarea></label></p>
      <p><button type="submit" class="btn-brand" id="create-po">Create the purchase order</button></p>
    </form>
  </section>

    </main>
  </div>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
`;

