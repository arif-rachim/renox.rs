        <p><span class="status status-done" dir="auto">تمت</span> · <a href="/my/visits/jb_my_past_1">تفاصيل الزيارة <span dir="ltr">J-000931</span></a></p>
      </li><li id="past-jb_my_past_2">
        <p dir="auto"><span dir="ltr"><day></span> · <strong dir="auto">أعمال صيانة عامة</strong> · Villa · <span class="my-branch" dir="auto">الفرع: دبي</span></p>
        <p><span class="status status-done" dir="auto">تمت</span> · <a href="/my/visits/jb_my_past_2">تفاصيل الزيارة <span dir="ltr">J-000932</span></a></p>
      </li><li id="past-jb_my_past_3">
        <p dir="auto"><span dir="ltr"><day></span> · <strong dir="auto">أعمال صيانة عامة</strong> · Villa · <span class="my-branch" dir="auto">الفرع: دبي</span></p>
        <p><span class="status status-done" dir="auto">تمت</span> · <a href="/my/visits/jb_my_past_3">تفاصيل الزيارة <span dir="ltr">J-000933</span></a></p>
      </li><li id="past-jb_my_past_4">
        <p dir="auto"><span dir="ltr"><day></span> · <strong dir="auto">أعمال صيانة عامة</strong> · Villa · <span class="my-branch" dir="auto">الفرع: دبي</span></p>
        <p><span class="status status-done" dir="auto">تمت</span> · <a href="/my/visits/jb_my_past_4">تفاصيل الزيارة <span dir="ltr">J-000934</span></a></p>
      </li><li id="past-jb_my_past_5">
