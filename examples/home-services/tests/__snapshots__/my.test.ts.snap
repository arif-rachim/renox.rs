exports[`/my/visits/<id> Arabic: right to left, the timeline in Arabic: role: my visit, portal customer, ar 1`] = `
"<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>زيارتك · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  <link rel="preload" as="font" type="font/woff2" crossorigin="" href="/fonts/noto-sans-arabic-arabic-400-normal.woff2">
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  <meta name="theme-color" content="#1f6f5c">
</head>
<body>
  <a class="skip" href="#main">تخطَّ إلى المحتوى الرئيسي</a>
  <header class="site-header">
    <a href="/my" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <nav class="i18n-language" aria-label="اللغة">
      <a href="/my/visits/jb_seed_06?lang=en" lang="en">English</a><strong lang="ar">العربية</strong>
    </nav>
    <form method="post" action="?/signout" hx-post="?/signout" class="inline"><input type="hidden" name="_csrf" value="<csrf>"><button type="submit">تسجيل الخروج</button></form>
  </header>
  <main id="main" tabindex="-1">
    
  
  <p><a href="/my">العودة إلى حسابي</a></p>
  <h1 dir="auto">مكافحة الحشرات <span dir="ltr">J-000006</span></h1>
  <p><span class="status status-scheduled" id="visit-status" dir="auto">مؤكدة</span></p>
  <dl class="detail" id="visit-detail">
    <dt>الموعد</dt>
    <dd dir="auto"><weekday> <span dir="ltr"><day></span> <span dir="ltr"><time>–<time></span></dd>
    <dt>المكان</dt>
    <dd dir="auto">Villa · Street 14, villa 22, Al Barsha</dd>
    <dt>الفني:</dt>
    <dd id="visit-technician" dir="auto">Ali</dd>
    
    
    <dt>لديك سؤال؟ اتصل بنا</dt>
    <dd dir="auto">دبي · <a href="tel:+97140000001" dir="ltr" id="branch-phone">+97140000001</a></dd>
  </dl>


  
  

  

  

  <section aria-labelledby="change-links-title" id="visit-change">
    <h2 id="change-links-title">تغيير الموعد أو الإلغاء</h2>
    <p class="row">
      <a href="/my/visits/jb_seed_06?change=1" id="change-link">تغيير الموعد</a>
      <a href="/my/visits/jb_seed_06?cancel=1" id="cancel-link">إلغاء هذه الزيارة</a>
    </p>
    
  </section>

  <section aria-labelledby="timeline-title">
    <h2 id="timeline-title">ما تم حتى الآن</h2>
    <ol class="my-timeline" id="timeline">
      <li dir="auto">تم الطلب · <span dir="ltr"><day> <time></span></li><li dir="auto">تم التأكيد · <span dir="ltr"><day> <time></span></li><li dir="auto">تم التأكيد · <span dir="ltr"><day> <time></span></li>
    </ol>
  </section>

  

  </main>
  <footer><small dir="auto">فيكس إت للخدمات ذ.م.م، دبي</small></footer>


</body></html>"
`;
