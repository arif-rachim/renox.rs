exports[`cancel within the cut-off ?cancel=1 asks for confirmation with an optional reason; EN and AR: role: my visit cancel, portal customer, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>Your visit · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  <meta name="theme-color" content="#1f6f5c">
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <a href="/my" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/my/visits/jb_chg_13h?cancel=1&amp;lang=ar" lang="ar">العربية</a>
    </nav>
    <form method="post" action="?/signout" hx-post="?/signout" class="inline"><input type="hidden" name="_csrf" value="<csrf>"><button type="submit">Sign out</button></form>
  </header>
  <main id="main" tabindex="-1">
    
  
  <p><a href="/my">Back to my account</a></p>
  <h1 dir="auto">Handyman <span dir="ltr"><number></span></h1>
  <p><span class="status status-scheduled" id="visit-status" dir="auto">Confirmed</span></p>
  <dl class="detail" id="visit-detail">
    <dt>When</dt>
    <dd dir="auto"><weekday> <span dir="ltr"><day></span> <span dir="ltr"><time>–<time></span></dd>
    <dt>Where</dt>
    <dd dir="auto">Villa · Street 14, villa 22, Al Barsha</dd>
    <dt>Technician:</dt>
    <dd id="visit-technician" dir="auto">Ali</dd>
    
    
    <dt>Questions? Call us</dt>
    <dd dir="auto">Dubai · <a href="tel:+97140000001" dir="ltr" id="branch-phone">+97140000001</a></dd>
  </dl>


  
  

  

  <section aria-labelledby="cancel-title" id="visit-cancel">
    <h2 id="cancel-title">Cancel this visit?</h2>
    <form method="post" action="?/cancel" hx-post="?/cancel" class="stack narrow" id="cancel-form"><input type="hidden" name="_csrf" value="<csrf>">
      <p><label>Why are you cancelling? (optional) <select name="reason" id="f-reason">
        <option value="">I prefer not to say</option>
        <option value="no_longer_needed">No longer needed</option>
        <option value="found_other_time">Found another time by phone</option>
        <option value="other">Other</option>
      </select></label></p>
      <p><label>More about the reason (optional, 200 characters) <textarea name="reason_other" maxlength="200" dir="auto" id="f-reason_other"></textarea></label></p>
      <p><button type="submit" class="btn-brand" id="cancel-submit">Yes, cancel the visit</button> <a href="/my/visits/jb_chg_13h">Keep the visit as it is</a></p>
    </form>
  </section>

  

  <section aria-labelledby="timeline-title">
    <h2 id="timeline-title">What happened so far</h2>
    <p class="muted">Nothing has happened yet.</p>
  </section>

  

  </main>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
`;

