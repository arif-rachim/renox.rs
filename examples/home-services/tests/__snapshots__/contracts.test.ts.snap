  </form>
  <table id="contract-list">
    <thead>
      <tr><th>Contract</th><th>Customer</th><th>Status</th><th>Term</th><th>Price (AED)</th><th>Items</th></tr>
    </thead>
    <tbody>
      <tr id="contract-AMC-000001">
        <td dir="ltr"><a href="/contracts/ct_seed_01" dir="auto">AMC-000001</a></td>
        <td><a href="/customers/cu_dxb_04" dir="auto">Marina Heights Property Management</a></td>
        <td><span class="status status-active" dir="auto">Active</span></td>
        <td dir="ltr"><day> → <day></td>
        <td dir="ltr">AED 4,800.00</td>
        <td dir="ltr">2</td>
      </tr>
    </tbody>
  </table>

  </main>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
