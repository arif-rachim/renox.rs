exports[`the seed the contract page: items, price with VAT, no visits yet: role: contract, dispatcher, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>AMC-000001 · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
</head>
<body>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Dina Dispatcher</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">Notifications <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/contracts/ct_seed_01">
    <select name="org" aria-label="Organisation">
      <option value="org_dubai" selected dir="auto">Dubai · member</option>
    </select>
    <button type="submit">Switch</button>
    
  </form>
</span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/contracts/ct_seed_01?lang=ar" lang="ar">العربية</a>
    </nav>
  </header>
  <main>
    
  
  <p><a href="/contracts">All contracts</a></p>
  <h1 dir="ltr">AMC-000001</h1>
  <p><span class="status status-active" id="contract-status" dir="auto">Active</span></p>
  <dl class="detail">
    <dt>Customer</dt>
    <dd><a href="/customers/cu_dxb_04" dir="auto">Marina Heights Property Management</a></dd>
    <dt>Term</dt>
    <dd dir="ltr"><day> → <day></dd>
    <dt>Yearly price before VAT (AED)</dt>
    <dd dir="ltr" id="contract-price">AED 4,800.00</dd>
    <dt>VAT</dt>
    <dd dir="ltr">AED 240.00</dd>
    <dt>Total with VAT</dt>
    <dd dir="ltr"><strong dir="auto">AED 5,040.00</strong></dd>
    
    
    
    
    
    
  </dl>
  <p class="muted" dir="auto">Monthly AC service of Tower A, quarterly pest control of Tower B.</p>
  <p class="work-links"><a href="/contracts/ct_seed_01/pdf?lang=en">Contract (English PDF)</a> <a href="/contracts/ct_seed_01/pdf?lang=ar">Contract (Arabic PDF)</a></p>

  <section id="items">
    <h2>Services and sites</h2>
    <table id="item-list">
      <thead><tr><th>Site</th><th>Service</th><th>Visits a year</th><th>Next visit due</th></tr></thead>
      <tbody>
        <tr id="item-1">
          <td dir="auto">Tower A<br><small class="muted" dir="auto">Dubai Marina, Marina Heights A</small></td>
          <td dir="auto">AC service</td>
          <td dir="ltr">12</td>
          <td dir="ltr"><day></td>
          
        </tr><tr id="item-2">
          <td dir="auto">Tower B<br><small class="muted" dir="auto">Dubai Marina, Marina Heights B</small></td>
          <td dir="auto">Pest control</td>
          <td dir="ltr">4</td>
          <td dir="ltr"><day></td>
          
        </tr>
      </tbody>
    </table>
  </section>

  

  <section id="visits">
    <h2>Visits made</h2>
    <p class="muted">No visits yet. The daily job makes each visit as a job 14 days before it falls due.</p>
  </section>

  
  <section id="renew">
    <h2>Renew</h2>
    <p class="muted">Makes a draft for the next year with the same items and price.</p>
    <form method="post" action="?/renew" hx-post="?/renew" class="stack narrow"><input type="hidden" name="_csrf" value="<csrf>"><p><button type="submit" id="contract-renew">Renew for the next year</button></p></form>
  </section>
  <section id="cancel">
    <form method="post" action="?/cancel" hx-post="?/cancel" class="stack narrow"><input type="hidden" name="_csrf" value="<csrf>"><p><button type="submit">Cancel the contract</button></p></form>
  </section>

  </main>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
`;

