  <link rel="stylesheet" href="/theme">
  <link rel="manifest" href="/me/manifest" crossorigin="use-credentials">
  <meta name="theme-color" content="#1f6f5c">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href="/icons/icon-192.<hash>.png">
  <script src="/me.<hash>.js" defer nonce="<nonce>"></script>
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Dina Dispatcher</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">Notifications <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/customers/cu_dxb_04">
    <select name="org" aria-label="Organisation">
      <option value="org_dubai" selected dir="auto">Dubai · member</option>
    </select>
    <button type="submit">Switch</button>
    
  </form>
</span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/customers/cu_dxb_04?lang=ar" lang="ar">العربية</a>
    </nav>
  </header>
  <main id="main" tabindex="-1">
    
  
  <p><a href="/customers">All customers</a></p>
  <h1 dir="auto">Marina Heights Property Management</h1>
  <dl class="detail">
    <dt>Type</dt>
    <dd>Property manager or company</dd>
    <dt>Phone</dt>
    <dd dir="ltr">+97144110004</dd>
    <dt>TRN</dt>
    <dd dir="ltr">100123456700003</dd>
    <dt>Email</dt>
    <dd dir="ltr">ops@marinaheights.example</dd>
    <dt>Language</dt>
    <dd>English</dd>
  </dl>
  <h2>Sites</h2>
  <ul id="sites">
    <li id="site-st_dxb_04a" dir="auto">
      <strong dir="auto">Tower A</strong> · Dubai Marina, Dubai<br>
      Marina Heights A
      <br>Makani number: <span dir="ltr">3011122233</span>
      <br><small dir="auto">Technicians sign in at reception.</small>
    </li><li id="site-st_dxb_04b" dir="auto">
      <strong dir="auto">Tower B</strong> · Dubai Marina, Dubai<br>
      Marina Heights B
      <br>Makani number: <span dir="ltr">3011122244</span>
      <br><small dir="auto">Technicians sign in at reception.</small>
    </li>
  </ul>
  <section><form method="post" action="?/addSite" hx-post="?/addSite" class="stack narrow"><input type="hidden" name="_csrf" value="<csrf>">
    <h3>Add a site</h3>
    
<p><label>Site name <input name="label" maxlength="80" value="" required id="f-label" aria-invalid="false" aria-describedby="" aria-required="true" dir="auto"></label></p>
<p><label>Emirate <select name="emirate" required id="f-emirate" aria-invalid="false" aria-describedby="" aria-required="true">
  <option value="AE-AZ" dir="auto">Abu Dhabi</option><option value="AE-DU" selected dir="auto">Dubai</option><option value="AE-SH" dir="auto">Sharjah</option><option value="AE-AJ" dir="auto">Ajman</option><option value="AE-UQ" dir="auto">Umm Al Quwain</option><option value="AE-RK" dir="auto">Ras Al Khaimah</option><option value="AE-FU" dir="auto">Fujairah</option>
</select></label></p>
<p><label>Area <input name="area" maxlength="80" value="" required id="f-area" aria-invalid="false" aria-describedby="" aria-required="true" dir="auto"></label></p>
<p><label>Address <input name="address" maxlength="300" value="" required id="f-address" aria-invalid="false" aria-describedby="" aria-required="true" dir="auto"></label></p>
<p><label>Makani number <input name="makani" dir="ltr" inputmode="numeric" maxlength="20" value="" id="f-makani" aria-invalid="false" aria-describedby=""></label></p>
<p><label>Latitude <input name="lat" dir="ltr" inputmode="decimal" maxlength="20" value="" id="f-lat" aria-invalid="false" aria-describedby=""></label></p>
<p><label>Longitude <input name="lng" dir="ltr" inputmode="decimal" maxlength="20" value="" id="f-lng" aria-invalid="false" aria-describedby=""></label></p>
<p><label>Access notes <textarea name="access_notes" maxlength="500" id="f-access_notes" aria-invalid="false" aria-describedby="" dir="auto"></textarea></label></p>

    <p><button type="submit" class="btn-brand">Add site</button></p>
  </form></section>

  </main>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
`;

