exports[`the customer list is the branch's own a Dubai dispatcher sees Dubai customers only: role: customers, dispatcher, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>Customers · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  <link rel="manifest" href="/me/manifest" crossorigin="use-credentials">
  <meta name="theme-color" content="#1f6f5c">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href="/icons/icon-192.<hash>.png">
  <script src="/me.<hash>.js" defer nonce="<nonce>"></script>
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Dina Dispatcher</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">Notifications <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/customers">
    <select name="org" aria-label="Organisation">
      <option value="org_dubai" selected dir="auto">Dubai · member</option>
    </select>
    <button type="submit">Switch</button>
    
  </form>
</span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/customers?lang=ar" lang="ar">العربية</a>
    </nav>
  </header>
  <main id="main" tabindex="-1">
    
  
  <h1>Customers</h1>
  <p class="muted">Branch: Dubai</p>
  <form class="search" role="search" action="/customers" hx-get="/customers" hx-target="#customer-list" hx-swap="outerHTML" hx-trigger="input changed delay:250ms from:input[name=q], submit" hx-push-url="true">
    <input type="search" name="q" value="" placeholder="Search by name or phone" aria-label="Search by name or phone" autocomplete="off" dir="auto">
    <button type="submit">Search</button>
    <a class="btn-brand" href="/customers/new">New customer</a>
  </form>
  <div class="table-scroll" tabindex="0"><table id="customer-list">
    <caption class="visually-hidden">Customers</caption>
    <thead>
      <tr><th scope="col">Name</th><th scope="col">Type</th><th scope="col">Phone</th><th scope="col">TRN</th><th scope="col">Sites</th></tr>
    </thead>
    <tbody>
      <tr id="customer-cu_dxb_05">
        <td><a href="/customers/cu_dxb_05" dir="auto">Al Barsha Facilities LLC</a></td>
        <td>Property manager or company</td>
        <td dir="ltr">+971561110005</td>
        <td dir="ltr">100123456700011</td>
        <td dir="auto">1</td>
      </tr><tr id="customer-cu_dxb_03">
        <td><a href="/customers/cu_dxb_03" dir="auto">Fatima Al Suwaidi</a></td>
        <td>Household</td>
        <td dir="ltr">+971551110003</td>
        <td dir="ltr"></td>
        <td dir="auto">1</td>
      </tr><tr id="customer-cu_dxb_01">
        <td><a href="/customers/cu_dxb_01" dir="auto">Layla Haddad</a></td>
        <td>Household</td>
        <td dir="ltr">+971501110001</td>
        <td dir="ltr"></td>
        <td dir="auto">1</td>
      </tr><tr id="customer-cu_dxb_04">
        <td><a href="/customers/cu_dxb_04" dir="auto">Marina Heights Property Management</a></td>
        <td>Property manager or company</td>
        <td dir="ltr">+97144110004</td>
        <td dir="ltr">100123456700003</td>
        <td dir="auto">2</td>
      </tr><tr id="customer-cu_dxb_02">
        <td><a href="/customers/cu_dxb_02" dir="auto">Peter Nowak</a></td>
        <td>Household</td>
        <td dir="ltr">+971521110002</td>
        <td dir="ltr"></td>
        <td dir="auto">2</td>
      </tr>
    </tbody>
  </table></div>

  </main>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
