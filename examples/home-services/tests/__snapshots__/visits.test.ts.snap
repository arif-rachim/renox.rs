exports[`the technician's day the check-in state of a visit, on a phone, in English: role: visit, check-in, technician, phone, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>J-000010 · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  <link rel="manifest" href="/me/manifest" crossorigin="use-credentials">
  <meta name="theme-color" content="#1f6f5c">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href="/icons/icon-192.<hash>.png">
  <script src="/me.<hash>.js" defer nonce="<nonce>"></script>
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Ali Hassan</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">Notifications <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/me/visits/jb_seed_10">
    <select name="org" aria-label="Organisation">
      <option value="org_dubai" selected dir="auto">Dubai · member</option>
    </select>
    <button type="submit">Switch</button>
    
  </form>
</span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/me/visits/jb_seed_10?lang=ar" lang="ar">العربية</a>
    </nav>
  </header>
  <main id="main" tabindex="-1">
    
  
  <div class="touch">
  <meta name="hs-user" content="u_dxb_ali">
  <meta name="hs-job" content="J-000010" data-customer="Al Barsha Facilities LLC">
  <p id="offline-banner" class="warning" hidden role="status" data-saved-at="<when>">You are offline. Showing the copy saved at <bdi dir="ltr" id="offline-time"></bdi>.</p>
  <div id="queue-status" role="status" data-waiting="{n} actions waiting to be sent" data-waiting-one="1 action waiting to be sent" data-sending="Sending…" data-all-sent="All sent" data-sign-in="Sign in again to send {n} saved actions" data-other="{n} actions of another account are waiting; sign in as that user to send them" data-refused="{n} saved actions were not accepted by the server: {reason}" data-not-sent="not sent yet" data-old="saved more than 72 hours ago" data-too-many="Too many saved actions, please get a connection" data-no-storage="This phone could not save the action, please get a connection" data-checked-in="Checked in" data-checked-out="Checked out" data-in-progress="In progress" data-done="Done" data-photo-limit="20 photos are waiting to be sent. Get a connection before taking more." data-photo-no-room="This phone has too little free space to keep another photo. Free some space or get a connection." data-photo-too-large="A photo is at most 10 MiB ({max} bytes); this one is {size} bytes." data-photo-remove="Remove" data-photo-refused="not accepted by the server: {reason}" data-photo-saved="Photo kept on this phone" data-photo-alt="Photo of the work" data-photo-choose="Choose a photo to add." data-photo-title="Photos" data-photo-before="Before" data-photo-after="After" data-photo-file="Photo" data-photo-caption="Caption" data-photo-add="Add a photo" data-photo-hint="A photo is at most 10 MB (JPEG, PNG or WebP)."></div>

  <p><a href="/me">My visits</a></p>
  <h1 dir="ltr">J-000010</h1>
  <p><span class="status status-in_progress" id="job-status" dir="auto">In progress</span></p>
  <dl class="detail">
    <dt>Customer</dt>
    <dd dir="auto">Al Barsha Facilities LLC <a href="tel:+971561110005" dir="ltr">+971561110005</a></dd>
    <dt>Site</dt>
    <dd dir="auto">Building 9 · Al Barsha, Al Barsha 1, building 9<br></dd>
    <dt>Service</dt>
    <dd dir="auto">AC repair</dd>
    <dt>Scheduled</dt>
    <dd dir="ltr"><when></dd>
  </dl>
  <p dir="auto">Building 9, compressor noise.</p>

  <section id="checkin">
    <h2>Check in</h2>
    <p class="muted">Check in when you arrive. Your position is saved if the browser shares it.</p>
    <form method="post" action="?/checkin" hx-post="?/checkin" class="stack narrow" id="checkin-form" data-offline-action="" data-offline-effect="checkin"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="lat" id="checkin-lat">
      <input type="hidden" name="lng" id="checkin-lng">
      <p><button type="submit" class="btn-brand btn-big">Check in</button></p>
    </form>
  </section>

  <section id="visit" hidden>
    <p id="visit-times" dir="ltr"></p>
    

    

    <section id="parts">
      <h2>Parts used</h2>
      <p class="muted">No parts yet.</p>
      <form method="post" action="?/part" hx-post="?/part" class="stack narrow" id="part-form" data-offline-action="" data-offline-effect="part"><input type="hidden" name="_csrf" value="<csrf>">
        <p><label>Part <input name="description" maxlength="200" required id="f-description" aria-required="true" dir="auto"></label></p>
        <p><label>Quantity <input name="qty" value="1" inputmode="decimal" dir="ltr" required id="f-qty" aria-required="true"></label></p>
        <p><label>Unit price (AED) <input name="price" value="0" inputmode="decimal" dir="ltr" required id="f-price" aria-required="true"></label></p>
        <p><button type="submit">Add part</button></p>
      </form>
    </section>

    <section id="notes">
      <h2>Notes</h2>
      <form method="post" action="?/notes" hx-post="?/notes" class="stack narrow" data-offline-action="" data-offline-effect="notes"><input type="hidden" name="_csrf" value="<csrf>">
        <p><label class="visually-hidden" for="f-notes">Notes</label><textarea name="notes" rows="4" maxlength="2000" dir="auto" id="f-notes"></textarea></p>
        <p><button type="submit">Save notes</button></p>
      </form>
    </section>

    <section id="signature">
      <h2>Customer&#39;s signature</h2>
      
      <p class="muted">Not signed yet.</p>
      <form method="post" action="?/signature" hx-post="?/signature" class="stack narrow" id="signature-form" data-offline-action="" data-offline-effect="signature"><input type="hidden" name="_csrf" value="<csrf>">
        <p><label>Name of the person signing <input name="signed_by" maxlength="120" dir="auto" required id="f-signed_by" aria-required="true"></label></p>
        <p class="muted">Sign in the box</p>
        <canvas id="sig-canvas" class="sig-canvas" role="img" aria-label="Sign in the box" width="320" height="160"></canvas>
        <p><label><input type="checkbox" id="sig-typed"> Type the customer&#39;s name instead</label> <small class="muted">Signs with the name typed above, written as the signature.</small></p>
        <input type="hidden" name="signature" id="sig-data">
        <p><button type="button" id="sig-clear">Clear</button> <button type="submit">Save signature</button></p>
      </form>
    </section>

    <section id="summary">
      <h2>Summary for the report</h2>
      <p class="muted">Two sentences, drafted by the AI from your notes and parts when it is on. Edit them before the report is sent.</p>
      <form method="post" action="?/summary" hx-post="?/summary" class="stack narrow" data-offline-action="" data-offline-effect="summary"><input type="hidden" name="_csrf" value="<csrf>">
        <p><label>Summary (English) <textarea name="summary_en" rows="3" maxlength="400" dir="ltr" id="f-summary_en"></textarea></label></p>
        <p><label>Summary (Arabic) <textarea name="summary_ar" rows="3" maxlength="400" dir="rtl" id="f-summary_ar"></textarea></label></p>
        <p><button type="submit">Save summary</button></p>
      </form>
    </section>

    <section id="checkout">
      <h2>Check out</h2>
      <p class="muted">Check out when the work is finished. Photos and a signature are not required.</p>
      <form method="post" action="?/checkout" hx-post="?/checkout" class="stack narrow" id="checkout-form" data-offline-action="" data-offline-effect="checkout"><input type="hidden" name="_csrf" value="<csrf>">
        <p><button type="submit" class="btn-brand btn-big">Check out</button></p>
      </form>
    </section>

    
  </section>

  
  <script src="/visit.<hash>.js" defer nonce="<nonce>"></script>
  <script src="/offline-queue-core.<hash>.js" defer nonce="<nonce>"></script>
  <script src="/offline-queue.<hash>.js" defer nonce="<nonce>"></script>
  </div>

  </main>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
`;

