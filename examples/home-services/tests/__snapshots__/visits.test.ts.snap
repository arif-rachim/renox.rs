  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>J-000012 · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  <link rel="preload" as="font" type="font/woff2" crossorigin="" href="/fonts/noto-sans-arabic-arabic-400-normal.woff2">
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  <link rel="manifest" href="/me/manifest" crossorigin="use-credentials">
  <meta name="theme-color" content="#1f6f5c">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href="/icons/icon-192.<hash>.png">
  <script src="/me.<hash>.js" defer nonce="<nonce>"></script>
</head>
<body>
  <a class="skip" href="#main">تخطَّ إلى المحتوى الرئيسي</a>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Ali Hassan</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">الإشعارات <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/me/visits/jb_seed_12">
    <select name="org" aria-label="المؤسسة">
      <option value="org_dubai" selected dir="auto">Dubai · عضو</option>
    </select>
    <button type="submit">تبديل</button>
    
  </form>
</span>
    <nav class="i18n-language" aria-label="اللغة">
      <a href="/me/visits/jb_seed_12?lang=en" lang="en">English</a><strong lang="ar">العربية</strong>
    </nav>
  </header>
  <main id="main" tabindex="-1">
    
  
  <div class="touch">
  <meta name="hs-user" content="u_dxb_ali">
  <meta name="hs-job" content="J-000012" data-customer="Fatima Al Suwaidi">
  <p id="offline-banner" class="warning" hidden role="status" data-saved-at="<when>">أنت غير متصل بالإنترنت. تعرض هذه الصفحة النسخة المحفوظة في <bdi dir="ltr" id="offline-time"></bdi>.</p>
  <div id="queue-status" role="status" data-waiting="عدد الإجراءات بانتظار الإرسال: ⁨{n}⁩" data-waiting-one="إجراء واحد بانتظار الإرسال" data-sending="جارٍ الإرسال…" data-all-sent="تم إرسال كل شيء" data-sign-in="سجّل الدخول مرة أخرى لإرسال الإجراءات المحفوظة (عددها ⁨{n}⁩)" data-other="عدد الإجراءات بانتظار الإرسال من حساب آخر: ⁨{n}⁩؛ سجّل الدخول بحساب ذلك المستخدم لإرسالها" data-refused="لم يقبل الخادم الإجراءات المحفوظة (عددها ⁨{n}⁩): ⁨{reason}⁩" data-not-sent="لم يُرسل بعد" data-old="محفوظ منذ أكثر من 72 ساعة" data-too-many="عدد الإجراءات المحفوظة كبير جدًا، يرجى الاتصال بالإنترنت" data-no-storage="تعذّر على هذا الهاتف حفظ الإجراء، يرجى الاتصال بالإنترنت" data-checked-in="تم تسجيل الدخول" data-checked-out="تم تسجيل الخروج" data-in-progress="قيد التنفيذ" data-done="منجزة" data-photo-limit="هناك 20 صورة بانتظار الإرسال. احصل على اتصال قبل التقاط المزيد." data-photo-no-room="المساحة الفارغة على هذا الهاتف قليلة جدًا لحفظ صورة أخرى. أفرغ بعض المساحة أو احصل على اتصال." data-photo-too-large="الصورة 10 ميغابايت كحد أقصى (⁨{max}⁩ بايت)؛ حجم هذه الصورة ⁨{size}⁩ بايت." data-photo-remove="إزالة" data-photo-refused="لم يقبلها الخادم: ⁨{reason}⁩" data-photo-saved="الصورة محفوظة على هذا الهاتف" data-photo-alt="صورة من العمل" data-photo-choose="اختر صورة لإضافتها." data-photo-title="الصور" data-photo-before="قبل" data-photo-after="بعد" data-photo-file="الصورة" data-photo-caption="التعليق" data-photo-add="إضافة صورة" data-photo-hint="الصورة 10 ميغابايت كحد أقصى (JPEG أو PNG أو WebP)."></div>

