    </nav>
  </header>
  <main id="main" tabindex="-1">
    
  
  <div class="touch">
  <meta name="hs-user" content="u_dxb_ali">
  <meta name="hs-job" content="J-000012" data-customer="Fatima Al Suwaidi">
  <p id="offline-banner" class="warning" hidden role="status" data-saved-at="<when>">You are offline. Showing the copy saved at <bdi dir="ltr" id="offline-time"></bdi>.</p>
  <div id="queue-status" role="status" data-waiting="{n} actions waiting to be sent" data-waiting-one="1 action waiting to be sent" data-sending="Sending…" data-all-sent="All sent" data-sign-in="Sign in again to send {n} saved actions" data-other="{n} actions of another account are waiting; sign in as that user to send them" data-refused="{n} saved actions were not accepted by the server: {reason}" data-not-sent="not sent yet" data-old="saved more than 72 hours ago" data-too-many="Too many saved actions, please get a connection" data-no-storage="This phone could not save the action, please get a connection" data-checked-in="Checked in" data-checked-out="Checked out" data-in-progress="In progress" data-done="Done" data-photo-limit="20 photos are waiting to be sent. Get a connection before taking more." data-photo-no-room="This phone has too little free space to keep another photo. Free some space or get a connection." data-photo-too-large="A photo is at most 10 MiB ({max} bytes); this one is {size} bytes." data-photo-remove="Remove" data-photo-refused="not accepted by the server: {reason}" data-photo-saved="Photo kept on this phone" data-photo-alt="Photo of the work" data-photo-choose="Choose a photo to add." data-photo-title="Photos" data-photo-before="Before" data-photo-after="After" data-photo-file="Photo" data-photo-caption="Caption" data-photo-add="Add a photo" data-photo-hint="A photo is at most 10 MB (JPEG, PNG or WebP)."></div>

