exports[`the technician's day the check-in state of a visit, on a phone, in English: role: visit, check-in, technician, phone, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>J-000010 · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  <link rel="manifest" href="/me/manifest" crossorigin="use-credentials">
  <meta name="theme-color" content="#1f6f5c">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href="/icons/icon-192.<hash>.png">
  <script src="/me.<hash>.js" defer nonce="<nonce>"></script>
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Ali Hassan</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">Notifications <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/me/visits/jb_seed_10">
    <select name="org" aria-label="Organisation">
      <option value="org_dubai" selected dir="auto">Dubai · member</option>
    </select>
    <button type="submit">Switch</button>
    
  </form>
</span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/me/visits/jb_seed_10?lang=ar" lang="ar">العربية</a>
    </nav>
  </header>
  <main id="main" tabindex="-1">
    
  
  <div class="touch">
  <meta name="hs-user" content="u_dxb_ali">
  <p id="offline-banner" class="warning" hidden role="status" data-saved-at="<when>">You are offline. Showing the copy saved at <bdi dir="ltr" id="offline-time"></bdi>.</p>
  <p><a href="/me">My visits</a></p>
  <h1 dir="ltr">J-000010</h1>
  <p><span class="status status-in_progress" id="job-status" dir="auto">In progress</span></p>
  <dl class="detail">
    <dt>Customer</dt>
    <dd dir="auto">Al Barsha Facilities LLC <a href="tel:+971561110005" dir="ltr">+971561110005</a></dd>
    <dt>Site</dt>
    <dd dir="auto">Building 9 · Al Barsha, Al Barsha 1, building 9<br></dd>
    <dt>Service</dt>
    <dd dir="auto">AC repair</dd>
    <dt>Scheduled</dt>
    <dd dir="ltr"><when></dd>
  </dl>
  <p dir="auto">Building 9, compressor noise.</p>

  <section id="checkin">
    <h2>Check in</h2>
    <p class="muted">Check in when you arrive. Your position is saved if the browser shares it.</p>
    <form method="post" action="?/checkin" hx-post="?/checkin" class="stack narrow" id="checkin-form"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="lat" id="checkin-lat">
      <input type="hidden" name="lng" id="checkin-lng">
      <p><button type="submit" class="btn-brand btn-big">Check in</button></p>
    </form>
  </section>

  

  
  <script src="/visit.<hash>.js" defer nonce="<nonce>"></script>
  </div>

  </main>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
`;

exports[`the visit page on a phone a closed visit with its photos, part, summary and report links, in English and in Arabic: role: visit, done, technician, phone, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>J-000012 · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  <link rel="manifest" href="/me/manifest" crossorigin="use-credentials">
  <meta name="theme-color" content="#1f6f5c">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href="/icons/icon-192.<hash>.png">
  <script src="/me.<hash>.js" defer nonce="<nonce>"></script>
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Ali Hassan</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">Notifications <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/me/visits/jb_seed_12">
    <select name="org" aria-label="Organisation">
      <option value="org_dubai" selected dir="auto">Dubai · member</option>
    </select>
    <button type="submit">Switch</button>
    
  </form>
</span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/me/visits/jb_seed_12?lang=ar" lang="ar">العربية</a>
    </nav>
  </header>
  <main id="main" tabindex="-1">
    
  
  <div class="touch">
  <meta name="hs-user" content="u_dxb_ali">
  <p id="offline-banner" class="warning" hidden role="status" data-saved-at="<when>">You are offline. Showing the copy saved at <bdi dir="ltr" id="offline-time"></bdi>.</p>
  <p><a href="/me">My visits</a></p>
  <h1 dir="ltr">J-000012</h1>
  <p><span class="status status-done" id="job-status" dir="auto">Done</span></p>
  <dl class="detail">
    <dt>Customer</dt>
    <dd dir="auto">Fatima Al Suwaidi <a href="tel:+971551110003" dir="ltr">+971551110003</a></dd>
    <dt>Site</dt>
    <dd dir="auto">Home · Jumeirah, Jumeirah 1, villa 7<br></dd>
    <dt>Service</dt>
    <dd dir="auto">AC service</dd>
    <dt>Scheduled</dt>
    <dd dir="ltr"><when></dd>
  </dl>
  <p dir="auto">Service of two units.</p>

  

  <section id="visit">
    <p id="visit-times" dir="ltr"><when> → <when></p>
    <p id="visit-closed" class="muted">This visit is closed.</p>

    <section id="photos">
      <h2>Photos</h2>
      
        <h3 dir="auto">Before</h3>
        
          <ul class="photos" id="photos-before">
            <li><small>Photo not stored</small><small dir="auto">A dirty filter</small></li>
          </ul>
        
        
      
        <h3 dir="auto">After</h3>
        
          <ul class="photos" id="photos-after">
            <li><small>Photo not stored</small><small dir="auto">The cleaned filter</small></li>
          </ul>
        
        
      
    </section>

    <section id="parts">
      <h2>Parts used</h2>
      <div class="table-scroll" tabindex="0"><table class="parts-table">
    <caption class="visually-hidden">Parts used</caption>
        <thead><tr><th scope="col">Part</th><th scope="col">Quantity</th><th scope="col">Total (AED)</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
          <tr id="part-2">
            <td dir="auto">Filter set</td><td dir="ltr">2</td><td dir="ltr">50.00</td>
            <td></td>
          </tr>
        </tbody>
        <tfoot><tr><th scope="row" colspan="2">Total (AED)</th><td dir="ltr" id="parts-total">50.00</td><th scope="row"><span class="visually-hidden">Actions</span></th></tr></tfoot>
      </table></div>
      
    </section>

    <section id="notes">
      <h2>Notes</h2>
      <p dir="auto" id="notes-text">Two split units serviced: filters washed, coils cleaned, gas level checked.</p>
    </section>

    <section id="signature">
      <h2>Customer&#39;s signature</h2>
      
      <p id="signed-by">Signed by Customer</p>
      
    </section>

    <section id="summary">
      <h2>Summary for the report</h2>
      <p class="muted">Two sentences, drafted by the AI from your notes and parts when it is on. Edit them before the report is sent.</p>
      <form method="post" action="?/summary" hx-post="?/summary" class="stack narrow"><input type="hidden" name="_csrf" value="<csrf>">
        <p><label>Summary (English) <textarea name="summary_en" rows="3" maxlength="400" dir="ltr" id="f-summary_en">Both units serviced.</textarea></label></p>
        <p><label>Summary (Arabic) <textarea name="summary_ar" rows="3" maxlength="400" dir="rtl" id="f-summary_ar">تمت صيانة الوحدتين.</textarea></label></p>
        <p><button type="submit">Save summary</button></p>
      </form>
    </section>

    

    <section id="report">
      <h2>Visit report</h2>
      <p class="work-links"><a href="/visits/vs_seed_12/report?lang=en">Report (English)</a> <a href="/visits/vs_seed_12/report?lang=ar">Report (Arabic)</a></p>
    </section>
  </section>

  
  
  </div>

  </main>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
`;

exports[`the visit page on a phone a closed visit with its photos, part, summary and report links, in English and in Arabic: role: visit, done, technician, phone, ar 1`] = `
"<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>J-000012 · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  <link rel="preload" as="font" type="font/woff2" crossorigin="" href="/fonts/noto-sans-arabic-arabic-400-normal.woff2">
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  <link rel="manifest" href="/me/manifest" crossorigin="use-credentials">
  <meta name="theme-color" content="#1f6f5c">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href="/icons/icon-192.<hash>.png">
  <script src="/me.<hash>.js" defer nonce="<nonce>"></script>
</head>
<body>
  <a class="skip" href="#main">تخطَّ إلى المحتوى الرئيسي</a>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Ali Hassan</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">الإشعارات <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/me/visits/jb_seed_12">
    <select name="org" aria-label="المؤسسة">
      <option value="org_dubai" selected dir="auto">Dubai · عضو</option>
    </select>
    <button type="submit">تبديل</button>
    
  </form>
</span>
    <nav class="i18n-language" aria-label="اللغة">
      <a href="/me/visits/jb_seed_12?lang=en" lang="en">English</a><strong lang="ar">العربية</strong>
    </nav>
  </header>
  <main id="main" tabindex="-1">
    
  
  <div class="touch">
  <meta name="hs-user" content="u_dxb_ali">
  <p id="offline-banner" class="warning" hidden role="status" data-saved-at="<when>">أنت غير متصل بالإنترنت. تعرض هذه الصفحة النسخة المحفوظة في <bdi dir="ltr" id="offline-time"></bdi>.</p>
  <p><a href="/me">زياراتي</a></p>
  <h1 dir="ltr">J-000012</h1>
  <p><span class="status status-done" id="job-status" dir="auto">منجزة</span></p>
  <dl class="detail">
    <dt>العميل</dt>
    <dd dir="auto">Fatima Al Suwaidi <a href="tel:+971551110003" dir="ltr">+971551110003</a></dd>
    <dt>الموقع</dt>
    <dd dir="auto">Home · Jumeirah, Jumeirah 1, villa 7<br></dd>
    <dt>الخدمة</dt>
    <dd dir="auto">صيانة المكيف</dd>
    <dt>الموعد</dt>
    <dd dir="ltr"><when></dd>
  </dl>
  <p dir="auto">Service of two units.</p>

  

  <section id="visit">
    <p id="visit-times" dir="ltr"><when> → <when></p>
    <p id="visit-closed" class="muted">هذه الزيارة مغلقة.</p>

    <section id="photos">
      <h2>الصور</h2>
      
        <h3 dir="auto">قبل</h3>
        
          <ul class="photos" id="photos-before">
            <li><small>الصورة غير محفوظة</small><small dir="auto">A dirty filter</small></li>
          </ul>
        
        
      
        <h3 dir="auto">بعد</h3>
        
          <ul class="photos" id="photos-after">
            <li><small>الصورة غير محفوظة</small><small dir="auto">The cleaned filter</small></li>
          </ul>
        
        
      
    </section>

    <section id="parts">
      <h2>القطع المستخدمة</h2>
      <div class="table-scroll" tabindex="0"><table class="parts-table">
    <caption class="visually-hidden">القطع المستخدمة</caption>
        <thead><tr><th scope="col">القطعة</th><th scope="col">الكمية</th><th scope="col">الإجمالي (درهم)</th><th scope="col"><span class="visually-hidden">الإجراءات</span></th></tr></thead>
        <tbody>
          <tr id="part-2">
            <td dir="auto">Filter set</td><td dir="ltr">2</td><td dir="ltr">50.00</td>
            <td></td>
          </tr>
        </tbody>
        <tfoot><tr><th scope="row" colspan="2">الإجمالي (درهم)</th><td dir="ltr" id="parts-total">50.00</td><th scope="row"><span class="visually-hidden">الإجراءات</span></th></tr></tfoot>
      </table></div>
      
    </section>

    <section id="notes">
      <h2>الملاحظات</h2>
      <p dir="auto" id="notes-text">Two split units serviced: filters washed, coils cleaned, gas level checked.</p>
    </section>

    <section id="signature">
      <h2>توقيع العميل</h2>
      
      <p id="signed-by">وقّع: ⁨Customer⁩</p>
      
    </section>

    <section id="summary">
      <h2>ملخص التقرير</h2>
      <p class="muted">جملتان يصيغهما الذكاء الاصطناعي من ملاحظاتك وقطعك عند تشغيله. عدّلهما قبل إرسال التقرير.</p>
      <form method="post" action="?/summary" hx-post="?/summary" class="stack narrow"><input type="hidden" name="_csrf" value="<csrf>">
        <p><label>الملخص (الإنجليزية) <textarea name="summary_en" rows="3" maxlength="400" dir="ltr" id="f-summary_en">Both units serviced.</textarea></label></p>
        <p><label>الملخص (العربية) <textarea name="summary_ar" rows="3" maxlength="400" dir="rtl" id="f-summary_ar">تمت صيانة الوحدتين.</textarea></label></p>
        <p><button type="submit">حفظ الملخص</button></p>
      </form>
    </section>

    

    <section id="report">
      <h2>تقرير الزيارة</h2>
      <p class="work-links"><a href="/visits/vs_seed_12/report?lang=en">التقرير (الإنجليزية)</a> <a href="/visits/vs_seed_12/report?lang=ar">التقرير (العربية)</a></p>
    </section>
  </section>

  
  
  </div>

  </main>
  <footer><small dir="auto">فيكس إت للخدمات ذ.م.م، دبي</small></footer>


</body></html>"
`;
