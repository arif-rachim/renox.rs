  <p><span class="status status-done" id="job-status" dir="auto">منجزة</span></p>
  <dl class="detail">
    <dt>العميل</dt>
    <dd dir="auto">Fatima Al Suwaidi <a href="tel:+971551110003" dir="ltr">+971551110003</a></dd>
