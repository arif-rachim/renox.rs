        <p><button type="submit">Save summary</button></p>
      </form>
    </section>

    

    <section id="report">
      <h2>Visit report</h2>
      <p class="work-links"><a href="/visits/vs_seed_12/report?lang=en">Report (English)</a> <a href="/visits/vs_seed_12/report?lang=ar">Report (Arabic)</a></p>
