    <dt>Your name</dt><dd dir="auto">Sara Visitor</dd>
    <dt>WhatsApp number</dt><dd><span dir="ltr">+971507770001</span></dd>
  </dl>
  <form method="post" action="?/confirm" hx-post="?/confirm" class="stack narrow"><input type="hidden" name="_csrf" value="<csrf>">
    <p><button type="submit" class="btn-brand">Confirm booking</button></p>
  </form>

  </main>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
