  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>احجز خدمة · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  <link rel="preload" as="font" type="font/woff2" crossorigin="" href="/fonts/noto-sans-arabic-arabic-400-normal.woff2">
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  <meta name="theme-color" content="#1f6f5c">
</head>
<body>
  <a class="skip" href="#main">تخطَّ إلى المحتوى الرئيسي</a>
  <header class="site-header">
    <a href="/my" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <nav class="i18n-language" aria-label="اللغة">
      <a href="/book?service=1&amp;emirate=AE-DU&amp;step=1&amp;lang=en" lang="en">English</a><strong lang="ar">العربية</strong>
    </nav>
    
  </header>
  <main id="main" tabindex="-1">
    
  
  <h1>احجز خدمة</h1>
  <p class="muted" id="book-step">الخطوة ⁨1⁩ من 3</p>

  
    <form method="get" action="/book" class="stack narrow" id="book-place">
      <fieldset id="f-service">
        <legend>الخدمة</legend>
        <p><label dir="auto"><input type="radio" name="service" value="1" checked required> صيانة المكيف · ابتداءً من <span dir="ltr">150.00 د.إ.</span></label></p><p><label dir="auto"><input type="radio" name="service" value="2" required> إصلاح المكيف · ابتداءً من <span dir="ltr">180.00 د.إ.</span></label></p><p><label dir="auto"><input type="radio" name="service" value="3" required> تنظيف شامل · ابتداءً من <span dir="ltr">450.00 د.إ.</span></label></p><p><label dir="auto"><input type="radio" name="service" value="4" required> مكافحة الحشرات · ابتداءً من <span dir="ltr">250.00 د.إ.</span></label></p><p><label dir="auto"><input type="radio" name="service" value="5" required> سباكة · ابتداءً من <span dir="ltr">160.00 د.إ.</span></label></p><p><label dir="auto"><input type="radio" name="service" value="6" required> كهرباء · ابتداءً من <span dir="ltr">160.00 د.إ.</span></label></p><p><label dir="auto"><input type="radio" name="service" value="7" required> أعمال صيانة عامة · ابتداءً من <span dir="ltr">120.00 د.إ.</span></label></p><p><label dir="auto"><input type="radio" name="service" value="8" required> زيارة عقد الصيانة السنوي · ابتداءً من <span dir="ltr">200.00 د.إ.</span></label></p>
      </fieldset>
      <p><label>الإمارة <select name="emirate" required id="f-emirate" aria-required="true">
        <option value="">اختر</option>
        <option value="AE-AZ" dir="auto">أبوظبي</option><option value="AE-DU" selected dir="auto">دبي</option><option value="AE-SH" dir="auto">الشارقة</option><option value="AE-AJ" dir="auto">عجمان</option><option value="AE-UQ" dir="auto">أم القيوين</option><option value="AE-RK" dir="auto">رأس الخيمة</option><option value="AE-FU" dir="auto">الفجيرة</option>
      </select></label> <button type="submit" name="step" value="1" formnovalidate>اعرض المناطق</button></p>
      <p><label>المنطقة <select name="area" required id="f-area" aria-required="true">
        <option value="">اختر</option>
        <option value="Al Barsha" dir="auto">البرشاء</option><option value="Al Karama" dir="auto">الكرامة</option><option value="Al Nahda (Dubai)" dir="auto">النهدة (دبي)</option><option value="Al Quoz" dir="auto">القوز</option><option value="Bur Dubai" dir="auto">بر دبي</option><option value="Business Bay" dir="auto">الخليج التجاري</option><option value="Deira" dir="auto">ديرة</option><option value="Downtown Dubai" dir="auto">وسط مدينة دبي</option><option value="Dubai Hills Estate" dir="auto">دبي هيلز استيت</option><option value="Dubai Investments Park" dir="auto">مجمع دبي للاستثمار</option><option value="Dubai Marina" dir="auto">دبي مارينا</option><option value="Dubai Silicon Oasis" dir="auto">واحة دبي للسيليكون</option><option value="Jebel Ali" dir="auto">جبل علي</option><option value="Jumeirah" dir="auto">جميرا</option><option value="Jumeirah Lake Towers" dir="auto">أبراج بحيرات جميرا</option><option value="Mirdif" dir="auto">مردف</option>
      </select></label></p>
      <p><label>العنوان <input name="address" minlength="5" maxlength="200" autocomplete="street-address" value="" required id="f-address" aria-required="true" dir="auto"></label></p>
      <p><label>رقم مكاني (اختياري) <input name="makani" dir="ltr" inputmode="numeric" maxlength="20" value="" id="f-makani"></label></p>
      <p><label>ملاحظات (اختياري) <textarea name="notes" maxlength="500" id="f-notes" dir="auto"></textarea></label></p>
      <p><button type="submit" name="step" value="2" class="btn-brand">التالي</button></p>
    </form>
  

  

  

  </main>
  <footer><small dir="auto">فيكس إت للخدمات ذ.م.م، دبي</small></footer>


</body></html>"
`;

