      <a href="/book?service=1&amp;emirate=AE-DU&amp;area=Dubai+Marina&amp;address=Marina+Gate+2%2C+flat+3301&amp;makani=&amp;notes=The+AC+in+the+bedroom+drips.&amp;day=<day>&amp;slot=<slot>&amp;step=3&amp;lang=en" lang="en">English</a><strong lang="ar">العربية</strong>
    </nav>
    
  </header>
  <main id="main" tabindex="-1">
    
  
  <h1>احجز خدمة</h1>
  <p class="muted" id="book-step">الخطوة ⁨3⁩ من 3</p>

  

  

  
    <section aria-labelledby="summary-title">
      <h2 id="summary-title">حجزك</h2>
      <dl>
        <dt>الخدمة</dt><dd dir="auto">صيانة المكيف</dd>
        <dt>المكان</dt><dd dir="auto">Marina Gate 2, flat 3301, دبي مارينا, دبي</dd>
        <dt>الموعد</dt><dd><span dir="ltr"><day></span> <span dir="ltr"><from>–<to></span></dd>
      </dl>
    </section>
    <form method="post" action="?/hold" hx-post="?/hold" class="stack narrow" id="book-you"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="service" value="1"><input type="hidden" name="emirate" value="AE-DU"><input type="hidden" name="area" value="Dubai Marina"><input type="hidden" name="address" value="Marina Gate 2, flat 3301"><input type="hidden" name="notes" value="The AC in the bedroom drips."><input type="hidden" name="day" value="<day>"><input type="hidden" name="slot" value="<slot>">
      <p><label>اسمك <input name="name" minlength="2" maxlength="80" autocomplete="name" required id="f-name" aria-required="true" dir="auto"></label></p>
      
        <p><label>رقم واتساب <input name="phone" type="tel" dir="ltr" autocomplete="tel" placeholder="+971 50 123 4567" maxlength="40" required id="f-phone" aria-required="true"></label></p>
        <p class="muted">نرسل رمزاً إلى هذا الرقم عبر واتساب للتأكد من أنه رقمك.</p>
      
      <p><label>اللغة <select name="language" id="f-language">
        <option value="en">English</option>
        <option value="ar" selected>العربية</option>
      </select></label></p>
      <p><button type="submit" class="btn-brand">أرسل لي الرمز</button> <a href="/book?service=1&amp;emirate=AE-DU&amp;area=Dubai+Marina&amp;address=Marina+Gate+2%2C+flat+3301&amp;notes=The+AC+in+the+bedroom+drips.&amp;day=<day>&amp;slot=<slot>&amp;step=2">رجوع</a></p>
    </form>
  

  </main>
  <footer><small dir="auto">فيكس إت للخدمات ذ.م.م، دبي</small></footer>


</body></html>"
`;

exports[`a new phone books, types the code and confirms the WhatsApp code signs the new phone up and lands on the draft, which shows the summary: role: book confirm, portal user, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
