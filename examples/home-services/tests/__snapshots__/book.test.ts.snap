  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  <meta name="theme-color" content="#1f6f5c">
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <a href="/my" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/book?service=1&amp;emirate=AE-DU&amp;area=Dubai+Marina&amp;address=Marina+Gate+2%2C+flat+3301&amp;makani=&amp;notes=The+AC+in+the+bedroom+drips.&amp;day=<day>&amp;slot=<slot>&amp;step=3&amp;lang=ar" lang="ar">العربية</a>
    </nav>
    
  </header>
  <main id="main" tabindex="-1">
    
  
  <h1>Book a service</h1>
  <p class="muted" id="book-step">Step 3 of 3</p>

  

  

  
    <section aria-labelledby="summary-title">
      <h2 id="summary-title">Your booking</h2>
      <dl>
        <dt>Service</dt><dd dir="auto">AC service</dd>
        <dt>Where</dt><dd dir="auto">Marina Gate 2, flat 3301, Dubai Marina, Dubai</dd>
        <dt>When</dt><dd><span dir="ltr"><day></span> <span dir="ltr"><from>–<to></span></dd>
      </dl>
    </section>
    <form method="post" action="?/hold" hx-post="?/hold" class="stack narrow" id="book-you"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="service" value="1"><input type="hidden" name="emirate" value="AE-DU"><input type="hidden" name="area" value="Dubai Marina"><input type="hidden" name="address" value="Marina Gate 2, flat 3301"><input type="hidden" name="notes" value="The AC in the bedroom drips."><input type="hidden" name="day" value="<day>"><input type="hidden" name="slot" value="<slot>">
      <p><label>Your name <input name="name" minlength="2" maxlength="80" autocomplete="name" required id="f-name" aria-required="true" dir="auto"></label></p>
      
        <p><label>WhatsApp number <input name="phone" type="tel" dir="ltr" autocomplete="tel" placeholder="+971 50 123 4567" maxlength="40" required id="f-phone" aria-required="true"></label></p>
        <p class="muted">We send a code to this number on WhatsApp to confirm it is yours.</p>
      
      <p><label>Language <select name="language" id="f-language">
        <option value="en" selected>English</option>
        <option value="ar">العربية</option>
      </select></label></p>
      <p><button type="submit" class="btn-brand">Send me the code</button> <a href="/book?service=1&amp;emirate=AE-DU&amp;area=Dubai+Marina&amp;address=Marina+Gate+2%2C+flat+3301&amp;notes=The+AC+in+the+bedroom+drips.&amp;day=<day>&amp;slot=<slot>&amp;step=2">Back</a></p>
    </form>
  

  </main>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
`;

