        </fieldset>
        <p><button type="submit" name="step" value="3" class="btn-brand">Next</button> <a href="/book?service=1&amp;emirate=AE-DU&amp;area=Dubai+Marina&amp;address=Marina+Gate+2%2C+flat+3301&amp;notes=The+AC+in+the+bedroom+drips.&amp;day=<day>">Back</a></p>
