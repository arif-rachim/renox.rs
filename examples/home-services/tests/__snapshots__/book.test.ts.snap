exports[`the three steps, signed out step 1 lists the bookable services with their price, the emirates and the place fields, and sets no cookie of the app: role: book step 1, signed out, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>Book a service · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  <meta name="theme-color" content="#1f6f5c">
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <a href="/my" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/book?lang=ar" lang="ar">العربية</a>
    </nav>
    
  </header>
  <main id="main" tabindex="-1">
    
  
  <h1>Book a service</h1>
  <p class="muted" id="book-step">Step 1 of 3</p>

  
    <form method="get" action="/book" class="stack narrow" id="book-place">
      <fieldset id="f-service">
        <legend>Service</legend>
        <p><label dir="auto"><input type="radio" name="service" value="1" required> AC service · from <span dir="ltr">AED 150.00</span></label></p><p><label dir="auto"><input type="radio" name="service" value="2" required> AC repair · from <span dir="ltr">AED 180.00</span></label></p><p><label dir="auto"><input type="radio" name="service" value="3" required> Deep cleaning · from <span dir="ltr">AED 450.00</span></label></p><p><label dir="auto"><input type="radio" name="service" value="4" required> Pest control · from <span dir="ltr">AED 250.00</span></label></p><p><label dir="auto"><input type="radio" name="service" value="5" required> Plumbing · from <span dir="ltr">AED 160.00</span></label></p><p><label dir="auto"><input type="radio" name="service" value="6" required> Electrical · from <span dir="ltr">AED 160.00</span></label></p><p><label dir="auto"><input type="radio" name="service" value="7" required> Handyman · from <span dir="ltr">AED 120.00</span></label></p><p><label dir="auto"><input type="radio" name="service" value="8" required> AMC visit · from <span dir="ltr">AED 200.00</span></label></p>
      </fieldset>
      <p><label>Emirate <select name="emirate" required id="f-emirate" aria-required="true">
        <option value="">Choose</option>
        <option value="AE-AZ" dir="auto">Abu Dhabi</option><option value="AE-DU" dir="auto">Dubai</option><option value="AE-SH" dir="auto">Sharjah</option><option value="AE-AJ" dir="auto">Ajman</option><option value="AE-UQ" dir="auto">Umm Al Quwain</option><option value="AE-RK" dir="auto">Ras Al Khaimah</option><option value="AE-FU" dir="auto">Fujairah</option>
      </select></label> <button type="submit" name="step" value="1" formnovalidate>Show the areas</button></p>
      <p class="muted" id="f-area" tabindex="-1">Choose your emirate, then Show the areas.</p>
      <p><label>Address <input name="address" minlength="5" maxlength="200" autocomplete="street-address" value="" required id="f-address" aria-required="true" dir="auto"></label></p>
      <p><label>Makani number (optional) <input name="makani" dir="ltr" inputmode="numeric" maxlength="20" value="" id="f-makani"></label></p>
      <p><label>Notes (optional) <textarea name="notes" maxlength="500" id="f-notes" dir="auto"></textarea></label></p>
      <p><button type="submit" name="step" value="2" class="btn-brand">Next</button></p>
    </form>
  

  

  

  </main>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
`;

exports[`the three steps, signed out step 1 again with an emirate fills its areas; Arabic: role: book step 1 with areas, signed out, ar 1`] = `
"<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
