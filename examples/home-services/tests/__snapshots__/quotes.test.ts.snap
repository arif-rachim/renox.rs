exports[`the quotation list is the branch's own a Dubai dispatcher sees the six seeded quotations, one per state: role: quotes, dispatcher, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>Quotations · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
</head>
<body>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Dina Dispatcher</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">Notifications <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/quotes">
    <select name="org" aria-label="Organisation">
      <option value="org_dubai" selected dir="auto">Dubai · member</option>
    </select>
    <button type="submit">Switch</button>
    
  </form>
</span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/quotes?lang=ar" lang="ar">العربية</a>
    </nav>
  </header>
  <main>
    
  
  <h1>Quotations</h1>
  <form class="search" action="/quotes" method="get">
    <label>Status
      <select name="status">
        <option value="">—</option>
        <option value="draft" dir="auto">Draft</option><option value="sent" dir="auto">Sent</option><option value="approved" dir="auto">Approved</option><option value="rejected" dir="auto">Rejected</option><option value="expired" dir="auto">Expired</option>
      </select></label>
    <button type="submit">Filter</button>
    <a class="btn-brand" href="/quotes/new">New quotation</a>
  </form>
  <table id="quote-list">
    <thead>
      <tr><th>Number</th><th>Customer</th><th>Status</th><th>Total</th><th>Valid until</th></tr>
    </thead>
    <tbody>
      <tr id="quote-qt_seed_05">
        <td dir="ltr"><a href="/quotes/qt_seed_05" dir="auto">Q-000005</a></td>
        <td dir="auto">Al Barsha Facilities LLC</td>
        <td><span class="status status-rejected" dir="auto">Rejected</span></td>
        <td dir="ltr">AED 504.00</td>
        <td dir="ltr">2033-05-18</td>
      </tr><tr id="quote-qt_seed_04">
        <td dir="ltr"><a href="/quotes/qt_seed_04" dir="auto">Q-000004</a></td>
        <td dir="auto">Fatima Al Suwaidi</td>
        <td><span class="status status-approved" dir="auto">Approved</span></td>
        <td dir="ltr">AED 378.00</td>
        <td dir="ltr">2033-05-18</td>
      </tr><tr id="quote-qt_seed_03">
        <td dir="ltr"><a href="/quotes/qt_seed_03" dir="auto">Q-000003</a></td>
        <td dir="auto">Marina Heights Property Management</td>
        <td><span class="status status-sent" dir="auto">Sent</span></td>
        <td dir="ltr">AED 504.00</td>
        <td dir="ltr">2033-05-18</td>
      </tr><tr id="quote-qt_seed_02">
        <td dir="ltr"><a href="/quotes/qt_seed_02" dir="auto">Q-000002</a></td>
        <td dir="auto">Peter Nowak</td>
        <td><span class="status status-sent" dir="auto">Sent</span></td>
        <td dir="ltr">AED 735.00</td>
        <td dir="ltr">2033-05-18</td>
      </tr><tr id="quote-qt_seed_01">
        <td dir="ltr"><a href="/quotes/qt_seed_01" dir="auto">Q-000001</a></td>
        <td dir="auto">Layla Haddad</td>
        <td><span class="status status-draft" dir="auto">Draft</span></td>
        <td dir="ltr">AED 472.50</td>
        <td dir="ltr">2033-05-18</td>
      </tr><tr id="quote-qt_seed_06">
        <td dir="ltr"><a href="/quotes/qt_seed_06" dir="auto">Q-000006</a></td>
        <td dir="auto">Layla Haddad</td>
        <td><span class="status status-expired" dir="auto">Expired</span></td>
        <td dir="ltr">AED 210.00</td>
        <td dir="ltr">2026-10-26</td>
      </tr>
    </tbody>
  </table>

  </main>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
`;

