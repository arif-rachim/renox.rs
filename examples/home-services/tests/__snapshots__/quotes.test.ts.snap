exports[`who may use quotations the new-quotation page for a dispatcher: role: quote form, dispatcher, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>New quotation · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
</head>
<body>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Dina Dispatcher</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">Notifications <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">4</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/quotes/new">
    <select name="org" aria-label="Organisation">
      <option value="org_dubai" selected dir="auto">Dubai · member</option>
    </select>
    <button type="submit">Switch</button>
    
  </form>
</span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/quotes/new?lang=ar" lang="ar">العربية</a>
    </nav>
  </header>
  <main>
    
  
  <p><a href="/quotes">All quotations</a></p>
  <h1>New quotation</h1>
  <form method="post" action="?/create" hx-post="?/create" class="stack"><input type="hidden" name="_csrf" value="<csrf>">
    <section class="stack narrow">
      <p><label>Site
        <select name="site_id" required>
          <option value="">—</option>
          <option value="st_dxb_05a" dir="auto">Al Barsha Facilities LLC · Building 9</option><option value="st_dxb_03a" dir="auto">Fatima Al Suwaidi · Home</option><option value="st_dxb_01a" dir="auto">Layla Haddad · Apartment</option><option value="st_dxb_04a" dir="auto">Marina Heights Property Management · Tower A</option><option value="st_dxb_04b" dir="auto">Marina Heights Property Management · Tower B</option><option value="st_dxb_02b" dir="auto">Peter Nowak · Office</option><option value="st_dxb_02a" dir="auto">Peter Nowak · Villa</option>
        </select></label></p>
      <p><label>Valid for (days) <input name="valid_days" type="number" min="1" max="365" value="30" dir="ltr"></label></p>
    </section>
    <section class="stack narrow" id="ai-draft">
      <h2>AI draft</h2>
      <p><label>What did the customer ask for? <textarea name="request" rows="3" maxlength="2000" dir="auto"></textarea></label></p>
      <p><button type="submit" formaction="?/draft" id="draft-button">Draft the lines</button></p>
      
      
      
      
    </section>
    <h2>Lines</h2>
    <table id="lines">
      <thead><tr><th>Service</th><th>Description</th><th>Qty</th><th>Price (AED)</th></tr></thead>
      <tbody>
        <tr id="row-0">
          <td><select name="service_0">
            <option value="">—</option>
            <option value="1" dir="auto">AC service (AC-SERVICE)</option><option value="2" dir="auto">AC repair (AC-REPAIR)</option><option value="3" dir="auto">Deep cleaning (DEEP-CLEAN)</option><option value="4" dir="auto">Pest control (PEST)</option><option value="5" dir="auto">Plumbing (PLUMBING)</option><option value="6" dir="auto">Electrical (ELECTRICAL)</option><option value="7" dir="auto">Handyman (HANDYMAN)</option><option value="8" dir="auto">AMC visit (AMC-VISIT)</option>
          </select></td>
          <td><input name="desc_0" value="" maxlength="200" dir="auto"><input name="desc_ar_0" value="" maxlength="200" dir="rtl" placeholder="Description in Arabic"></td>
          <td><input name="qty_0" value="1" size="5" dir="ltr" inputmode="decimal"></td>
          <td><input name="price_0" value="" size="9" dir="ltr" inputmode="decimal" placeholder="catalogue price"></td>
        </tr><tr id="row-1">
          <td><select name="service_1">
            <option value="">—</option>
            <option value="1" dir="auto">AC service (AC-SERVICE)</option><option value="2" dir="auto">AC repair (AC-REPAIR)</option><option value="3" dir="auto">Deep cleaning (DEEP-CLEAN)</option><option value="4" dir="auto">Pest control (PEST)</option><option value="5" dir="auto">Plumbing (PLUMBING)</option><option value="6" dir="auto">Electrical (ELECTRICAL)</option><option value="7" dir="auto">Handyman (HANDYMAN)</option><option value="8" dir="auto">AMC visit (AMC-VISIT)</option>
          </select></td>
          <td><input name="desc_1" value="" maxlength="200" dir="auto"><input name="desc_ar_1" value="" maxlength="200" dir="rtl" placeholder="Description in Arabic"></td>
          <td><input name="qty_1" value="1" size="5" dir="ltr" inputmode="decimal"></td>
          <td><input name="price_1" value="" size="9" dir="ltr" inputmode="decimal" placeholder="catalogue price"></td>
        </tr><tr id="row-2">
          <td><select name="service_2">
            <option value="">—</option>
            <option value="1" dir="auto">AC service (AC-SERVICE)</option><option value="2" dir="auto">AC repair (AC-REPAIR)</option><option value="3" dir="auto">Deep cleaning (DEEP-CLEAN)</option><option value="4" dir="auto">Pest control (PEST)</option><option value="5" dir="auto">Plumbing (PLUMBING)</option><option value="6" dir="auto">Electrical (ELECTRICAL)</option><option value="7" dir="auto">Handyman (HANDYMAN)</option><option value="8" dir="auto">AMC visit (AMC-VISIT)</option>
          </select></td>
          <td><input name="desc_2" value="" maxlength="200" dir="auto"><input name="desc_ar_2" value="" maxlength="200" dir="rtl" placeholder="Description in Arabic"></td>
          <td><input name="qty_2" value="1" size="5" dir="ltr" inputmode="decimal"></td>
          <td><input name="price_2" value="" size="9" dir="ltr" inputmode="decimal" placeholder="catalogue price"></td>
        </tr><tr id="row-3">
          <td><select name="service_3">
            <option value="">—</option>
            <option value="1" dir="auto">AC service (AC-SERVICE)</option><option value="2" dir="auto">AC repair (AC-REPAIR)</option><option value="3" dir="auto">Deep cleaning (DEEP-CLEAN)</option><option value="4" dir="auto">Pest control (PEST)</option><option value="5" dir="auto">Plumbing (PLUMBING)</option><option value="6" dir="auto">Electrical (ELECTRICAL)</option><option value="7" dir="auto">Handyman (HANDYMAN)</option><option value="8" dir="auto">AMC visit (AMC-VISIT)</option>
          </select></td>
          <td><input name="desc_3" value="" maxlength="200" dir="auto"><input name="desc_ar_3" value="" maxlength="200" dir="rtl" placeholder="Description in Arabic"></td>
          <td><input name="qty_3" value="1" size="5" dir="ltr" inputmode="decimal"></td>
          <td><input name="price_3" value="" size="9" dir="ltr" inputmode="decimal" placeholder="catalogue price"></td>
        </tr>
      </tbody>
    </table>
    <p><label>Notes <textarea name="notes" rows="3" maxlength="1000" dir="auto"></textarea></label></p>
    <p><button type="submit" class="btn-brand">Create quotation</button> <a href="/quotes">Cancel</a></p>
  </form>

