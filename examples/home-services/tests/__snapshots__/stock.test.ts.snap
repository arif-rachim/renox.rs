        <td dir="ltr">22.00 د.إ.</td>
        <td dir="ltr">176.00 د.إ.</td>
        <td></td>
      </tr><tr id="stock-pt_00000000000d0004">
        <td dir="ltr"><a href="/admin/stock/pt_00000000000d0004?branch=br_dubai" dir="auto">CAP-45UF</a></td>
        <td dir="auto">مكثف تشغيل 45 ميكروفاراد</td>
        <td dir="auto">قطعة</td>
