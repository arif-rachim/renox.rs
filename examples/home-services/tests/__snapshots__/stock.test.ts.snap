exports[`the pages snapshots: the page and the history, in English and in Arabic: role: stock, owner, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>Stock · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Omar Owner</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">Notifications <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/admin/stock">
    <select name="org" aria-label="Organisation">
      <option value="org_dubai" selected dir="auto">Dubai · owner</option><option value="org_sharjah" dir="auto">Sharjah · owner</option>
    </select>
    <button type="submit">Switch</button>
    <a href="/org/members">Members</a>
  </form>
</span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/admin/stock?branch=br_dubai&amp;lang=ar" lang="ar">العربية</a>
    </nav>
  </header>
  <div class="backoffice">
    <nav class="backoffice-nav" aria-label="Back office">
      <a href="/admin">Dashboard</a>
      <a href="/admin/settings">Branding</a>
      <a href="/admin/branches">Branches</a>
      <a href="/admin/import">Import</a>
      <a href="/admin/parts">Parts</a>
      <a href="/admin/suppliers">Suppliers</a>
      <a href="/admin/whatsapp">WhatsApp</a>
      <a href="/admin/people">People</a>
      <a href="/admin/audit">Audit trail</a>
      <a href="/">Work list</a>
    </nav>
    <main id="main" tabindex="-1">
      
  
  <h1>Stock</h1>
  
  <nav class="pager" id="branch-picker" aria-label="Branches">
    <strong id="branch-br_dubai" aria-current="page" dir="auto">Dubai</strong> <a href="/admin/stock?branch=br_sharjah" id="branch-br_sharjah" dir="auto">Sharjah</a> 
  </nav>
  <h2 id="branch-name" dir="auto">Dubai</h2>
  <form class="search" role="search" action="/admin/stock" method="get">
    <input type="hidden" name="branch" value="br_dubai">
    <input type="search" name="q" value="" placeholder="Search by SKU or name" aria-label="Search by SKU or name" autocomplete="off" dir="auto">
    <label><input type="checkbox" name="low" value="1"> Low stock only</label>
    <button type="submit">Search</button>
  </form>
  <div class="table-scroll" tabindex="0"><table id="stock">
    <caption class="visually-hidden">Stock</caption>
    <thead>
      <tr><th scope="col">SKU</th><th scope="col">Name</th><th scope="col">Unit</th><th scope="col">On hand</th><th scope="col">Minimum</th><th scope="col">Average cost</th><th scope="col">Value</th><th scope="col">Status</th></tr>
    </thead>
    <tbody>
      <tr id="stock-pt_0000000000813a01">
        <td dir="ltr"><a href="/admin/stock/pt_0000000000813a01?branch=br_dubai" dir="auto">AC-FILTER</a></td>
        <td dir="auto">AC filter</td>
        <td dir="auto">piece</td>
        <td dir="ltr">17</td>
        <td dir="ltr">5</td>
        <td dir="ltr">AED 6.00</td>
        <td dir="ltr">AED 102.00</td>
        <td></td>
      </tr><tr id="stock-pt_00000000000d0003">
        <td dir="ltr"><a href="/admin/stock/pt_00000000000d0003?branch=br_dubai" dir="auto">CAP-35UF</a></td>
        <td dir="auto">Run capacitor 35 uF</td>
        <td dir="auto">piece</td>
        <td dir="ltr">8</td>
        <td dir="ltr">5</td>
        <td dir="ltr">AED 22.00</td>
        <td dir="ltr">AED 176.00</td>
        <td></td>
      </tr><tr id="stock-pt_00000000000d0004">
        <td dir="ltr"><a href="/admin/stock/pt_00000000000d0004?branch=br_dubai" dir="auto">CAP-45UF</a></td>
        <td dir="auto">Run capacitor 45 uF</td>
        <td dir="auto">piece</td>
        <td dir="ltr">6</td>
        <td dir="ltr">5</td>
        <td dir="ltr">AED 26.00</td>
        <td dir="ltr">AED 156.00</td>
        <td></td>
      </tr><tr id="stock-pt_00000000000d000c">
        <td dir="ltr"><a href="/admin/stock/pt_00000000000d000c?branch=br_dubai" dir="auto">DESCALE-KIT</a></td>
        <td dir="auto">Descaling kit</td>
        <td dir="auto">piece</td>
        <td dir="ltr">6</td>
        <td dir="ltr">4</td>
        <td dir="ltr">AED 20.00</td>
        <td dir="ltr">AED 120.00</td>
        <td></td>
      </tr><tr id="stock-pt_00000000000d0002">
        <td dir="ltr"><a href="/admin/stock/pt_00000000000d0002?branch=br_dubai" dir="auto">FIL-AC-C</a></td>
        <td dir="auto">AC filter, cassette unit</td>
        <td dir="auto">piece</td>
        <td dir="ltr">4</td>
        <td dir="ltr">6</td>
        <td dir="ltr">AED 18.00</td>
        <td dir="ltr">AED 72.00</td>
        <td><strong class="badge" id="low-pt_00000000000d0002">Low</strong></td>
      </tr><tr id="stock-pt_00000000000d0001">
        <td dir="ltr"><a href="/admin/stock/pt_00000000000d0001?branch=br_dubai" dir="auto">FIL-AC-S</a></td>
        <td dir="auto">AC filter, split unit</td>
        <td dir="auto">piece</td>
        <td dir="ltr">14</td>
        <td dir="ltr">10</td>
        <td dir="ltr">AED 12.00</td>
        <td dir="ltr">AED 168.00</td>
        <td></td>
      </tr><tr id="stock-pt_00000000000d000b">
        <td dir="ltr"><a href="/admin/stock/pt_00000000000d000b?branch=br_dubai" dir="auto">MIXER-TAP</a></td>
        <td dir="auto">Kitchen mixer tap</td>
        <td dir="auto">piece</td>
        <td dir="ltr">4</td>
        <td dir="ltr">2</td>
        <td dir="ltr">AED 110.00</td>
        <td dir="ltr">AED 440.00</td>
        <td></td>
      </tr><tr id="stock-pt_0000000000813a02">
        <td dir="ltr"><a href="/admin/stock/pt_0000000000813a02?branch=br_dubai" dir="auto">PIPE-15</a></td>
        <td dir="auto">Copper pipe 15 mm</td>
        <td dir="auto">metre</td>
        <td dir="ltr">0</td>
        <td dir="ltr">0</td>
        <td dir="ltr">AED 1.00</td>
        <td dir="ltr">AED 0.00</td>
        <td></td>
      </tr><tr id="stock-pt_00000000000d0007">
        <td dir="ltr"><a href="/admin/stock/pt_00000000000d0007?branch=br_dubai" dir="auto">PVC-ELB-25</a></td>
        <td dir="auto">PVC elbow 25 mm</td>
        <td dir="auto">piece</td>
        <td dir="ltr">60</td>
        <td dir="ltr">40</td>
        <td dir="ltr">AED 1.50</td>
        <td dir="ltr">AED 90.00</td>
        <td></td>
      </tr><tr id="stock-pt_00000000000d0009">
        <td dir="ltr"><a href="/admin/stock/pt_00000000000d0009?branch=br_dubai" dir="auto">PVC-PIPE-25</a></td>
        <td dir="auto">PVC pipe 25 mm</td>
        <td dir="auto">metre</td>
        <td dir="ltr">30</td>
        <td dir="ltr">20</td>
        <td dir="ltr">AED 4.50</td>
        <td dir="ltr">AED 135.00</td>
        <td></td>
      </tr><tr id="stock-pt_00000000000d0008">
        <td dir="ltr"><a href="/admin/stock/pt_00000000000d0008?branch=br_dubai" dir="auto">PVC-TEE-25</a></td>
        <td dir="auto">PVC tee 25 mm</td>
        <td dir="auto">piece</td>
        <td dir="ltr">25</td>
        <td dir="ltr">30</td>
        <td dir="ltr">AED 2.00</td>
        <td dir="ltr">AED 50.00</td>
        <td><strong class="badge" id="low-pt_00000000000d0008">Low</strong></td>
      </tr><tr id="stock-pt_00000000000d0006">
        <td dir="ltr"><a href="/admin/stock/pt_00000000000d0006?branch=br_dubai" dir="auto">REF-R22</a></td>
        <td dir="auto">Refrigerant R22</td>
        <td dir="auto">kg</td>
        <td dir="ltr">2</td>
        <td dir="ltr">3</td>
        <td dir="ltr">AED 45.00</td>
        <td dir="ltr">AED 90.00</td>
        <td><strong class="badge" id="low-pt_00000000000d0006">Low</strong></td>
      </tr><tr id="stock-pt_00000000000d0005">
        <td dir="ltr"><a href="/admin/stock/pt_00000000000d0005?branch=br_dubai" dir="auto">REF-R410A</a></td>
        <td dir="auto">Refrigerant R410A</td>
        <td dir="auto">kg</td>
        <td dir="ltr">6</td>
        <td dir="ltr">4</td>
        <td dir="ltr">AED 38.00</td>
        <td dir="ltr">AED 228.00</td>
        <td></td>
      </tr><tr id="stock-pt_00000000000d000a">
        <td dir="ltr"><a href="/admin/stock/pt_00000000000d000a?branch=br_dubai" dir="auto">SEAL-SIL-CL</a></td>
        <td dir="auto">Silicone sealant, clear</td>
        <td dir="auto">piece</td>
        <td dir="ltr">16</td>
        <td dir="ltr">12</td>
        <td dir="ltr">AED 11.00</td>
        <td dir="ltr">AED 176.00</td>
        <td></td>
      </tr>
    </tbody>
  </table></div>
  <h2>Value of the stock by branch (average cost)</h2>
  <ul id="totals">
    <li id="total-br_dubai" dir="auto">Dubai: <span dir="ltr">AED 2,003.00</span></li><li id="total-br_sharjah" dir="auto">Sharjah: <span dir="ltr">AED 1,630.00</span></li>
  </ul>
  <p><small class="muted">The quantity on hand changes only through moves: receive, count, transfer, a visit or a purchase order. Open a SKU to see its moves.</small></p>
  <p><a href="/reports/stock" id="stock-report-link">Stock report (CSV and Excel)</a></p>

  <section id="stock-forms">
    <h2>Receive stock</h2>
    <form method="post" action="?/receive" hx-post="?/receive" class="stack narrow" id="receive-form"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="branch" value="br_dubai">
      <p><label>Part <select name="part" id="f-receive-part" required aria-required="true"><option value=""></option><option value="pt_0000000000813a01" dir="auto">AC-FILTER: AC filter</option><option value="pt_00000000000d0003" dir="auto">CAP-35UF: Run capacitor 35 uF</option><option value="pt_00000000000d0004" dir="auto">CAP-45UF: Run capacitor 45 uF</option><option value="pt_00000000000d000c" dir="auto">DESCALE-KIT: Descaling kit</option><option value="pt_00000000000d0002" dir="auto">FIL-AC-C: AC filter, cassette unit</option><option value="pt_00000000000d0001" dir="auto">FIL-AC-S: AC filter, split unit</option><option value="pt_00000000000d000b" dir="auto">MIXER-TAP: Kitchen mixer tap</option><option value="pt_0000000000813a02" dir="auto">PIPE-15: Copper pipe 15 mm</option><option value="pt_00000000000d0007" dir="auto">PVC-ELB-25: PVC elbow 25 mm</option><option value="pt_00000000000d0009" dir="auto">PVC-PIPE-25: PVC pipe 25 mm</option><option value="pt_00000000000d0008" dir="auto">PVC-TEE-25: PVC tee 25 mm</option><option value="pt_00000000000d0006" dir="auto">REF-R22: Refrigerant R22</option><option value="pt_00000000000d0005" dir="auto">REF-R410A: Refrigerant R410A</option><option value="pt_00000000000d000a" dir="auto">SEAL-SIL-CL: Silicone sealant, clear</option></select></label></p>
      <p><label>Quantity <input name="qty" dir="ltr" inputmode="decimal" size="10" required aria-required="true" id="f-receive-qty" value=""></label></p>
      <p><label>Unit cost (AED) <input name="unit_cost" dir="ltr" inputmode="decimal" size="10" required aria-required="true" id="f-receive-unit_cost" value=""></label></p>
      <p><label>Reason <input name="reason" maxlength="200" required aria-required="true" id="f-receive-reason" value="" dir="auto"></label></p>
      <p><button type="submit" class="btn-brand" id="receive-submit">Receive</button></p>
    </form>

    <h2>Count and adjust</h2>
    <p><small class="muted">Enter what you counted on the shelf: the difference is recorded as a move. Asks for your second factor.</small></p>
    <form method="post" action="?/adjust" hx-post="?/adjust" class="stack narrow" id="adjust-form"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="branch" value="br_dubai">
      <p><label>Part <select name="part" id="f-adjust-part" required aria-required="true"><option value=""></option><option value="pt_0000000000813a01" dir="auto">AC-FILTER: AC filter</option><option value="pt_00000000000d0003" dir="auto">CAP-35UF: Run capacitor 35 uF</option><option value="pt_00000000000d0004" dir="auto">CAP-45UF: Run capacitor 45 uF</option><option value="pt_00000000000d000c" dir="auto">DESCALE-KIT: Descaling kit</option><option value="pt_00000000000d0002" dir="auto">FIL-AC-C: AC filter, cassette unit</option><option value="pt_00000000000d0001" dir="auto">FIL-AC-S: AC filter, split unit</option><option value="pt_00000000000d000b" dir="auto">MIXER-TAP: Kitchen mixer tap</option><option value="pt_0000000000813a02" dir="auto">PIPE-15: Copper pipe 15 mm</option><option value="pt_00000000000d0007" dir="auto">PVC-ELB-25: PVC elbow 25 mm</option><option value="pt_00000000000d0009" dir="auto">PVC-PIPE-25: PVC pipe 25 mm</option><option value="pt_00000000000d0008" dir="auto">PVC-TEE-25: PVC tee 25 mm</option><option value="pt_00000000000d0006" dir="auto">REF-R22: Refrigerant R22</option><option value="pt_00000000000d0005" dir="auto">REF-R410A: Refrigerant R410A</option><option value="pt_00000000000d000a" dir="auto">SEAL-SIL-CL: Silicone sealant, clear</option></select></label></p>
      <p><label>Counted quantity <input name="counted" dir="ltr" inputmode="decimal" size="10" required aria-required="true" id="f-adjust-counted" value=""></label></p>
      <p><label>Reason <input name="reason" maxlength="200" required aria-required="true" id="f-adjust-reason" value="" dir="auto"></label></p>
      <p><button type="submit" class="btn-brand" id="adjust-submit">Record the count</button></p>
    </form>

    <h2>Transfer to another branch</h2>
    
    <form method="post" action="?/transfer" hx-post="?/transfer" class="stack narrow" id="transfer-form"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="branch" value="br_dubai">
      <p><label>Part <select name="part" id="f-transfer-part" required aria-required="true"><option value=""></option><option value="pt_0000000000813a01" dir="auto">AC-FILTER: AC filter</option><option value="pt_00000000000d0003" dir="auto">CAP-35UF: Run capacitor 35 uF</option><option value="pt_00000000000d0004" dir="auto">CAP-45UF: Run capacitor 45 uF</option><option value="pt_00000000000d000c" dir="auto">DESCALE-KIT: Descaling kit</option><option value="pt_00000000000d0002" dir="auto">FIL-AC-C: AC filter, cassette unit</option><option value="pt_00000000000d0001" dir="auto">FIL-AC-S: AC filter, split unit</option><option value="pt_00000000000d000b" dir="auto">MIXER-TAP: Kitchen mixer tap</option><option value="pt_0000000000813a02" dir="auto">PIPE-15: Copper pipe 15 mm</option><option value="pt_00000000000d0007" dir="auto">PVC-ELB-25: PVC elbow 25 mm</option><option value="pt_00000000000d0009" dir="auto">PVC-PIPE-25: PVC pipe 25 mm</option><option value="pt_00000000000d0008" dir="auto">PVC-TEE-25: PVC tee 25 mm</option><option value="pt_00000000000d0006" dir="auto">REF-R22: Refrigerant R22</option><option value="pt_00000000000d0005" dir="auto">REF-R410A: Refrigerant R410A</option><option value="pt_00000000000d000a" dir="auto">SEAL-SIL-CL: Silicone sealant, clear</option></select></label></p>
      <p><label>Quantity <input name="qty" dir="ltr" inputmode="decimal" size="10" required aria-required="true" id="f-transfer-qty" value=""></label></p>
      <p><label>To branch <select name="to_branch" id="f-transfer-to_branch" required aria-required="true"><option value="br_sharjah" dir="auto">Sharjah</option></select></label></p>
      <p><label>Reason <input name="reason" maxlength="200" required aria-required="true" id="f-transfer-reason" value="" dir="auto"></label></p>
      <p><button type="submit" class="btn-brand" id="transfer-submit">Transfer</button></p>
    </form>
  </section>

    </main>
  </div>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
`;

exports[`the pages snapshots: the page and the history, in English and in Arabic: role: stock, owner, ar 1`] = `
"<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>المخزون · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  
</head>
<body>
  <a class="skip" href="#main">تخطَّ إلى المحتوى الرئيسي</a>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Omar Owner</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">الإشعارات <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/admin/stock">
    <select name="org" aria-label="المؤسسة">
      <option value="org_dubai" selected dir="auto">Dubai · مالك</option><option value="org_sharjah" dir="auto">Sharjah · مالك</option>
    </select>
    <button type="submit">تبديل</button>
    <a href="/org/members">الأعضاء</a>
  </form>
</span>
    <nav class="i18n-language" aria-label="اللغة">
      <a href="/admin/stock?branch=br_dubai&amp;lang=en" lang="en">English</a><strong lang="ar">العربية</strong>
    </nav>
  </header>
  <div class="backoffice">
    <nav class="backoffice-nav" aria-label="المكتب الإداري">
