    </nav>
    <main id="main" tabindex="-1">
      
  
  <h1>المخزون</h1>
  
  <nav class="pager" id="branch-picker" aria-label="الفروع">
    <strong id="branch-br_dubai" aria-current="page" dir="auto">دبي</strong> <a href="/admin/stock?branch=br_sharjah" id="branch-br_sharjah" dir="auto">الشارقة</a> 
  </nav>
  <h2 id="branch-name" dir="auto">دبي</h2>
  <form class="search" role="search" action="/admin/stock" method="get">
    <input type="hidden" name="branch" value="br_dubai">
    <input type="search" name="q" value="" placeholder="ابحث برمز الصنف أو الاسم" aria-label="ابحث برمز الصنف أو الاسم" autocomplete="off" dir="auto">
    <label><input type="checkbox" name="low" value="1"> المخزون المنخفض فقط</label>
