        <td dir="auto">Transfer <span dir="ltr">tr_<id></span></td>
        <td dir="auto">Omar Owner</td>
      </tr><tr id="move-<id>">
        <td dir="ltr"><when></td>
        <td dir="auto">Transferred in</td>
        <td dir="ltr">+3</td>
        <td dir="ltr">20</td>
