  <p><a href="/reports/stock" id="stock-report-link">تقرير المخزون (CSV وإكسل)</a></p>

  <section id="stock-forms">
    <h2>استلام مخزون</h2>
    <form method="post" action="?/receive" hx-post="?/receive" class="stack narrow" id="receive-form"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="branch" value="br_dubai">
      <p><label>القطعة <select name="part" id="f-receive-part" required aria-required="true"><option value=""></option><option value="pt_0000000000813a01" dir="auto">AC-FILTER: فلتر مكيف</option><option value="pt_00000000000d0003" dir="auto">CAP-35UF: مكثف تشغيل 35 ميكروفاراد</option><option value="pt_00000000000d0004" dir="auto">CAP-45UF: مكثف تشغيل 45 ميكروفاراد</option><option value="pt_00000000000d000c" dir="auto">DESCALE-KIT: عدة إزالة الترسبات</option><option value="pt_00000000000d0002" dir="auto">FIL-AC-C: فلتر مكيف كاسيت</option><option value="pt_00000000000d0001" dir="auto">FIL-AC-S: فلتر مكيف سبليت</option><option value="pt_00000000000d000b" dir="auto">MIXER-TAP: خلاط حوض المطبخ</option><option value="pt_0000000000813a02" dir="auto">PIPE-15: أنبوب نحاسي 15 مم</option><option value="pt_00000000000d0007" dir="auto">PVC-ELB-25: كوع بي في سي 25 مم</option><option value="pt_00000000000d0009" dir="auto">PVC-PIPE-25: أنبوب بي في سي 25 مم</option><option value="pt_00000000000d0008" dir="auto">PVC-TEE-25: تي بي في سي 25 مم</option><option value="pt_00000000000d0006" dir="auto">REF-R22: غاز التبريد R22</option><option value="pt_00000000000d0005" dir="auto">REF-R410A: غاز التبريد R410A</option><option value="pt_00000000000d000a" dir="auto">SEAL-SIL-CL: سيليكون شفاف</option></select></label></p>
      <p><label>الكمية <input name="qty" dir="ltr" inputmode="decimal" size="10" required aria-required="true" id="f-receive-qty" value=""></label></p>
      <p><label>تكلفة الوحدة (درهم) <input name="unit_cost" dir="ltr" inputmode="decimal" size="10" required aria-required="true" id="f-receive-unit_cost" value=""></label></p>
      <p><label>السبب <input name="reason" maxlength="200" required aria-required="true" id="f-receive-reason" value="" dir="auto"></label></p>
      <p><button type="submit" class="btn-brand" id="receive-submit">استلام</button></p>
    </form>

    <h2>الجرد والتعديل</h2>
    <p><small class="muted">أدخل ما عددته على الرف: يُسجَّل الفرق كحركة. يطلب العامل الثاني للتحقق.</small></p>
    <form method="post" action="?/adjust" hx-post="?/adjust" class="stack narrow" id="adjust-form"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="branch" value="br_dubai">
      <p><label>القطعة <select name="part" id="f-adjust-part" required aria-required="true"><option value=""></option><option value="pt_0000000000813a01" dir="auto">AC-FILTER: فلتر مكيف</option><option value="pt_00000000000d0003" dir="auto">CAP-35UF: مكثف تشغيل 35 ميكروفاراد</option><option value="pt_00000000000d0004" dir="auto">CAP-45UF: مكثف تشغيل 45 ميكروفاراد</option><option value="pt_00000000000d000c" dir="auto">DESCALE-KIT: عدة إزالة الترسبات</option><option value="pt_00000000000d0002" dir="auto">FIL-AC-C: فلتر مكيف كاسيت</option><option value="pt_00000000000d0001" dir="auto">FIL-AC-S: فلتر مكيف سبليت</option><option value="pt_00000000000d000b" dir="auto">MIXER-TAP: خلاط حوض المطبخ</option><option value="pt_0000000000813a02" dir="auto">PIPE-15: أنبوب نحاسي 15 مم</option><option value="pt_00000000000d0007" dir="auto">PVC-ELB-25: كوع بي في سي 25 مم</option><option value="pt_00000000000d0009" dir="auto">PVC-PIPE-25: أنبوب بي في سي 25 مم</option><option value="pt_00000000000d0008" dir="auto">PVC-TEE-25: تي بي في سي 25 مم</option><option value="pt_00000000000d0006" dir="auto">REF-R22: غاز التبريد R22</option><option value="pt_00000000000d0005" dir="auto">REF-R410A: غاز التبريد R410A</option><option value="pt_00000000000d000a" dir="auto">SEAL-SIL-CL: سيليكون شفاف</option></select></label></p>
      <p><label>الكمية المجرودة <input name="counted" dir="ltr" inputmode="decimal" size="10" required aria-required="true" id="f-adjust-counted" value=""></label></p>
      <p><label>السبب <input name="reason" maxlength="200" required aria-required="true" id="f-adjust-reason" value="" dir="auto"></label></p>
      <p><button type="submit" class="btn-brand" id="adjust-submit">سجّل الجرد</button></p>
    </form>

    <h2>تحويل إلى فرع آخر</h2>
    
    <form method="post" action="?/transfer" hx-post="?/transfer" class="stack narrow" id="transfer-form"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="branch" value="br_dubai">
      <p><label>القطعة <select name="part" id="f-transfer-part" required aria-required="true"><option value=""></option><option value="pt_0000000000813a01" dir="auto">AC-FILTER: فلتر مكيف</option><option value="pt_00000000000d0003" dir="auto">CAP-35UF: مكثف تشغيل 35 ميكروفاراد</option><option value="pt_00000000000d0004" dir="auto">CAP-45UF: مكثف تشغيل 45 ميكروفاراد</option><option value="pt_00000000000d000c" dir="auto">DESCALE-KIT: عدة إزالة الترسبات</option><option value="pt_00000000000d0002" dir="auto">FIL-AC-C: فلتر مكيف كاسيت</option><option value="pt_00000000000d0001" dir="auto">FIL-AC-S: فلتر مكيف سبليت</option><option value="pt_00000000000d000b" dir="auto">MIXER-TAP: خلاط حوض المطبخ</option><option value="pt_0000000000813a02" dir="auto">PIPE-15: أنبوب نحاسي 15 مم</option><option value="pt_00000000000d0007" dir="auto">PVC-ELB-25: كوع بي في سي 25 مم</option><option value="pt_00000000000d0009" dir="auto">PVC-PIPE-25: أنبوب بي في سي 25 مم</option><option value="pt_00000000000d0008" dir="auto">PVC-TEE-25: تي بي في سي 25 مم</option><option value="pt_00000000000d0006" dir="auto">REF-R22: غاز التبريد R22</option><option value="pt_00000000000d0005" dir="auto">REF-R410A: غاز التبريد R410A</option><option value="pt_00000000000d000a" dir="auto">SEAL-SIL-CL: سيليكون شفاف</option></select></label></p>
      <p><label>الكمية <input name="qty" dir="ltr" inputmode="decimal" size="10" required aria-required="true" id="f-transfer-qty" value=""></label></p>
      <p><label>إلى الفرع <select name="to_branch" id="f-transfer-to_branch" required aria-required="true"><option value="br_sharjah" dir="auto">الشارقة</option></select></label></p>
      <p><label>السبب <input name="reason" maxlength="200" required aria-required="true" id="f-transfer-reason" value="" dir="auto"></label></p>
      <p><button type="submit" class="btn-brand" id="transfer-submit">تحويل</button></p>
    </form>
  </section>

    </main>
  </div>
  <footer><small dir="auto">فيكس إت للخدمات ذ.م.م، دبي</small></footer>


</body></html>"
