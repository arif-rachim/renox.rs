        </td>
      </tr><tr id="staff-u_dxb_dispatcher">
        <td dir="auto">Dina Dispatcher</td>
        <td dir="ltr">dispatcher.dubai@fixit.example</td>
        <td><span class="role" dir="auto">Dispatcher</span> </td>
        <td>Off
