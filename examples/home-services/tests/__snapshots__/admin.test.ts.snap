exports[`reset second factor the first POST asks for a confirmation and changes nothing, in English and in Arabic: role: reset second factor confirmation, owner, en 1`] = `
"<section id="confirm-reset" aria-labelledby="confirm-reset-title">
    <h2 id="confirm-reset-title">Reset second factor</h2>
    <p>Reset the second factor of Hamad Saeed? They will set it up again at their next sign-in.</p>
    <form method="post" action="?/reset_2fa" hx-post="?/reset_2fa" class="inline"><input type="hidden" name="_csrf" value="<csrf>"><input type="hidden" name="user_id" value="u_shj_hamad"><input type="hidden" name="confirm" value="1">
      <button type="submit" class="btn-brand" aria-label="Yes, reset it: Hamad Saeed">Yes, reset it</button>
      <a href="/admin/people">Cancel</a></form>
  </section>"
`;

exports[`reset second factor the first POST asks for a confirmation and changes nothing, in English and in Arabic: role: reset second factor confirmation, owner, ar 1`] = `
"<section id="confirm-reset" aria-labelledby="confirm-reset-title">
