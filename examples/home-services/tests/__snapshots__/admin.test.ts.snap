exports[`/admin per role normal case: the owner sees the module's dashboard with the app's sidebar links and its tile: role: admin sidebar and tile, owner, en 1`] = `
"<nav class="renox-admin-sidebar" aria-label="Admin">
    <a href="/admin/">Dashboard</a>
    <a href="/admin/users">Users</a>
    <a href="/admin/audit">Audit trail</a>
    <a href="/billing/invoices" class="renox-admin-link">All invoices</a><a href="/jobs" class="renox-admin-link">Jobs</a><a href="/notifications/prefs" class="renox-admin-link">Notifications</a><a class="renox-org-admin" href="/org/members">Members and invitations</a><a href="/files" class="renox-admin-link">Files</a><a href="/admin/branches" id="nav-branches">Branches</a>
<a href="/admin/import" id="nav-import">Import</a>
<a href="/admin/parts" id="nav-parts">Parts</a>
<a href="/admin/stock" id="nav-stock">Stock</a>
<a href="/admin/suppliers" id="nav-suppliers">Suppliers</a>
<a href="/admin/purchasing" id="nav-purchasing">Purchase orders</a>
<a href="/admin/whatsapp" id="nav-whatsapp">WhatsApp</a>
<a href="/admin/people" id="nav-people">People</a>
<a href="/admin/settings" id="nav-branding">Branding</a>
