      <a href="/admin/people">إلغاء</a></form>
  </section>"
`;

exports[`weekly working hours (/admin/branches) error cases: a close before the open, a time off the half hour, and no open day are 422s naming the row; nothing changes: role: branch hours form, a 422 on Friday, owner, en 1`] = `
"<form method="post" action="?/hours" hx-post="?/hours" class="stack narrow" id="hours-form-br_dubai"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="branch_id" value="br_dubai">
      <fieldset>
        <legend>Working hours: Dubai</legend>
        
        <p class="row" id="hours-br_dubai-1">
          <strong dir="auto">Monday</strong>
          <label><input type="checkbox" name="closed_1" value="on"> Closed</label>
          <label>Opens <input type="time" step="1800" dir="ltr" name="open_1" value="08:00" id="f-hours-br_dubai-hours_1"></label>
          <label>Closes <input type="time" step="1800" dir="ltr" name="close_1" value="18:00"></label>
        </p><p class="row" id="hours-br_dubai-2">
          <strong dir="auto">Tuesday</strong>
          <label><input type="checkbox" name="closed_2" value="on"> Closed</label>
          <label>Opens <input type="time" step="1800" dir="ltr" name="open_2" value="08:00" id="f-hours-br_dubai-hours_2"></label>
          <label>Closes <input type="time" step="1800" dir="ltr" name="close_2" value="18:00"></label>
        </p><p class="row" id="hours-br_dubai-3">
          <strong dir="auto">Wednesday</strong>
          <label><input type="checkbox" name="closed_3" value="on"> Closed</label>
          <label>Opens <input type="time" step="1800" dir="ltr" name="open_3" value="08:00" id="f-hours-br_dubai-hours_3"></label>
          <label>Closes <input type="time" step="1800" dir="ltr" name="close_3" value="18:00"></label>
        </p><p class="row" id="hours-br_dubai-4">
          <strong dir="auto">Thursday</strong>
          <label><input type="checkbox" name="closed_4" value="on"> Closed</label>
          <label>Opens <input type="time" step="1800" dir="ltr" name="open_4" value="08:00" id="f-hours-br_dubai-hours_4"></label>
          <label>Closes <input type="time" step="1800" dir="ltr" name="close_4" value="18:00"></label>
        </p><p class="row" id="hours-br_dubai-5">
          <strong dir="auto">Friday</strong>
          <label><input type="checkbox" name="closed_5" value="on"> Closed</label>
          <label>Opens <input type="time" step="1800" dir="ltr" name="open_5" value="15:00" id="f-hours-br_dubai-hours_5" aria-invalid="true" aria-describedby="err-hours_5"></label>
          <label>Closes <input type="time" step="1800" dir="ltr" name="close_5" value="14:30" aria-invalid="true"></label>
        </p><p class="row" id="hours-br_dubai-6">
          <strong dir="auto">Saturday</strong>
          <label><input type="checkbox" name="closed_6" value="on"> Closed</label>
          <label>Opens <input type="time" step="1800" dir="ltr" name="open_6" value="08:00" id="f-hours-br_dubai-hours_6"></label>
          <label>Closes <input type="time" step="1800" dir="ltr" name="close_6" value="18:00"></label>
        </p><p class="row" id="hours-br_dubai-0">
          <strong dir="auto">Sunday</strong>
          <label><input type="checkbox" name="closed_0" value="on" checked> Closed</label>
          <label>Opens <input type="time" step="1800" dir="ltr" name="open_0" value="08:00" id="f-hours-br_dubai-hours_0"></label>
          <label>Closes <input type="time" step="1800" dir="ltr" name="close_0" value="18:00"></label>
        </p>
      </fieldset>
      <p><button type="submit">Save hours</button></p>
    </form>"
`;

