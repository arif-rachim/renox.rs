exports[`people the users page lists the branch with roles and who has a second factor: role: users table, owner, en 1`] = `
"<table id="staff">
    <caption class="visually-hidden">People of the branch</caption>
    <thead><tr><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Roles</th><th scope="col">Second factor</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
    <tbody>
      <tr id="staff-u_dxb_ali">
        <td dir="auto">Ali Hassan</td>
        <td dir="ltr">ali.dubai@fixit.example</td>
        <td><span class="role" dir="auto">Technician</span> </td>
        <td>Off
          </td>
        <td>
          <form method="post" action="?/role" hx-post="?/role" class="inline"><input type="hidden" name="_csrf" value="<csrf>"><input type="hidden" name="user_id" value="u_dxb_ali">
            <select name="role" id="f-role-u_dxb_ali" aria-label="Role: Ali Hassan"><option value="owner" dir="auto">Owner</option><option value="branch_manager" dir="auto">Branch manager</option><option value="dispatcher" dir="auto">Dispatcher</option><option value="technician" selected dir="auto">Technician</option><option value="accountant" dir="auto">Accountant</option></select>
            <button type="submit">Change role</button></form>
          <form method="post" action="?/remove" hx-post="?/remove" class="inline"><input type="hidden" name="_csrf" value="<csrf>"><input type="hidden" name="user_id" value="u_dxb_ali"><button type="submit">Remove from branch</button></form>
        </td>
      </tr><tr id="staff-u_dxb_accountant">
        <td dir="auto">Aziz Accountant</td>
        <td dir="ltr">accountant.dubai@fixit.example</td>
        <td><span class="role" dir="auto">Accountant</span> </td>
        <td>Off
