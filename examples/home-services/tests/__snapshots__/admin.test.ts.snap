exports[`/admin per role normal case: the owner sees the module's dashboard with the app's sidebar links and its tile: role: admin sidebar and tile, owner, en 1`] = `
"<nav class="renox-admin-sidebar" aria-label="Admin">
    <a href="./">Dashboard</a>
    <a href="users">Users</a>
    <a href="audit">Audit trail</a>
    <a href="/billing/invoices" class="renox-admin-link">All invoices</a><a href="/jobs" class="renox-admin-link">Jobs</a><a href="/notifications/prefs" class="renox-admin-link">Notifications</a><a class="renox-org-admin" href="/org/members">Members and invitations</a><a href="/files" class="renox-admin-link">Files</a><a href="/admin/branches" id="nav-branches">Branches</a>
<a href="/admin/import" id="nav-import">Import</a>
<a href="/admin/people" id="nav-people">People</a>
<a href="/admin/settings" id="nav-branding">Branding</a>
<a href="/admin/audit" id="nav-audit">Audit trail</a>
<a href="/" id="nav-work">Work list</a>
  </nav>
<article id="home-services-tile" class="tile-card" hx-get="/admin/tile" hx-trigger="load" hx-swap="outerHTML"><h2>Today in this branch</h2><p><a href="/admin/tile">Open</a></p></article>"
`;

exports[`/admin per role the tile's fragment holds the branch's three numbers: role: admin tile fragment, owner, en 1`] = `
"<article id="home-services-tile" class="tile-card">
    <h2>Branch: Dubai</h2>
    <section class="tiles" id="tiles">
      <article class="tile" id="tile-jobs"><span>Jobs today</span><strong dir="ltr"><n></strong><a href="/jobs">Jobs</a></article>
      <article class="tile" id="tile-invoices"><span>Open invoices</span><strong dir="ltr"><n></strong><a href="/invoices?status=open">Invoices</a></article>
      <article class="tile" id="tile-amc"><span>Contracts ending this month</span><strong dir="ltr"><n></strong><a href="/reports/amc">Contract renewals</a></article>
    </section>
  </article>"
`;

