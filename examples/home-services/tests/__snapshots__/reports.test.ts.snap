exports[`jobs per technician normal case: the owner sees the Dubai technicians' finished visits, not Sharjah's: role: technicians, owner, en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <title>Jobs per technician · FixIt Services</title>
  <link rel="stylesheet" href="/renox-ui.<hash>.css">
  
  <link rel="stylesheet" href="/app.<hash>.css">
  <link rel="stylesheet" href="/theme">
  <link rel="manifest" href="/me/manifest" crossorigin="use-credentials">
  <meta name="theme-color" content="#1f6f5c">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href="/icons/icon-192.<hash>.png">
  <script src="/me.<hash>.js" defer nonce="<nonce>"></script>
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <a href="/" class="brand-link"><strong dir="auto">FixIt Services</strong></a>
    <span class="spacer"></span>
    <span class="renox-user-menu"><a href="/auth/account" dir="auto">Omar Owner</a></span><a class="renox-notif-badge" href="/notifications" hx-ext="sse" sse-connect="/notifications/sse/notifications">Notifications <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">0</span></a><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/reports/technicians">
    <select name="org" aria-label="Organisation">
      <option value="org_dubai" selected dir="auto">Dubai · owner</option><option value="org_sharjah" dir="auto">Sharjah · owner</option>
    </select>
    <button type="submit">Switch</button>
    <a href="/org/members">Members</a>
  </form>
</span>
    <nav class="i18n-language" aria-label="Language">
      <strong lang="en">English</strong><a href="/reports/technicians?lang=ar" lang="ar">العربية</a>
    </nav>
  </header>
  <main id="main" tabindex="-1">
    
  
  <nav class="work-links" id="report-nav">
    <a href="/reports">Sales (VAT)</a>
    <a href="/reports/technicians">Jobs per technician</a>
    <a href="/reports/amc">Contract renewals</a>
    <a href="/reports/outstanding">Outstanding invoices</a>
  </nav>
  <h1>Jobs per technician</h1>
  <form class="search" action="/reports/technicians" method="get">
    <label>From <input type="date" name="from" value="<day>" dir="ltr"></label>
    <label>To <input type="date" name="to" value="<day>" dir="ltr"></label>
    <button type="submit">Show</button>
  </form>
  <div class="table-scroll" tabindex="0"><table id="report-technicians">
    <caption class="visually-hidden">Jobs per technician</caption>
    <thead><tr><th scope="col">Technician</th><th scope="col">Jobs done</th><th scope="col">Hours on site</th><th scope="col">Parts (AED)</th></tr></thead>
    <tbody>
      <tr><td dir="auto">Ali Hassan</td><td dir="ltr">1</td><td dir="ltr">0.91</td><td dir="ltr">AED 50.00</td></tr><tr><td dir="auto">Bilal Raza</td><td dir="ltr">2</td><td dir="ltr">2.06</td><td dir="ltr">AED 225.00</td></tr>
    </tbody>
  </table></div>
  <section id="export">
    <h2>Export</h2>
    <form method="post" action="?/export" hx-post="?/export" class="stack narrow"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="from" value="<day>"><input type="hidden" name="to" value="<day>">
      <p><label>Format
        <select name="format"><option value="csv">CSV</option><option value="xlsx">Excel (.xlsx)</option></select></label></p>
      <p><button type="submit">Download</button></p>
    </form>
  </section>

  </main>
  <footer><small dir="auto">FixIt Services LLC, Dubai</small></footer>


</body></html>"
`;

