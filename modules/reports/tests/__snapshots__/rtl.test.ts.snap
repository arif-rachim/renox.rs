// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`reports in both directions every page in en (ltr) and ar (rtl), snapshotted, no English left: role: reports en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Reports</title>
</head>
<body class="renox-reports">
  <main>
  
  <h1>Reports</h1>
  <form method="get">
    <label>From <input type="date" name="from" value="<date>"></label>
    <label>To <input type="date" name="to" value="<date>"></label>
    <button type="submit">Show</button>
  </form>
  <h2>Sales</h2>
  <table id="reports-sales">
    <thead><tr><th>Date</th><th>Documents</th><th>Net</th><th>VAT</th><th>Total</th></tr></thead>
    <tbody>
      <tr><td colspan="5">Nothing in this period.</td></tr>
    </tbody>
  </table>
  <h2>Cash</h2>
  <table id="reports-cash">
    <thead><tr><th>Date</th><th>Received</th><th>Refunded</th><th>Net</th></tr></thead>
    <tbody>
      <tr><td colspan="4">Nothing in this period.</td></tr>
    </tbody>
  </table>
  <section>
    <h2>Export</h2>
    <form method="post" action="?/export" hx-post="?/export"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="from" value="<date>"><input type="hidden" name="to" value="<date>">
      <select name="kind"><option value="sales" dir="auto">sales</option><option value="cash" dir="auto">cash</option><option value="xero" dir="auto">xero</option><option value="quickbooks" dir="auto">quickbooks</option><option value="zoho" dir="auto">zoho</option></select>
      <select name="format"><option value="csv">CSV</option><option value="xlsx">Excel (.xlsx)</option></select>
      <button type="submit">Download</button>
    </form>
  </section>
</main>


</body></html>"
`;

exports[`reports in both directions every page in en (ltr) and ar (rtl), snapshotted, no English left: role: reports ar 1`] = `
"<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>التقارير</title>
</head>
<body class="renox-reports">
  <main>
  
  <h1>التقارير</h1>
  <form method="get">
    <label>من <input type="date" name="from" value="<date>"></label>
    <label>إلى <input type="date" name="to" value="<date>"></label>
    <button type="submit">عرض</button>
  </form>
  <h2>المبيعات</h2>
  <table id="reports-sales">
    <thead><tr><th>التاريخ</th><th>المستندات</th><th>الصافي</th><th>الضريبة</th><th>الإجمالي</th></tr></thead>
    <tbody>
      <tr><td colspan="5">لا شيء في هذه الفترة.</td></tr>
    </tbody>
  </table>
  <h2>النقد</h2>
  <table id="reports-cash">
    <thead><tr><th>التاريخ</th><th>المقبوض</th><th>المسترد</th><th>الصافي</th></tr></thead>
    <tbody>
      <tr><td colspan="4">لا شيء في هذه الفترة.</td></tr>
    </tbody>
  </table>
  <section>
    <h2>تصدير</h2>
    <form method="post" action="?/export" hx-post="?/export"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="from" value="<date>"><input type="hidden" name="to" value="<date>">
      <select name="kind"><option value="sales" dir="auto">sales</option><option value="cash" dir="auto">cash</option><option value="xero" dir="auto">xero</option><option value="quickbooks" dir="auto">quickbooks</option><option value="zoho" dir="auto">zoho</option></select>
      <select name="format"><option value="csv">CSV</option><option value="xlsx">Excel (.xlsx)</option></select>
      <button type="submit">تنزيل</button>
    </form>
  </section>
</main>


</body></html>"
`;
