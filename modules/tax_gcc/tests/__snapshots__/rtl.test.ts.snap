exports[`tax_gcc in both directions the return and the invoice in en (ltr) and ar (rtl), snapshotted, no English left: role: invoice en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>INV-000001</title>
</head>
<body class="renox-tax">
  <main>
  
  <article class="tax-invoice">
    <table role="presentation" width="100%"><tbody><tr>
      <td lang="en" dir="ltr"><h1 dir="auto">Tax Invoice</h1></td>
      <td lang="ar" dir="rtl" style="text-align:right"><h1 dir="auto">فاتورة ضريبية</h1></td>
    </tr></tbody></table>
    <p><strong dir="auto">INV-000001</strong> · <time dir="auto"><date></time></p>
    <table role="presentation" width="100%"><tbody><tr>
      <td lang="en" dir="ltr">Seller / البائع<br><strong dir="auto">Hello Trading LLC</strong><br>TRN / الرقم الضريبي: 100123456700003<br>Dubai</td>
      <td lang="en" dir="ltr">Buyer / المشتري<br><strong dir="auto">sara</strong><br></td>
    </tr></tbody></table>
    <table id="tax-lines" width="100%">
      <thead><tr><th>Description / الوصف</th><th>Qty / الكمية</th><th>Net AED / الصافي</th><th>VAT rate / نسبة الضريبة</th><th>VAT AED / الضريبة</th></tr></thead>
      <tbody><tr><td dir="auto">Invoice in_rtl</td><td dir="auto">1</td><td dir="auto">1,234.56</td><td dir="auto">standard</td><td dir="auto">61.73</td></tr></tbody>
    </table>
    <table id="tax-totals">
      <tbody><tr><td>Standard rated 5 % / خاضع بنسبة 5 %</td><td dir="auto">1,234.56</td></tr>
      <tr><td>Zero rated / بنسبة صفر</td><td dir="auto">0.00</td></tr>
      <tr><td>Exempt / معفى</td><td dir="auto">0.00</td></tr>
      <tr><td>VAT / ضريبة القيمة المضافة</td><td dir="auto">61.73</td></tr>
      <tr><td><strong>Total AED / الإجمالي بالدرهم</strong></td><td><strong dir="auto">1,296.29</strong></td></tr>
    </tbody></table>
  </article>
  <form method="post" action="?/pdf" hx-post="?/pdf"><input type="hidden" name="_csrf" value="<csrf>"><button type="submit">PDF</button></form>
</main>


</body></html>"
`;

