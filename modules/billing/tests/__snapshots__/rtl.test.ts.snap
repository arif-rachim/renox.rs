exports[`billing in both directions every page in en (ltr) and ar (rtl), snapshotted, no English left: role: pending en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Your order</title>
</head>
<body class="renox-billing">
  <main>
  
  <h1>Your order</h1>
  <p dir="auto">Invoice: <code dir="auto">o-rtl</code> · Amount: AED 1250.50</p>
  
  <section id="billing-bank">
    <h2>Pay by bank transfer</h2>
    <dl>
      <dt>Reference to quote</dt><dd><strong><code dir="auto"><reference></code></strong></dd>
      <dt>Beneficiary</dt><dd dir="auto">Example Shop LLC</dd>
      <dt>Bank</dt><dd dir="auto">Example Bank</dd>
      <dt>IBAN</dt><dd><code dir="ltr">AE070331234567890123456</code></dd>
    </dl>
    <p>Quote the reference exactly in the transfer&#39;s description; the order is confirmed when the transfer reaches the account.</p>
  </section>
  
</main>


</body></html>"
`;

