exports[`billing in both directions every page in en (ltr) and ar (rtl), snapshotted, no English left: role: import en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Bank statement import</title>
</head>
<body class="renox-billing">
  <main>
  
  <h1>Bank statement import</h1>
  <form method="post" action="?/import" hx-post="?/import"><input type="hidden" name="_csrf" value="<csrf>">
    <label>Paste the statement (CSV with date, amount, description)<br><textarea name="statement" rows="12" cols="80" dir="ltr" required></textarea></label>
    <button type="submit">Match transfers</button>
  </form>
  <ul class="problem"></ul>
  
</main>


</body></html>"
`;

