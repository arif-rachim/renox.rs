exports[`billing in both directions every page in en (ltr) and ar (rtl), snapshotted, no English left: role: plans en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Billing</title>
</head>
<body class="renox-billing">
  <main>
  
  <h1>Billing</h1>
  <section id="billing-plans">
    <h2>Plans</h2>
    <ul>
      <li dir="auto">
        <strong dir="auto">Pro</strong> AED 299.00 <span>per month</span>
        <form method="post" action="?/subscribe" hx-post="?/subscribe" class="inline"><input type="hidden" name="_csrf" value="<csrf>"><input type="hidden" name="plan_id" value="pro"><button type="submit">Subscribe</button></form>
      </li>
    </ul>
  </section>
  <section id="billing-mine">
    <h2>Your subscription</h2>
    
    <p>You have no subscription.</p>
  </section>
  <section id="billing-invoices">
    <h2>Invoices</h2>
    <table>
      <thead><tr><th>Invoice</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead>
      <tbody>
        <tr><td colspan="4">No invoices.</td></tr>
      </tbody>
    </table>
    
  </section>
</main>


</body></html>"
`;

