// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`notifications unread count, the badge in the header, mark read over the page (the badge follows live): role: list en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Notifications</title>
</head>
<body class="renox-notifications">
  <main>
  
  <div hx-ext="sse" sse-connect="/notifications/sse/notifications">
    <h1>Notifications <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">1</span></h1>
    
    <p><a href="/notifications/prefs">Preferences</a></p>
    <form method="post" action="?/all" hx-post="?/all"><input type="hidden" name="_csrf" value="<csrf>"><button type="submit">Mark all read</button></form>
    <ul id="notif-list" sse-swap="notif-item" hx-swap="afterbegin">
      <li class="renox-notif-item" id="notif-<ntf>">
        <a href="/orders/42"><strong dir="auto">Order #42 shipped</strong></a>
        <p dir="auto">On its way</p>
        <form method="post" action="?/read" hx-post="?/read"><input type="hidden" name="_csrf" value="<csrf>"><input type="hidden" name="id" value="<ntf>"><button type="submit">Mark read</button></form>
      </li>
    </ul>
  </div>
</main>


</body></html>"
`;

exports[`notifications prefs stop a channel: whatsapp off for orders, then in-app off too: role: prefs en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Notification preferences</title>
</head>
<body class="renox-notifications">
  <main>
  
  <h1>Notification preferences</h1>
  
  <ul id="prefs">
    <li>
      <code dir="auto">orders</code> · in the app ·
      on
      <form method="post" action="?/set" hx-post="?/set"><input type="hidden" name="_csrf" value="<csrf>">
        <input type="hidden" name="category" value="orders">
        <input type="hidden" name="channel" value="inapp">
        <input type="hidden" name="enabled" value="0">
        <button type="submit">Turn off</button>
      </form>
    </li><li>
      <code dir="auto">orders</code> · WhatsApp ·
      on
      <form method="post" action="?/set" hx-post="?/set"><input type="hidden" name="_csrf" value="<csrf>">
        <input type="hidden" name="category" value="orders">
        <input type="hidden" name="channel" value="whatsapp">
        <input type="hidden" name="enabled" value="0">
        <button type="submit">Turn off</button>
      </form>
    </li>
  </ul>
  <p><a href="/notifications">Back to notifications</a></p>
</main>


</body></html>"
`;

exports[`notifications Arabic: lang=ar, dir=rtl, the Arabic catalog: role: list ar 1`] = `
"<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>الإشعارات</title>
</head>
<body class="renox-notifications">
  <main>
  
  <div hx-ext="sse" sse-connect="/notifications/sse/notifications">
    <h1>الإشعارات <span id="notif-count" class="renox-notif-count" sse-swap="notif-badge" hx-swap="outerHTML" dir="auto">2</span></h1>
    
    <p><a href="/notifications/prefs">التفضيلات</a></p>
    <form method="post" action="?/all" hx-post="?/all"><input type="hidden" name="_csrf" value="<csrf>"><button type="submit">تعليم الكل كمقروء</button></form>
    <ul id="notif-list" sse-swap="notif-item" hx-swap="afterbegin">
      <li class="renox-notif-item" id="notif-<ntf>">
        <strong dir="auto">Invoice ready</strong>
        
        <form method="post" action="?/read" hx-post="?/read"><input type="hidden" name="_csrf" value="<csrf>"><input type="hidden" name="id" value="<ntf>"><button type="submit">تعليم كمقروء</button></form>
      </li><li class="renox-notif-item" id="notif-<ntf>">
        <strong dir="auto">Order #43 shipped</strong>
        
        <form method="post" action="?/read" hx-post="?/read"><input type="hidden" name="_csrf" value="<csrf>"><input type="hidden" name="id" value="<ntf>"><button type="submit">تعليم كمقروء</button></form>
      </li><li class="renox-notif-item" id="notif-<ntf>">
        <a href="/orders/42"><strong dir="auto">Order #42 shipped</strong></a>
        <p dir="auto">On its way</p>
        
      </li>
    </ul>
  </div>
</main>


</body></html>"
`;
