[
  {
    "description": "a user reads their own account",
    "principal": {
      "type": "User",
      "id": "u_alice"
    },
    "action": "user.read",
    "resource": {
      "type": "auth:Account",
      "id": "u_alice"
    },
    "expected": "allow"
  },
  {
    "description": "a user cannot read another account",
    "principal": {
      "type": "User",
      "id": "u_alice"
    },
    "action": "user.read",
    "resource": {
      "type": "auth:Account",
      "id": "u_bob"
    },
    "expected": "deny"
  },
  {
    "description": "a user cannot revoke another user's session",
    "principal": {
      "type": "User",
      "id": "u_alice"
    },
    "action": "session.revoke",
    "resource": {
      "type": "auth:Session",
      "id": "s_bob",
      "user_id": "u_bob"
    },
    "expected": "deny"
  },
  {
    "description": "a user updates their own account",
    "principal": {
      "type": "User",
      "id": "u_alice"
    },
    "action": "user.update_self",
    "resource": {
      "type": "auth:Account",
      "id": "u_alice"
    },
    "expected": "allow"
  },
  {
    "description": "a user cannot update another account",
    "principal": {
      "type": "User",
      "id": "u_alice"
    },
    "action": "user.update_self",
    "resource": {
      "type": "auth:Account",
      "id": "u_bob"
    },
    "expected": "deny"
  },
  {
    "description": "a user revokes their own session",
    "principal": {
      "type": "User",
      "id": "u_alice"
    },
    "action": "session.revoke",
    "resource": {
      "type": "auth:Session",
      "id": "s_alice",
      "user_id": "u_alice"
    },
    "expected": "allow"
  }
]
