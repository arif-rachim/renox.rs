exports[`snapshots per role user: the account page and the header: role: user account 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Your account</title>
</head>
<body class="renox-auth">
  <main>
  
  <h1 dir="auto">Sam</h1>
  <p id="email" dir="auto">sam@example.com</p>
  
  
  <h2>Password</h2>
  <form method="post" action="?/password" hx-post="?/password"><input type="hidden" name="_csrf" value="<csrf>">
    <label>Current password <input type="password" name="current" autocomplete="current-password" required></label>
    <label>New password <input type="password" name="password" autocomplete="new-password" required></label>
    <button type="submit">Change password</button>
  </form>
  <h2>Sessions</h2>
  <ul id="sessions">
    <li dir="auto">
      Other · since <time>
      <strong>(this browser)</strong>
      
    </li>
  </ul>
  
    <h2>Phone</h2>
    
    <form method="post" action="?/phone_send" hx-post="?/phone_send"><input type="hidden" name="_csrf" value="<csrf>">
      <label>Mobile number <input type="tel" name="phone" autocomplete="tel" inputmode="tel" dir="ltr" required></label>
      <button type="submit">Send code</button>
    </form>
    
  
  
    <h2>Passkeys</h2>
    <ul id="passkeys">
      <li>No passkey yet.</li>
    </ul>
    <p><a href="passkeys/register">Add a passkey</a></p>
  
  
  <h2>Connected agents</h2>
  <ul id="agents">
    <li>No agent is connected.</li>
  </ul>
  <form method="post" action="?/everywhere" hx-post="?/everywhere"><input type="hidden" name="_csrf" value="<csrf>"><button type="submit">Sign out everywhere</button></form>
  <form method="post" action="?/logout" hx-post="?/logout"><input type="hidden" name="_csrf" value="<csrf>"><button type="submit">Sign out</button></form>
</main>


</body></html>"
`;

exports[`snapshots per role user: the account page and the header: role: user header 1`] = `
"<!DOCTYPE html><html lang="en"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script><title>App</title></head><body><header><span class="renox-user-menu"><a href="/auth/account" dir="auto">Sam</a></span></header><main><h1 id="private" dir="auto">Hello Sam</h1></main>
</body></html>"
`;
