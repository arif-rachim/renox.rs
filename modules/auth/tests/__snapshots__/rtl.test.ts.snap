exports[`every auth page in both directions (#336) en (ltr) and ar (rtl), snapshotted, no English left: role: page passkey login en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in with a passkey</title>
</head>
<body class="renox-auth">
  <main>
  
  <h1>Sign in with a passkey</h1>
  
  <form method="post" action="?/default" hx-post="?/default" id="passkey-form" data-options="{&quot;challenge&quot;:&quot;<random>&quot;,&quot;rpId&quot;:&quot;shop.example&quot;,&quot;userVerification&quot;:&quot;preferred&quot;,&quot;timeout&quot;:300000}"><input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/">
    <input type="hidden" name="credential_id">
    <input type="hidden" name="client_data">
    <input type="hidden" name="authenticator_data">
    <input type="hidden" name="signature">
    <button type="button" id="passkey-go">Use a passkey</button>
  </form>
  <p><a href="../login">Other ways to sign in</a></p>
  <script nonce="<nonce>">
    (() => {
      const form = document.getElementById("passkey-form");
      const b64 = (s) => Uint8Array.from(atob(s.replace(/-/g, "+").replace(/_/g, "/").padEnd(Math.ceil(s.length / 4) * 4, "=")), (c) => c.charCodeAt(0));
      const enc = (buf) => btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\\+/g, "-").replace(/\\//g, "_").replace(/=+$/, "");
      document.getElementById("passkey-go").addEventListener("click", async () => {
        const o = JSON.parse(form.dataset.options);
        const cred = await navigator.credentials.get({ publicKey: { ...o, challenge: b64(o.challenge) } });
        form.credential_id.value = cred.id;
        form.client_data.value = enc(cred.response.clientDataJSON);
        form.authenticator_data.value = enc(cred.response.authenticatorData);
        form.signature.value = enc(cred.response.signature);
        form.submit();
      });
    })();
  </script>
</main>


</body></html>"
`;

