  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Connect an agent</title>
</head>
<body class="renox-auth">
  <main>
  
  
    <h1 id="client" dir="auto">Test Agent</h1>
    <p>This agent asks to act in this app for <strong dir="auto">rtl@example.com</strong>.</p>
    <p id="redirect" dir="auto">After you answer you return to agent.example</p>
    <ul id="scopes">
      <li><code dir="auto">tools:*</code>: every tool of this app, as you</li>
    </ul>
    <form method="post" action="?/allow" hx-post="?/allow"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="client_id" value="<client>"><input type="hidden" name="redirect_uri" value="https://agent.example/callback"><input type="hidden" name="state" value="s1"><input type="hidden" name="code_challenge" value="7w_YNF9DSfIdPf_pRjSq646_kPr-2-o9NAl16JGghdM"><input type="hidden" name="code_challenge_method" value="S256"><input type="hidden" name="scope" value="tools:*"><input type="hidden" name="response_type" value="code">
      <button type="submit" id="allow">Allow</button>
    </form>
    <form method="post" action="?/deny" hx-post="?/deny"><input type="hidden" name="_csrf" value="<csrf>">
      <input type="hidden" name="client_id" value="<client>"><input type="hidden" name="redirect_uri" value="https://agent.example/callback"><input type="hidden" name="state" value="s1"><input type="hidden" name="code_challenge" value="7w_YNF9DSfIdPf_pRjSq646_kPr-2-o9NAl16JGghdM"><input type="hidden" name="code_challenge_method" value="S256"><input type="hidden" name="scope" value="tools:*"><input type="hidden" name="response_type" value="code">
      <button type="submit" id="deny">Deny</button>
    </form>
  
</main>


</body></html>"
`;

