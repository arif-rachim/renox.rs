// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`passkeys register a passkey from the account (a recorded ES256 attestation): role: passkey register 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Add a passkey</title>
</head>
<body class="renox-auth">
  <main>
  
  <h1>Add a passkey</h1>
  
  <form method="post" action="?/default" hx-post="?/default" id="passkey-form" data-options="<options>"><input type="hidden" name="_csrf" value="<csrf>">
    <label>Name <input type="text" name="name" maxlength="60" placeholder="Laptop"></label>
    <input type="hidden" name="client_data">
    <input type="hidden" name="attestation_object">
    <button type="button" id="passkey-go">Create the passkey</button>
  </form>
  <p><a href="../account">Back to your account</a></p>
  <script nonce="<nonce>">
    (() => {
      const form = document.getElementById("passkey-form");
      const b64 = (s) => Uint8Array.from(atob(s.replace(/-/g, "+").replace(/_/g, "/").padEnd(Math.ceil(s.length / 4) * 4, "=")), (c) => c.charCodeAt(0));
      const enc = (buf) => btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\\+/g, "-").replace(/\\//g, "_").replace(/=+$/, "");
      document.getElementById("passkey-go").addEventListener("click", async () => {
        const o = JSON.parse(form.dataset.options);
        const publicKey = { ...o, challenge: b64(o.challenge), user: { ...o.user, id: b64(o.user.id) }, excludeCredentials: o.excludeCredentials.map((c) => ({ ...c, id: b64(c.id) })) };
        const cred = await navigator.credentials.create({ publicKey });
        form.client_data.value = enc(cred.response.clientDataJSON);
        form.attestation_object.value = enc(cred.response.attestationObject);
        form.submit();
      });
    })();
  </script>
</main>


</body></html>"
`;
