// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`phone sign-in sign in with the phone; an unknown phone gets the same answer and no code: role: phone verify 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Enter your code</title>
</head>
<body class="renox-auth">
  <main>
  
  <h1>Enter your code</h1>
  <p class="notice">If this number has an account, a code is on its way.</p>
  
  <form method="post" action="?/default" hx-post="?/default"><input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="phone" value="+971501234567">
    <input type="hidden" name="next" value="/">
    <p dir="ltr">+971501234567</p>
    <label>Code <input type="text" name="code" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" dir="ltr" required></label>
    <button type="submit">Verify</button>
  </form>
  <p><a href="../phone">Use another number or ask for a new code</a></p>
</main>


</body></html>"
`;
