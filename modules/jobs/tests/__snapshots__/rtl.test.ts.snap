// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`jobs in both directions every page in en (ltr) and ar (rtl), snapshotted, no English left: role: jobs en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Jobs</title>
</head>
<body class="renox-jobs">
  <main>
  
  <h1>Jobs</h1>
  
  
  <section id="jobs-scheduled">
    <h2>Scheduled</h2>
    <table>
      <thead><tr><th>Job</th><th>Next run</th><th>Last run</th></tr></thead>
      <tbody>
        <tr><td dir="auto">nightly</td><td><time datetime="<date>" dir="auto"><date></time></td><td><span>-</span></td></tr><tr><td dir="auto">flaky</td><td><time datetime="<date>" dir="auto"><date></time></td><td><span>-</span></td></tr>
      </tbody>
    </table>
  </section>
  <section id="jobs-queued">
    <h2>Queued</h2>
    <table>
      <thead><tr><th>Job</th><th>Due</th><th>Attempts</th><th></th></tr></thead>
      <tbody>
        <tr><td colspan="4">Nothing queued.</td></tr>
      </tbody>
    </table>
  </section>
  <section id="jobs-running">
    <h2>Running</h2>
    <ul>
      <li>Nothing running.</li>
    </ul>
  </section>
  <section id="jobs-dead">
    <h2>Failed (dead letters)</h2>
    <table>
      <thead><tr><th>Job</th><th>Failed</th><th>Attempts</th><th>Last error</th><th></th></tr></thead>
      <tbody>
        <tr><td colspan="5">No failed runs.</td></tr>
      </tbody>
    </table>
  </section>
</main>


</body></html>"
`;

exports[`jobs in both directions every page in en (ltr) and ar (rtl), snapshotted, no English left: role: jobs ar 1`] = `
"<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>المهام</title>
</head>
<body class="renox-jobs">
  <main>
  
  <h1>المهام</h1>
  
  
  <section id="jobs-scheduled">
    <h2>المجدولة</h2>
    <table>
      <thead><tr><th>المهمة</th><th>التشغيل التالي</th><th>آخر تشغيل</th></tr></thead>
      <tbody>
        <tr><td dir="auto">nightly</td><td><time datetime="<date>" dir="auto"><date></time></td><td><span>-</span></td></tr><tr><td dir="auto">flaky</td><td><time datetime="<date>" dir="auto"><date></time></td><td><span>-</span></td></tr>
      </tbody>
    </table>
  </section>
  <section id="jobs-queued">
    <h2>في الانتظار</h2>
    <table>
      <thead><tr><th>المهمة</th><th>موعد التشغيل</th><th>المحاولات</th><th></th></tr></thead>
      <tbody>
        <tr><td colspan="4">لا شيء في الانتظار.</td></tr>
      </tbody>
    </table>
  </section>
  <section id="jobs-running">
    <h2>قيد التشغيل</h2>
    <ul>
      <li>لا شيء قيد التشغيل.</li>
    </ul>
  </section>
  <section id="jobs-dead">
    <h2>الفاشلة</h2>
    <table>
      <thead><tr><th>المهمة</th><th>تاريخ الفشل</th><th>المحاولات</th><th>آخر خطأ</th><th></th></tr></thead>
      <tbody>
        <tr><td colspan="5">لا توجد عمليات فاشلة.</td></tr>
      </tbody>
    </table>
  </section>
</main>


</body></html>"
`;
