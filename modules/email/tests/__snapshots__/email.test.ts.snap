exports[`templates: both languages side by side, the recipient's first; values escaped; only safe links (snapshots ltr and rtl): password_reset ltr 1`] = `"<!doctype html><html lang="en" dir="ltr"><body><table role="presentation" width="100%"><tr><td lang="en" dir="ltr" style="vertical-align:top;padding:12px;text-align:left"><p>Hello Sara &lt;b&gt;,</p><p>Someone asked to reset the password of this account. If it was you, choose a new one; the link works once, for 15 minutes. If it was not, ignore this email.</p><p><a href="https://shop.renox.app/auth/reset#token=abc">Choose a new password</a></p></td><td lang="ar" dir="rtl" style="vertical-align:top;padding:12px;text-align:right"><p>مرحبًا Sara &lt;b&gt;،</p><p>طلب أحدهم إعادة تعيين كلمة مرور هذا الحساب. إن كنت أنت، فاختر كلمة جديدة؛ يعمل الرابط مرة واحدة لمدة 15 دقيقة. وإن لم تكن أنت، فتجاهل هذه الرسالة.</p><p><a href="https://shop.renox.app/auth/reset#token=abc">اختيار كلمة مرور جديدة</a></p></td></tr></table></body></html>"`;

