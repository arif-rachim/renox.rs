// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`email in both directions every page in en (ltr) and ar (rtl), snapshotted, no English left: role: log en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Email log</title>
</head>
<body class="renox-email">
  <main>
  
  <h1>Email log</h1>
  
  <table id="email-messages">
    <thead><tr><th>To</th><th>Subject</th><th>Template</th><th>Status</th><th>Attempts</th><th>Queued</th></tr></thead>
    <tbody>
      <tr><td dir="auto">rtl@example.com</td><td dir="auto">Welcome</td><td dir="auto">welcome</td><td dir="auto">failed</td><td dir="auto">1</td><td><time datetime="<date>" dir="auto"><date></time></td></tr><tr><td dir="auto">rtl@example.com</td><td dir="auto">Confirm your email address</td><td dir="auto">verify_email</td><td dir="auto">failed</td><td dir="auto">1</td><td><time datetime="<date>" dir="auto"><date></time></td></tr>
    </tbody>
  </table>
  <h2>Suppressed addresses</h2>
  <table id="email-suppressions">
    <thead><tr><th>To</th><th>Reason</th><th></th></tr></thead>
    <tbody>
      <tr><td colspan="3">No suppressed address.</td></tr>
    </tbody>
  </table>
</main>


</body></html>"
`;

exports[`email in both directions every page in en (ltr) and ar (rtl), snapshotted, no English left: role: log ar 1`] = `
"<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>سجل البريد</title>
</head>
<body class="renox-email">
  <main>
  
  <h1>سجل البريد</h1>
  
  <table id="email-messages">
    <thead><tr><th>إلى</th><th>الموضوع</th><th>القالب</th><th>الحالة</th><th>المحاولات</th><th>وقت الإدراج</th></tr></thead>
    <tbody>
      <tr><td dir="auto">rtl@example.com</td><td dir="auto">Welcome</td><td dir="auto">welcome</td><td dir="auto">failed</td><td dir="auto">1</td><td><time datetime="<date>" dir="auto"><date></time></td></tr><tr><td dir="auto">rtl@example.com</td><td dir="auto">Confirm your email address</td><td dir="auto">verify_email</td><td dir="auto">failed</td><td dir="auto">1</td><td><time datetime="<date>" dir="auto"><date></time></td></tr>
    </tbody>
  </table>
  <h2>العناوين الموقوفة</h2>
  <table id="email-suppressions">
    <thead><tr><th>إلى</th><th>السبب</th><th></th></tr></thead>
    <tbody>
      <tr><td colspan="3">لا يوجد عنوان موقوف.</td></tr>
    </tbody>
  </table>
</main>


</body></html>"
`;
