exports[`org switcher and members page per role: owner, admin, member, non-member: role: switcher owner 1`] = `
"<header><span class="renox-user-menu"><a href="/auth/login">Sign in</a></span><span class="renox-org-switcher">
  <form method="post" action="/org?/switch">
    <input type="hidden" name="_csrf" value="<csrf>">
    <input type="hidden" name="next" value="/">
    <select name="org" aria-label="Organisation">
      <option value="<id>" selected dir="auto">Acme Trading · owner</option><option value="<id>" dir="auto">Bob&#39;s Bakery · member</option>
    </select>
    <button type="submit">Switch</button>
    <a href="/org/members">Members</a>
  </form>
</span></header>"
`;

exports[`org switcher and members page per role: owner, admin, member, non-member: role: members owner 1`] = `
"<!DOCTYPE html><html lang="en"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Acme Trading · Members</title>
</head>
<body class="renox-org">
  <main>
  
  <h1 dir="auto">Acme Trading</h1>
  <p id="role" dir="auto">Your role: owner</p>
  
  
  <h2>Members</h2>
  <ul id="members">
    <li dir="auto">
      Olive &lt;olive@example.com&gt; · owner
      <strong>(you)</strong>
      
    </li><li dir="auto">
      Ann &lt;ann@example.com&gt; · admin
      
      
        <form method="post" action="?/role" hx-post="?/role"><input type="hidden" name="_csrf" value="<csrf>">
          <input type="hidden" name="user" value="<id>">
          <select name="role" aria-label="Role">
            <option value="owner">owner</option>
            <option value="admin" selected>admin</option>
            <option value="member">member</option>
          </select>
          <button type="submit">Change role</button>
        </form>
        <form method="post" action="?/remove" hx-post="?/remove"><input type="hidden" name="_csrf" value="<csrf>"><input type="hidden" name="user" value="<id>"><button type="submit">Remove</button></form>
      
    </li><li dir="auto">
      Mo &lt;mo@example.com&gt; · member
      
      
        <form method="post" action="?/role" hx-post="?/role"><input type="hidden" name="_csrf" value="<csrf>">
          <input type="hidden" name="user" value="<id>">
          <select name="role" aria-label="Role">
            <option value="owner">owner</option>
            <option value="admin">admin</option>
            <option value="member" selected>member</option>
          </select>
          <button type="submit">Change role</button>
        </form>
        <form method="post" action="?/remove" hx-post="?/remove"><input type="hidden" name="_csrf" value="<csrf>"><input type="hidden" name="user" value="<id>"><button type="submit">Remove</button></form>
      
    </li>
  </ul>
  
    <h2>Invitations</h2>
    <ul id="invites">
      <li dir="auto">
        carl@example.com · member
        <form method="post" action="?/revoke" hx-post="?/revoke"><input type="hidden" name="_csrf" value="<csrf>"><input type="hidden" name="invite" value="<id>"><button type="submit">Withdraw</button></form>
      </li>
    </ul>
    <form method="post" action="?/invite" hx-post="?/invite"><input type="hidden" name="_csrf" value="<csrf>">
      <label>Email <input type="email" name="email" required></label>
      <select name="role" aria-label="Role">
        <option value="member">member</option>
        <option value="admin">admin</option>
        <option value="owner">owner</option>
      </select>
      <button type="submit">Invite</button>
    </form>
  
  <form method="post" action="?/leave" hx-post="?/leave"><input type="hidden" name="_csrf" value="<csrf>"><button type="submit" dir="auto">Leave Acme Trading</button></form>
</main>


</body></html>"
`;

