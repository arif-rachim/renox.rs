exports[`org switcher and members page per role: owner, admin, member, non-member: role: orgs non-member 1`] = `
"<!DOCTYPE html><html lang="en"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Your organisations</title>
</head>
<body class="renox-org">
  <main>
  
  <h1>Your organisations</h1>
  
  <p>You are not a member of an organisation yet.</p>
  <h2>Create an organisation</h2>
  <form method="post" action="?/create" hx-post="?/create"><input type="hidden" name="_csrf" value="<csrf>">
    <label>Name <input name="name" value="" maxlength="100" required dir="auto"></label>
    <label>Address (optional) <input name="slug" maxlength="50" pattern="[a-z0-9-]+"></label>
    <button type="submit">Create</button>
  </form>
</main>


</body></html>"
`;
