exports[`booking in both directions every page in en (ltr) and ar (rtl), snapshotted, no English left: role: calendar en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Calendar</title>
</head>
<body class="renox-booking">
  <main>
  
  <h1 dir="auto">Calendar · Sara · <time datetime="<date>" dir="auto"><date></time></h1>
  <nav class="booking-days">
    <a href="?day=<date>" rel="prev"><span class="i18n-mirror" aria-hidden="true">←</span> Previous day</a>
    <a href="?day=<date>" rel="next">Next day <span class="i18n-mirror" aria-hidden="true">→</span></a>
  </nav>
  <ul id="booking-calendar" hx-ext="sse" sse-connect="sse/calendar" hx-trigger="sse:change" hx-get="" hx-select="#booking-calendar" hx-swap="outerHTML">
    <li dir="auto">09:00 · Haircut · held</li>
  </ul>
</main>


</body></html>"
`;

