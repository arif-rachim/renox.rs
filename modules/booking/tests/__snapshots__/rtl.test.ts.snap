exports[`booking in both directions every page in en (ltr) and ar (rtl), snapshotted, no English left: role: slots en 1`] = `
"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta name="renox-request-id" content="<request-id>"><meta name="renox-deployment" content="<deployment>"><script nonce="<nonce>" src="/__renox/client.js?v=<version>"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Book an appointment</title>
</head>
<body class="renox-booking">
  <main>
  
  <h1>Book an appointment</h1>
  <ul id="booking-services">
    <li dir="auto"><a href="?service=color&amp;day=<date>" dir="auto">Colour</a> · 60 min<span dir="auto"> · deposit AED 25.05</span></li><li dir="auto"><a href="?service=cut&amp;day=<date>" dir="auto">Haircut</a> · 30 min</li>
  </ul>
  <section id="booking-slots">
    <form method="get"><input type="hidden" name="service" value="cut"><label>Day <input type="date" name="day" value="<date>"></label><button type="submit">Show</button></form>
    <ul>
      <li><form method="post" action="?/hold" hx-post="?/hold" class="inline"><input type="hidden" name="_csrf" value="<csrf>"><input type="hidden" name="service" value="cut"><input type="hidden" name="staff" value="sara"><input type="hidden" name="start" value="<time>"><button type="submit" dir="auto">09:30 · Sara</button></form></li>
    </ul>
  </section>
  <p><a href="mine">My bookings</a></p>
</main>


</body></html>"
`;

