{
  "uid": "renox-node",
  "title": "Renox \u00b7 Node",
  "tags": [
    "renox",
    "node"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "renox-prometheus"
        },
        "query": {
          "query": "label_values(renox_cp_node_healthy, node_id)",
          "refId": "V"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Healthy (control plane)",
      "datasource": {
        "type": "prometheus",
        "uid": "renox-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "renox-prometheus"
          },
          "expr": "renox_cp_node_healthy{node_id=\"$node\"}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Heartbeat age",
      "datasource": {
        "type": "prometheus",
        "uid": "renox-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "renox-prometheus"
          },
          "expr": "renox_cp_node_heartbeat_age_seconds{node_id=\"$node\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cells / capacity",
      "datasource": {
        "type": "prometheus",
        "uid": "renox-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "renox-prometheus"
          },
          "expr": "renox_cp_node_cells{node_id=\"$node\"}",
          "legendFormat": "cells"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "renox-prometheus"
          },
          "expr": "renox_cp_node_max_cells{node_id=\"$node\"}",
          "legendFormat": "capacity"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests per second by status",
      "datasource": {
        "type": "prometheus",
        "uid": "renox-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "renox-prometheus"
          },
          "expr": "sum by (status_class) (rate(renox_worker_requests_total{instance=\"$node\"}[5m]))",
          "legendFormat": "{{status_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latency p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "renox-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "renox-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(renox_worker_request_duration_seconds_bucket{instance=\"$node\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "renox-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(renox_worker_request_duration_seconds_bucket{instance=\"$node\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU seconds per second",
      "datasource": {
        "type": "prometheus",
        "uid": "renox-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "renox-prometheus"
          },
          "expr": "sum(rate(renox_worker_cpu_seconds_total{instance=\"$node\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Isolate heap",
      "datasource": {
        "type": "prometheus",
        "uid": "renox-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "renox-prometheus"
          },
          "expr": "sum(renox_worker_heap_bytes{instance=\"$node\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Cold starts p95",
      "datasource": {
        "type": "prometheus",
        "uid": "renox-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "renox-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(renox_worker_cold_start_duration_seconds_bucket{instance=\"$node\"}[15m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Disk used / level",
      "datasource": {
        "type": "prometheus",
        "uid": "renox-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "renox-prometheus"
          },
          "expr": "renox_worker_disk_used_ratio{instance=\"$node\"}",
          "legendFormat": "used ratio"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "renox-prometheus"
          },
          "expr": "renox_worker_disk_level{instance=\"$node\"}",
          "legendFormat": "level (0 ok, 1 warn, 2 no new cells, 3 no writes)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Sandbox denials (5 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "renox-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "renox-prometheus"
          },
          "expr": "sum by (kind) (increase(renox_worker_sandbox_denials_total{instance=\"$node\"}[5m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Process tier restarts (1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "renox-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 20,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "renox-prometheus"
          },
          "expr": "sum(increase(renox_worker_process_restarts_total{instance=\"$node\"}[1h]))"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Log lines sampled out (1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "renox-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "renox-prometheus"
          },
          "expr": "sum(increase(renox_worker_log_lines_sampled_out_total{instance=\"$node\"}[1h]))"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Damaged files being restored",
      "datasource": {
        "type": "prometheus",
        "uid": "renox-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "renox-prometheus"
          },
          "expr": "renox_worker_db_unavailable{instance=\"$node\"}"
        }
      ]
    }
  ]
}
