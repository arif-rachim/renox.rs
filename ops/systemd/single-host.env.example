# /etc/renox/single-host.env (#366): settings of the single host's timers that
# are not secrets. root, 0644. The secrets they use are separate root-only
# files under /etc/renox/secrets/ (ops/single-host.md).

# The tenant app domain whose wildcard certificate renox-cert-renew.service keeps.
RENOX_APP_DOMAIN=renoxium.app
# The Let's Encrypt account's address (expiry notices).
RENOX_ACME_EMAIL=ops@renoxium.com
