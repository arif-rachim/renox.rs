# Nightly dump of the control database (#366, #517, ops/scripts/backup-control-db.sh).
# Runs as root, which pg_dump never is: the script drops to `postgres` for the
# dump itself (--pg-user, peer authentication on the local socket) and keeps the
# result root-owned 0600 under /var/backups/renox/control-db. Without R2_ENDPOINT
# in /etc/renox/secrets/r2-backup.env it writes that local copy (14 days); with
# it, it encrypts to /etc/renox/backup-age.pub and uploads to R2 as before
# (ops/single-host.md "Backups"). Started by renox-backup-db.timer.
[Unit]
Description=Back up the control database (local, or to R2 when configured)
Documentation=https://github.com/arif-rachim/renox.rs/blob/main/ops/single-host.md
After=network-online.target postgresql.service
Wants=network-online.target
# #450: a failed nightly backup reaches the operator (ops/systemd/renox-alert@.service).
OnFailure=renox-alert@%n.service

[Service]
Type=oneshot
ExecStart=/opt/renox/bin/backup-control-db.sh --database renox --pg-user postgres --recipients /etc/renox/backup-age.pub --r2-env /etc/renox/secrets/r2-backup.env
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/renox
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# setpriv to postgres needs setuid and setgid; nothing else.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
UMask=0077
