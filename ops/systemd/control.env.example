# /etc/renox/control.env: the EnvironmentFile of renox-control.service on the
# single host (#366, ops/single-host.md "Control plane"). Install it as root,
# mode 0600: it holds secrets, systemd reads it as root, and the service user
# cannot read the file. Never commit a filled-in copy, and never paste one
# into an issue, a PR or a chat. Every key is described in control/api/README.md.
#
# Values in @…@ are placeholders the runbook tells you how to make.

# --- Listeners (#366 scope 2) ---------------------------------------------
# The public listener, reached only through cloudflared (renox-tunnel.service).
CONTROL_LISTEN_HOST=127.0.0.1
CONTROL_LISTEN_PORT=8787
# The node listener, reached only by the worker on this host.
CONTROL_NODE_LISTEN_HOST=127.0.0.1
CONTROL_NODE_LISTEN_PORT=8788
# cloudflared connects from loopback and sets CF-Connecting-IP (#366 scope 1).
CONTROL_TRUSTED_PROXIES=127.0.0.1,::1
CONTROL_CLIENT_IP_HEADER=CF-Connecting-IP

# --- Database -------------------------------------------------------------
# The distribution's Postgres on 127.0.0.1 (scram-sha-256). The password is
# generated once: openssl rand -hex 24
CONTROL_DATABASE_URL=postgres://renox_control:@DB_PASSWORD@@127.0.0.1:5432/renox

# --- Secrets ----------------------------------------------------------------
# 32 random bytes, base64 (head -c 32 /dev/urandom | base64). Losing it loses
# every tenant secret: keep the offline copy of ops/security/keys.md.
CONTROL_MASTER_KEY=@MASTER_KEY@
# SHA-256 hex of the operator token (the token itself stays with the operator).
CONTROL_OPERATOR_TOKEN_SHA256=@OPERATOR_TOKEN_SHA256@

# --- Domains (#363, #364) ---------------------------------------------------
CONTROL_PLATFORM_DOMAIN=renoxium.app
CONTROL_DASHBOARD_URL=https://dashboard.renoxium.com
CONTROL_API_URL=https://api.renoxium.com
CONTROL_SECURITY_CONTACTS=mailto:security@renoxium.com
CONTROL_ABUSE_CONTACT=abuse@renoxium.com
# Custom domains point their CNAME at edge.renoxium.app, which resolves to this host.
CONTROL_EDGE_HOSTNAME=edge.renoxium.app
CONTROL_EDGE_ADDRESSES=@NODE_PUBLIC_IPV4@
CONTROL_ACME_EMAIL=ops@renoxium.com

# --- Artifact store: an R2 bucket of its own (S3 API, region auto) ---------
CONTROL_S3_ENDPOINT=https://@R2_ACCOUNT_ID@.r2.cloudflarestorage.com
CONTROL_S3_BUCKET=renoxium-artifacts
CONTROL_S3_REGION=auto
CONTROL_S3_ACCESS_KEY_ID=@R2_ARTIFACTS_KEY_ID@
CONTROL_S3_SECRET_ACCESS_KEY=@R2_ARTIFACTS_SECRET@

# --- Sign-up friction (#123) -------------------------------------------------
# RENOX_CAPTCHA_SECRET=@CAPTCHA_SECRET@
# RENOX_SAFE_BROWSING_KEY=@SAFE_BROWSING_KEY@
