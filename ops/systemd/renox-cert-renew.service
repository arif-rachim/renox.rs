# Renews the wildcard certificate of the tenant app domain (#366,
# ops/scripts/renew-wildcard-cert.sh): *.renoxium.app and renoxium.app by
# DNS-01 with lego's Cloudflare provider, then `systemctl reload
# renox-worker` (SIGHUP) when the worker is active; before the worker first
# starts, the certificate is only installed (#399). Started by
# renox-cert-renew.timer.
# The Cloudflare API token (Zone:DNS:Edit on the one zone) stays in a
# root-only file and reaches the script through LoadCredential (%d).
[Unit]
Description=Renew the wildcard certificate of the tenant app domain
Documentation=https://github.com/arif-rachim/renox.rs/blob/main/ops/single-host.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# /etc/renox/single-host.env: RENOX_APP_DOMAIN, RENOX_ACME_EMAIL (no secret).
EnvironmentFile=/etc/renox/single-host.env
LoadCredential=cloudflare-dns.token:/etc/renox/secrets/cloudflare-dns.token
ExecStart=/opt/renox/bin/renew-wildcard-cert.sh --domain ${RENOX_APP_DOMAIN} --email ${RENOX_ACME_EMAIL} --token-file %d/cloudflare-dns.token --lego-path /var/lib/renox-acme
StateDirectory=renox-acme
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
# Writes only the worker's certificate directory and lego's state.
ReadWritePaths=/var/lib/renox/data/_certs
