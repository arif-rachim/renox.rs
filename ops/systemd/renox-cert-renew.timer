# Daily check of the wildcard certificate (#366); lego renews when fewer than
# 30 days are left, so a failed day has a month of retries before expiry.
[Unit]
Description=Daily renewal check of the wildcard certificate

[Timer]
OnCalendar=*-*-* 03:41:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
