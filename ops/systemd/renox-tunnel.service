# Cloudflare Tunnel, the single host's only way in (#366, #420, ADR D25;
# ops/single-host.md): api.renoxium.com and mcp.renoxium.com -> the control
# API on 127.0.0.1:8787, every app name and custom domain -> the worker's
# socket unix:/run/renox-edge/worker.sock (ops/cloudflared/config.yml.example).
# Outbound only. It runs as renox-tunnel, a static user in the group
# renox-edge: the group lets it open the socket, and its uid is the one peer
# the worker trusts to name the client in CF-Connecting-IP ([gateway]
# trusted_socket_users, #414). The tunnel credentials stay in a root-only
# file; systemd hands a copy to this unit through LoadCredential (%d), never
# in the environment or on a command line anyone else can read.
[Unit]
Description=Renoxium control API tunnel (cloudflared)
Documentation=https://github.com/arif-rachim/renox.rs/blob/main/ops/single-host.md
After=network-online.target renox-control.service renox-worker.service
Wants=network-online.target

[Service]
Type=notify
User=renox-tunnel
Group=renox-edge
DynamicUser=no
ExecStart=/opt/renox/bin/cloudflared --no-autoupdate --config %d/config.yml tunnel run --credentials-file %d/credentials.json
# /etc/renox is root:renox 0750, which renox-tunnel cannot traverse: both
# files reach it as credentials (read by systemd as root, readable by the
# unit's user only).
LoadCredential=config.yml:/etc/renox/tunnel/config.yml
LoadCredential=credentials.json:/etc/renox/tunnel/credentials.json
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
