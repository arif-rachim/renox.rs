# The billing rollup (#450, control/billing): one pass of `src/main.ts
# --once` turns meters_raw into meters_hourly (the last 48 hours and the
# current one, idempotent) and logs the tenants over quota. Usage, quotas,
# the tier machine and invoices read meters_hourly, so without this unit they
# all see zero. Started every hour by renox-billing.timer; same user, code
# and settings as renox-control.service (CONTROL_DATABASE_URL in
# /etc/renox/control.env, read by systemd as root).
[Unit]
Description=Renoxium billing rollup (meters_raw to meters_hourly)
Documentation=https://github.com/arif-rachim/renox.rs/blob/main/ops/single-host.md
After=network-online.target postgresql.service renox-control.service
Wants=network-online.target
OnFailure=renox-alert@%n.service

[Service]
Type=oneshot
User=renox-control
Group=renox-control
EnvironmentFile=/etc/renox/control.env
Environment=HOME=/var/lib/renox-control
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
WorkingDirectory=/opt/renox/src/control/billing
ExecStart=/opt/renox/bin/bun /opt/renox/src/control/billing/src/main.ts --once
TimeoutStartSec=15min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadOnlyPaths=/opt/renox/src
MemoryMax=512M
TasksMax=64
