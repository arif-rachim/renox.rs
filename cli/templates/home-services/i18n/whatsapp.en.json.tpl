{
  "quote_sent": {
    "template": "quote_sent",
    "subject": "Your quotation {number}",
    "body": "Hello {name}, your quotation {number} is ready. Review and approve it here: {link}"
  },
  "visit_scheduled": {
    "template": "visit_scheduled",
    "subject": "Your visit {job} is scheduled",
    "body": "Hello {name}, your visit {job} is scheduled for {when} with {technician}. Reply CANCEL or RESCHEDULE if the time does not suit you."
  },
  "technician_on_the_way": {
    "template": "technician_on_the_way",
    "subject": "{technician} is on the way",
    "body": "Hello {name}, {technician} is on the way for visit {job}."
  },
  "report_ready": {
    "template": "report_ready",
    "subject": "The report of visit {job} is ready",
    "body": "Hello {name}, the report of visit {job} is ready: {link}"
  },
  "invoice_due": {
    "template": "invoice_due",
    "subject": "Tax invoice {number} from {brand}",
    "body": "Hello {name}, your tax invoice {number} for {amount} is ready: {link}"
  },
  "amc_renewal": {
    "template": "amc_renewal",
    "subject": "Your maintenance contract {number} ends on {ends}",
    "body": "Hello {name}, your maintenance contract {number} ends on {ends}. Reply to this message and we will renew it for you."
  },
  "booking_received": {
    "template": "booking_received",
    "subject": "We received your booking {job}",
    "body": "Hello {name}, we received your booking {job} for {when}. We will confirm it shortly."
  },
  "visit_moved": {
    "template": "visit_moved",
    "subject": "Your visit {job} is moved",
    "body": "Hello {name}, your visit {job} is now on {when}."
  },
  "visit_cancelled": {
    "template": "visit_cancelled",
    "subject": "Your visit {job} is cancelled",
    "body": "Hello {name}, your visit {job} is cancelled."
  }
}
