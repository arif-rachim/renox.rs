 "scripts": {
  "rss.ts": "// #343: per-isolate RSS outside the V8 heap. For each variant (an env for\n// the worker), RUNS times: start a worker with N tenants of APP, read\n// /proc/<pid>/smaps_rollup before and after one request per tenant, and\n// report (after - before) / N per field, the median over the runs.\n// usage: bun rss.ts <out.json>   env: APP (shop), N (100), RUNS (3), VARIANTS (comma list of names below)\nimport { writeFileSync, readFileSync } from \"node:fs\";\nimport { Worker, sleep } from \"/home/claude/app/renox-f245/bench/scenarios/B11/harness.ts\";\n\nconst out = process.argv[2]!;\nconst app = process.env.APP ?? \"shop\";\nconst n = Number(process.env.N ?? 100);\nconst runs = Number(process.env.RUNS ?? 3);\nconst PATH: Record<string, string> = { shop: \"/api/products\", hello: \"/api/hello\" };\nconst ALL: Record<string, Record<string, string>> = {\n  default: {},\n  arena2: { MALLOC_ARENA_MAX: \"2\" },\n  arena1: { MALLOC_ARENA_MAX: \"1\" },\n  arena4: { MALLOC_ARENA_MAX: \"4\" },\n  trim128k: { MALLOC_TRIM_THRESHOLD_: \"131072\", MALLOC_TOP_PAD_: \"0\" },\n  mmap64k: { MALLOC_MMAP_THRESHOLD_: \"65536\" },\n};\nconst variants = (process.env.VARIANTS ?? Object.keys(ALL).join(\",\")).split(\",\");\n\nfunction rollup(pid: number): Record<string, number> {\n  const o: Record<string, number> = {};\n  for (const line of readFileSync(`/proc/${pid}/smaps_rollup`, \"utf8\").split(\"\\n\")) {\n    const m = /^(\\w+):\\s+(\\d+) kB/u.exec(line);\n    if (m) o[m[1]!] = Number(m[2]) / 1024;\n  }\n  return o;\n}\n/** Anonymous mappings of exactly 64 MiB address space (reserved + used): glibc's non-main arenas. */\nfunction arenas(pid: number): number {\n  const lines = readFileSync(`/proc/${pid}/maps`, \"utf8\").split(\"\\n\");\n  const sizes: number[] = [];\n  for (const l of lines) {\n    const m = /^([0-9a-f]+)-([0-9a-f]+) (\\S+) \\S+ \\S+ 0\\s*$/u.exec(l);\n    if (m) sizes.push(Number(BigInt(\"0x\" + m[2]) - BigInt(\"0x\" + m[1])));\n  }\n  // An arena heap is a 64 MiB-aligned region split into rw-p + ---p pieces; count rw-p pieces followed by ---p summing 64 MiB.\n  let count = 0;\n  for (let i = 0; i + 1 < lines.length; i++) {\n    const a = /^([0-9a-f]+)-([0-9a-f]+) rw-p 00000000 00:00 0\\s*$/u.exec(lines[i]!);\n    const b = /^([0-9a-f]+)-([0-9a-f]+) ---p 00000000 00:00 0\\s*$/u.exec(lines[i + 1]!);\n    if (a && b && a[2] === b[1]) {\n      const total = BigInt(\"0x\" + b[2]) - BigInt(\"0x\" + a[1]);\n      if (total === 64n * 1024n * 1024n && BigInt(\"0x\" + a[1]) % (64n * 1024n * 1024n) === 0n) count++;\n    }\n  }\n  return count;\n}\nconst avg = (xs: Record<string, number>[]): Record<string, number> => {\n  const o: Record<string, number> = {};\n  for (const k of Object.keys(xs[0]!)) o[k] = xs.reduce((s, x) => s + (x[k] ?? 0), 0) / xs.length;\n  return o;\n};\nconst median = (xs: number[]): number => [...xs].sort((a, b) => a - b)[Math.floor(xs.length / 2)]!;\n\nconst result: Record<string, unknown> = { app, n, runs, host: readFileSync(\"/proc/sys/kernel/hostname\", \"utf8\").trim() };\nfor (const v of variants) {\n  const saved = { ...process.env };\n  Object.assign(process.env, ALL[v]);\n  const per: Record<string, number>[] = [];\n  try {\n    for (let r = 0; r < runs; r++) {\n      const tenants = Array.from({ length: n }, (_, i) => ({ host: `${app}${i}.bench.test`, tenant: `t_${app}_${i}`, app }));\n      const w = await Worker.start(tenants);\n      try {\n        await sleep(2000);\n        const b: Record<string, number>[] = [];\n        for (let i = 0; i < 3; i++) { b.push(rollup(w.pid)); await sleep(500); }\n        const arenasBefore = arenas(w.pid);\n        for (const t of tenants) {\n          const res = await w.request(t.host, PATH[app]!);\n          if (res.status !== 200) throw new Error(`${app} answered ${res.status}: ${res.body}`);\n        }\n        await sleep(5000);\n        const a: Record<string, number>[] = [];\n        for (let i = 0; i < 5; i++) { a.push(rollup(w.pid)); await sleep(1000); }\n        const B = avg(b), A = avg(a);\n        const d: Record<string, number> = {};\n        for (const k of Object.keys(A)) d[k] = (A[k]! - (B[k] ?? 0)) / n;\n        const heaps = w.meters().map((m) => m.peak_heap_bytes / 1048576).sort((x, y) => x - y);\n        d.v8_heap = heaps[Math.floor(heaps.length / 2)] ?? NaN;\n        d.arenas_before = arenasBefore;\n        d.arenas_after = arenas(w.pid);\n        d.rss_after_total = A.Rss!;\n        per.push(d);\n        console.error(`${v} run ${r + 1}: Rss ${d.Rss!.toFixed(2)} anon ${d.Anonymous!.toFixed(2)} file ${(d.Rss_file ?? 0).toFixed(2)} AnonHuge ${(d.AnonHugePages ?? 0).toFixed(3)} heap ${d.v8_heap.toFixed(2)} arenas ${arenasBefore}->${d.arenas_after}`);\n      } finally {\n        w.stop();\n      }\n    }\n  } finally {\n    for (const k of Object.keys(ALL[v]!)) delete process.env[k];\n    Object.assign(process.env, saved);\n  }\n  const keys = Object.keys(per[0]!);\n  const med: Record<string, number> = {};\n  for (const k of keys) med[k] = Math.round(median(per.map((p) => p[k]!)) * 1000) / 1000;\n  result[v] = { env: ALL[v], median: med, runs: per };\n}\nwriteFileSync(out, JSON.stringify(result, null, 2));\n",
  "regions.ts": "// #343: per-isolate RSS by kind of mapping. Reads /proc/<pid>/smaps before and after one\n// request per tenant (N tenants of APP) and attributes each mapping's Rss to a kind.\n// usage: bun regions.ts <out.json>   env: APP, N\nimport { readFileSync, writeFileSync } from \"node:fs\";\nimport { Worker, sleep } from \"/home/claude/app/renox-f245/bench/scenarios/B11/harness.ts\";\nconst out = process.argv[2]!;\nconst app = process.env.APP ?? \"shop\";\nconst n = Number(process.env.N ?? 100);\nconst PATH: Record<string, string> = { shop: \"/api/products\", hello: \"/api/hello\" };\nconst MB = 1024;\ntype Map = { start: bigint; end: bigint; perms: string; path: string; rss: number; anon: number };\nfunction smaps(pid: number): Map[] {\n  const maps: Map[] = [];\n  let cur: Map | null = null;\n  for (const l of readFileSync(`/proc/${pid}/smaps`, \"utf8\").split(\"\\n\")) {\n    const h = /^([0-9a-f]+)-([0-9a-f]+) (\\S+) \\S+ \\S+ \\S+\\s*(.*)$/u.exec(l);\n    if (h) { cur = { start: BigInt(\"0x\" + h[1]), end: BigInt(\"0x\" + h[2]), perms: h[3]!, path: h[4]!.trim(), rss: 0, anon: 0 }; maps.push(cur); continue; }\n    const r = /^Rss:\\s+(\\d+) kB/u.exec(l); if (r && cur) cur.rss = Number(r[1]);\n    const a = /^Anonymous:\\s+(\\d+) kB/u.exec(l); if (a && cur) cur.anon = Number(a[1]);\n  }\n  return maps;\n}\nconst ARENA = 64n * 1024n * 1024n;\nfunction kinds(maps: Map[]): Record<string, number> {\n  const o: Record<string, number> = {};\n  const add = (k: string, v: number) => (o[k] = (o[k] ?? 0) + v / MB);\n  // glibc arena heaps: a rw-p mapping starting at a 64 MiB boundary, followed by the ---p rest of the 64 MiB.\n  for (let i = 0; i < maps.length; i++) {\n    const m = maps[i]!;\n    const next = maps[i + 1];\n    let k: string;\n    if (m.path === \"[heap]\") k = \"glibc main heap ([heap])\";\n    else if (m.path === \"[stack]\") k = \"main stack\";\n    else if (m.path.startsWith(\"/\")) k = m.path.includes(\"renox-worker\") ? \"worker binary\" : \"shared libraries and files\";\n    else if (m.path !== \"\") k = `other ${m.path}`;\n    else if (m.perms.startsWith(\"rw\") && m.start % ARENA === 0n && next && next.perms === \"---p\" && next.start === m.end && next.end - m.start === ARENA) k = \"glibc arenas\";\n    else if (m.perms === \"rwxp\") k = \"anon rwx (V8 code)\";\n    else if (m.start >= 0x100000000000n && m.start < 0x200000000000n) k = \"V8 pointer cage\";\n    else if (m.perms.startsWith(\"rw\") && i > 0 && maps[i - 1]!.perms === \"---p\" && maps[i - 1]!.end === m.start && Number(m.end - m.start) <= 8 * 1048576 + 65536 && Number(m.end - m.start) >= 1048576) k = \"thread stacks (guard page before)\";\n    else k = \"other anonymous\";\n    add(k, m.rss);\n  }\n  return o;\n}\nconst tenants = Array.from({ length: n }, (_, i) => ({ host: `${app}${i}.bench.test`, tenant: `t_${app}_${i}`, app }));\nconst w = await Worker.start(tenants);\ntry {\n  await sleep(2000);\n  const before = kinds(smaps(w.pid));\n  const threadsBefore = w.threads();\n  for (const t of tenants) {\n    const r = await w.request(t.host, PATH[app]!);\n    if (r.status !== 200) throw new Error(`${r.status} ${r.body}`);\n  }\n  await sleep(5000);\n  const after = kinds(smaps(w.pid));\n  const threadsAfter = w.threads();\n  const per: Record<string, number> = {};\n  for (const k of new Set([...Object.keys(before), ...Object.keys(after)])) per[k] = Math.round((((after[k] ?? 0) - (before[k] ?? 0)) / n) * 1000) / 1000;\n  const total = Object.values(per).reduce((a, b) => a + b, 0);\n  const res = { app, n, per_isolate_mb: per, total_mb: Math.round(total * 1000) / 1000, threads_per_isolate: (threadsAfter - threadsBefore) / n };\n  console.log(JSON.stringify(res, null, 2));\n  writeFileSync(out, JSON.stringify(res, null, 2));\n} finally {\n  w.stop();\n}\n"
 }
