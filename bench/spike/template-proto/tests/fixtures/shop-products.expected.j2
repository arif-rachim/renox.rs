{% extends "layouts/main.html" %}{% block body %}
  <section class="catalog">
    <h1>{{ title }}</h1>
    <form class="search" action="/products" hx-get="/products" hx-target="#product-list" hx-select="#product-list" hx-trigger="input changed delay:300ms from:input[name=q], submit" hx-push-url="true">
      <input type="search" name="q" value="{{ query }}" placeholder="Search products" autocomplete="off">
      <select name="category">
        <option value="">All categories</option>
        {% for c in categories %}<option value="{{ c.slug }}"{% if c.slug == category %} selected{% endif %}>{{ c.name }}</option>{% endfor %}
      </select>
      <button type="submit">Search</button>
    </form>
    {% if products | length > 0 %}<p class="result-count">{{ products | length }} products</p>{% endif %}
    {% block product_list %}<ul id="product-list" class="grid">
      {% for p in products %}<li class="card{% if p.stock == 0 %} card--empty{% endif %}{% if p.featured %} card--featured{% endif %}" data-id="{{ p.id }}">
        <a href="/products/{{ p.slug }}">{{ p.name }}</a>
        {% if p.stock == 0 %}<span class="badge">Out of stock</span>{% else %}<span class="price">{{ p.price | money }}</span>{% endif %}
        <button{% if p.stock == 0 %} disabled{% endif %} hx-post="/cart/add" hx-vals='{"productId": "{{ p.id }}"}'>Add</button>
      </li>{% else %}<li class="empty">No products found</li>{% endfor %}
    </ul>{% endblock %}
  </section>
{% endblock %}