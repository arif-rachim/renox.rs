{
  "name": "renox",
  "version": "0.1.0",
  "description": "Types and helpers for Renox tenant code: ctx (db, fetch, secrets, log, deadline), handlers, errors",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./kysely": {
      "types": "./src/kysely.ts",
      "default": "./src/kysely.ts"
    },
    "./drizzle": {
      "types": "./src/drizzle.ts",
      "default": "./src/drizzle.ts"
    },
    "./fakes": {
      "types": "./src/fakes.ts",
      "default": "./src/fakes.ts"
    },
    "./test": {
      "types": "./src/test.ts",
      "default": "./src/test.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "check": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p client",
    "test": "bun test"
  },
  "devDependencies": {
    "valibot": "1.5.0",
