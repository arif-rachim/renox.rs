{
  "name": "@renoxium/sdk",
  "version": "0.1.7",
  "description": "Types and helpers for Renox tenant code: ctx (db, fetch, secrets, log, deadline), handlers, pages, modules, errors, test fakes",
  "license": "Apache-2.0",
  "homepage": "https://github.com/arif-rachim/renox.rs/tree/main/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arif-rachim/renox.rs.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/arif-rachim/renox.rs/issues"
  },
  "keywords": [
    "renox",
    "renoxium",
    "sdk",
    "hosting",
    "multi-tenant",
    "sqlite",
    "typescript",
    "htmx"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kysely": {
      "types": "./dist/kysely.d.ts",
      "default": "./dist/kysely.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "default": "./dist/drizzle.js"
    },
    "./fakes": {
      "types": "./dist/fakes.d.ts",
      "default": "./dist/fakes.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4",
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "node scripts/prepare.mjs",
    "check": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p client",
    "test": "bun test"
  },
  "devDependencies": {
    "valibot": "1.5.0",
    "zod": "4.6.7",
    "drizzle-orm": "0.45.4",
    "kysely": "0.29.6"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0 <1.0.0",
    "kysely": ">=0.29.0 <0.30.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  }
}
