// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`the fixture manifests produce modules.d.ts (snapshot) 1`] = `
"// Generated by renox (#236) from renox.lock and the module manifests. Do not edit: it is rewritten on every build.
import type { ModuleCtx as ModuleCtxOf, ServicesOf } from "renox";

/** Every installed module, in renox.lock order. */
export interface Modules {
  "auth": {
    services: ServicesOf<typeof import("../../modules/auth/services.ts")>;
    events: {
      "auth.user_registered": {
        user_id: string;
        at: number;
        source?: "password" | "oauth";
      };
    };
    hooks: {
      "auth.after_login": { args: {
          user_id: string;
          [key: string]: unknown;
        }; result: void };
    };
    config: {
      registration: "open" | "invite";
      session_days: number;
      support_email?: string;
    };
  };
  "billing": {
    services: ServicesOf<typeof import("../../modules/billing/services.ts")>;
    events: {
      "billing.invoice_paid": {
        invoice_id: string;
        user_id: string;
        amount?: number;
        [key: string]: unknown;
      };
    };
    hooks: Record<never, never>;
    config: Record<never, never>;
  };
}

export type ModuleName = keyof Modules;

/** The ctx a module's services, hooks and handlers receive; "app" for the app's own code. */
export type ModuleCtx<M extends ModuleName | "app" = "app"> = ModuleCtxOf<Modules, M>;

/** The payload type of an exported event. */
export type EventPayload<M extends ModuleName, E extends keyof Modules[M]["events"]> = Modules[M]["events"][E];
"
`;

exports[`the fixture manifests produce modules.d.ts (snapshot) 2`] = `
"// Generated by renox (#236) from renox.lock and the module manifests. Do not edit: it is rewritten on every build.
// \`import { auth } from "renox:modules"\`: the broker's service proxies (ops.md section 15.2).
declare module "renox:modules" {
  export const auth: import("./modules").Modules["auth"]["services"];
  export const billing: import("./modules").Modules["billing"]["services"];
}
"
`;
