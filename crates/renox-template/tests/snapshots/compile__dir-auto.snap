== pages/index (Page)
<h1 dir="auto">{#@ pages/index:1 #}{{ product.name }}</h1>
<p dir="ltr">{#@ pages/index:2 #}{{ product.sku }}</p>
<p>Static text only</p>
{#@ pages/index:4 #}<input type="text" name="q"{% with __attr = query %}{% if __attr is not false and __attr is not none and __attr is defined %} value="{{ __attr }}"{% endif %}{% endwith %} dir="auto">
{#@ pages/index:5 #}<input type="number" name="n"{% with __attr = count %}{% if __attr is not false and __attr is not none and __attr is defined %} value="{{ __attr }}"{% endif %}{% endwith %}>
<textarea name="note" dir="auto">{#@ pages/index:6 #}{{ note }}</textarea>

