== pages/index (Page)
<dl>
  {#@ pages/index:2 #}{% for item in (specs) | __loop %}
    <dt dir="auto">{#@ pages/index:3 #}{{ item.key }}</dt>
    <dd dir="auto">{#@ pages/index:4 #}{{ item.value }}</dd>
  {% endfor %}
  {#@ pages/index:6 #}{% if warranty %}<dt>Warranty</dt><dd dir="auto">{{ warranty }}</dd>{% endif %}
</dl>

