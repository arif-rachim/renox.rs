== pages/index (Page)
<section>
  <h2>Products</h2>
  {% block product_list %}<ul id="product-list">
    {% for p in (products) | __loop %}<li dir="auto">{{ p.name }}</li>{% endfor %}
  </ul>{% endblock %}
  {% block cart_summary %}{% if cart %}<p dir="auto">{{ cart.total }}</p>{% endif %}{% endblock %}
</section>

