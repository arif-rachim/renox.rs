== pages/index (Page)
<ul>
  {#@ pages/index:2 #}{% for p in (products) | __loop %}<li dir="auto">{#@ pages/index:3 #}
    {{ p.name }}
    {#@ pages/index:4 #}{% if can("cart.add", p) %}<button hx-post="?/addToCart">Add</button>{% endif %}
    {#@ pages/index:5 #}{% if not can("cart.add", p) %}<span>Sign in to buy</span>{% endif %}
  </li>{% endfor %}
</ul>
{#@ pages/index:8 #}{% if can("admin.access", none) %}<a href="/admin">Admin</a>{% endif %}

