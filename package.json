{
  "name": "renox",
  "private": true,
  "workspaces": [
    "sdk*",
    "cli*",
    "control/*",
    "packages/*",
    "modules/*",
    "examples/*",
    "bench*",
    "www"
  ],
  "scripts": {
    "check": "bun run --filter '*' check",
    "test": "bun test --pass-with-no-tests",
    "bump-worker": "bun scripts/release/bump-worker.ts",
    "pin-worker": "bun scripts/release/pin-worker.ts",
    "bump-cli": "bun scripts/release/bump-cli.ts",
    "bump-version": "bun scripts/release/bump-version.ts"
  },
  "devDependencies": {
    "bun-types": "1.4.4",
    "typescript": "7.0.2"
  }
}
