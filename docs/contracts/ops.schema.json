{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renox.dev/contracts/ops/v1.schema.json",
  "title": "Renox runtime ops, contract version 1.3.0",
  "description": "One op call as JSON: {op, args, result} or {op, args, error}; or one page dispatch (ops.md section 14): {dispatch: \"page\", invocation, result}; or, from 1.3.0, the bootstrap init with the module list (section 11, step 3): {dispatch: \"init\", modules}, or one event delivery (section 15.4): {dispatch: \"event\", envelope, result}. bigint and Uint8Array use the $bigint and $bytes encodings. Source of truth for prose: ops.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/call_op_db_query"
    },
    {
      "$ref": "#/$defs/call_op_db_query_one"
    },
    {
      "$ref": "#/$defs/call_op_db_execute"
    },
    {
      "$ref": "#/$defs/call_op_db_tx_begin"
    },
    {
      "$ref": "#/$defs/call_op_db_tx_commit"
    },
    {
      "$ref": "#/$defs/call_op_db_tx_rollback"
    },
    {
      "$ref": "#/$defs/call_op_db_savepoint_begin"
    },
    {
      "$ref": "#/$defs/call_op_db_savepoint_release"
    },
    {
      "$ref": "#/$defs/call_op_db_savepoint_rollback"
    },
    {
      "$ref": "#/$defs/call_op_fetch"
    },
    {
      "$ref": "#/$defs/call_op_fetch_body_read"
    },
    {
      "$ref": "#/$defs/call_op_fetch_body_close"
    },
    {
      "$ref": "#/$defs/call_op_secrets_get_all"
    },
    {
      "$ref": "#/$defs/call_op_log"
    },
    {
      "$ref": "#/$defs/call_op_deadline_remaining_ms"
    },
    {
      "$ref": "#/$defs/call_op_response_write"
    },
    {
      "$ref": "#/$defs/call_op_response_end"
    },
    {
      "$ref": "#/$defs/call_op_events_emit"
    },
    {
      "$ref": "#/$defs/call_op_password_hash"
    },
    {
      "$ref": "#/$defs/call_op_password_verify"
    },
    {
      "$ref": "#/$defs/page_dispatch"
    },
    {
      "$ref": "#/$defs/bootstrap_init"
    },
    {
      "$ref": "#/$defs/event_dispatch"
    }
  ],
  "$defs": {
    "bigint": {
      "type": "object",
      "required": [
        "$bigint"
      ],
      "additionalProperties": false,
      "properties": {
        "$bigint": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        }
      },
      "description": "JSON encoding of a JavaScript bigint (decimal digits)."
    },
    "bytes": {
      "type": "object",
      "required": [
        "$bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "$bytes": {
          "type": "string",
          "contentEncoding": "base64"
        }
      },
      "description": "JSON encoding of a Uint8Array (base64)."
    },
    "param": {
      "description": "ops.md section 1, Parameters. NaN and Infinity cannot appear in JSON; they are rejected at runtime with RENOX_DB_PARAM.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/bigint"
        },
        {
          "$ref": "#/$defs/bytes"
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/bigint"
        },
        {
          "$ref": "#/$defs/bytes"
        }
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    },
    "sql": {
      "type": "string",
      "minLength": 1,
      "maxLength": 102400
    },
    "params": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/param"
      },
      "maxItems": 1000
    },
    "tx": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/txHandle"
        }
      ]
    },
    "txHandle": {
      "type": "integer",
      "minimum": 0
    },
    "header": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "string"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "headers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/header"
      }
    },
    "jsonValue": {},
    "fetchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "url",
        "headers",
        "body",
        "redirect"
      ],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^[A-Z]+$",
          "not": {
            "enum": [
              "CONNECT",
              "TRACE"
            ]
          }
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "headers": {
          "$ref": "#/$defs/headers"
        },
        "body": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bytes"
            }
          ]
        },
        "redirect": {
          "enum": [
            "follow",
            "manual",
            "error"
          ]
        },
        "module": {
          "$ref": "#/$defs/moduleArg"
        }
      }
    },
    "fetchResponseHead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "statusText",
        "headers",
        "url",
        "redirected",
        "body"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "statusText": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/headers"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "redirected": {
          "type": "boolean"
        },
        "body": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        }
      }
    },
    "logLevel": {
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "code",
        "message"
      ],
      "description": "ops.md section 0: the RenoxError every op rejects with.",
      "properties": {
        "name": {
          "type": "string"
        },
        "code": {
          "enum": [
            "RENOX_DB_AUTH",
            "RENOX_DB_BUSY",
            "RENOX_DB_TIMEOUT",
            "RENOX_DB_QUOTA",
            "RENOX_DB_CONSTRAINT",
            "RENOX_DB_SQL",
            "RENOX_DB_PARAM",
            "RENOX_DB_COLUMN_NAME",
            "RENOX_DB_MULTI_STATEMENT",
            "RENOX_DB_RESULT_LIMIT",
            "RENOX_DB_TX_STATE",
            "RENOX_FETCH_BLOCKED",
            "RENOX_FETCH_FAILED",
            "RENOX_FETCH_EGRESS_LIMIT",
            "RENOX_DEADLINE",
            "RENOX_NO_REQUEST",
            "RENOX_SECRETS_CONSUMED",
            "RENOX_MODULE_UNDECLARED",
            "RENOX_MODULE_SERVICE",
            "RENOX_EVENT_PAYLOAD"
          ]
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "RENOX_FETCH_BLOCKED"
              }
            }
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "host",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "reason": {
                    "enum": [
                      "not_allowlisted",
                      "scheme",
                      "port",
                      "blocked_address",
                      "redirect_limit",
                      "method"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "RENOX_FETCH_FAILED"
              }
            }
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "host",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "reason": {
                    "enum": [
                      "dns",
                      "connect",
                      "tls",
                      "reset",
                      "redirect",
                      "concurrency",
                      "headers"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "RENOX_DB_AUTH"
              }
            }
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "table",
                  "action"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "RENOX_MODULE_UNDECLARED"
              }
            }
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "module",
                  "target"
                ],
                "additionalProperties": false,
                "properties": {
                  "module": {
                    "$ref": "#/$defs/moduleName"
                  },
                  "target": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "RENOX_MODULE_SERVICE"
              }
            }
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "module",
                  "cause_code"
                ],
                "additionalProperties": false,
                "properties": {
                  "module": {
                    "$ref": "#/$defs/moduleName"
                  },
                  "service": {
                    "type": "string"
                  },
                  "hook": {
                    "$ref": "#/$defs/dottedName"
                  },
                  "event": {
                    "$ref": "#/$defs/dottedName"
                  },
                  "cause_code": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^RENOX_[A-Z0-9_]+$"
                      }
                    ]
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "service"
                    ]
                  },
                  {
                    "required": [
                      "hook"
                    ]
                  },
                  {
                    "required": [
                      "event"
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "RENOX_EVENT_PAYLOAD"
              }
            }
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "event",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "event": {
                    "type": "string"
                  },
                  "reason": {
                    "enum": [
                      "schema",
                      "not_json",
                      "too_large"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "call_op_db_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "description": "ops.md section 1; the fourth argument (module) is 1.3.0",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "op": {
          "const": "op_db_query"
        },
        "args": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/sql"
            },
            {
              "$ref": "#/$defs/params"
            },
            {
              "$ref": "#/$defs/tx"
            },
            {
              "$ref": "#/$defs/moduleArg"
            }
          ],
          "minItems": 3,
          "maxItems": 4
        },
        "result": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          },
          "maxItems": 10000
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "not": {
        "required": [
          "result",
          "error"
        ]
      }
    },
    "call_op_db_query_one": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "description": "ops.md section 1; the fourth argument (module) is 1.3.0",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "op": {
          "const": "op_db_query_one"
        },
        "args": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/sql"
            },
            {
              "$ref": "#/$defs/params"
            },
            {
              "$ref": "#/$defs/tx"
            },
            {
              "$ref": "#/$defs/moduleArg"
            }
          ],
          "minItems": 3,
          "maxItems": 4
        },
        "result": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/row"
            }
          ]
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "not": {
        "required": [
          "result",
          "error"
        ]
      }
    },
    "call_op_db_execute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "description": "ops.md section 1; the fourth argument (module) is 1.3.0",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "op": {
          "const": "op_db_execute"
        },
        "args": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/sql"
            },
            {
              "$ref": "#/$defs/params"
            },
            {
              "$ref": "#/$defs/tx"
            },
            {
              "$ref": "#/$defs/moduleArg"
            }
          ],
          "minItems": 3,
          "maxItems": 4
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "changes",
            "lastInsertRowid"
          ],
          "properties": {
            "changes": {
              "type": "integer",
              "minimum": 0
            },
            "lastInsertRowid": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/bigint"
                }
              ]
            }
          }
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "not": {
        "required": [
          "result",
          "error"
        ]
      }
    },
    "call_op_db_tx_begin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
