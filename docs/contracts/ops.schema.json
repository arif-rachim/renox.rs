      "properties": {
        "$comment": {
          "type": "string"
        },
        "op": {
          "const": "op_db_tx_commit"
        },
        "args": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/txHandle"
            }
          ],
