{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renox.dev/contracts/deploy-api/v0/control-messages.schema.json",
  "title": "Renox control-plane <-> worker messages, deploy API contract version 0",
  "description": "Every JSON document a worker node and the control plane exchange: registration, heartbeat, the route table (snapshot and deltas), activation (prepare), secret and certificate bundles, certificate push, log batches, and from 0.3 the node listener messages (restore, replication status, drop, import, move). Meter batches are meter-record.schema.json. Prose: docs/contracts/deploy-api.md sections 7-10. Each message carries `type` and `schema_version`; a receiver rejects a schema_version it does not know.",
  "oneOf": [
    { "$ref": "#/$defs/node_register" },
    { "$ref": "#/$defs/node_registered" },
    { "$ref": "#/$defs/heartbeat" },
    { "$ref": "#/$defs/heartbeat_ack" },
    { "$ref": "#/$defs/route_snapshot" },
    { "$ref": "#/$defs/route_delta" },
    { "$ref": "#/$defs/resync" },
    { "$ref": "#/$defs/prepare" },
    { "$ref": "#/$defs/prepare_result" },
    { "$ref": "#/$defs/secrets_bundle" },
    { "$ref": "#/$defs/certificate_update" },
    { "$ref": "#/$defs/certificate_remove" },
    { "$ref": "#/$defs/certificate_bundle" },
    { "$ref": "#/$defs/log_batch" },
    { "$ref": "#/$defs/restore_request" },
    { "$ref": "#/$defs/restore_result" },
    { "$ref": "#/$defs/replication_status" },
    { "$ref": "#/$defs/tenant_dropped" },
    { "$ref": "#/$defs/import_result" },
    { "$ref": "#/$defs/move_request" },
    { "$ref": "#/$defs/move_result" }
  ],
  "$defs": {
    "schema_version": { "const": 0 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tenant_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
    "app": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,49}$" },
    "node_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$" },
    "hostname": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "unix_ms": { "type": "integer", "minimum": 0, "description": "Unix time in milliseconds." },
    "route_version": {
      "type": "integer",
      "minimum": 0,
      "description": "Route table version: one sequence for the whole control plane, incremented by every change. 0 = the empty table."
    },
    "tier": { "enum": ["free", "paid"] },
    "secret_name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "activation_id": { "type": "string", "pattern": "^act_[0-9A-Za-z]{16,32}$" },
    "activation_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "reason"],
      "description": "Why an activation failed (deploy-api.md section 6). Never contains a node path, an internal address, or a secret value.",
      "properties": {
        "stage": { "enum": ["no_worker", "fetch", "load", "migrate", "probe", "timeout"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "module": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "file": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}/[0-9]{3}_[a-z0-9_]{1,64}\\.sql$" },
        "sqlite_error": { "type": "string", "maxLength": 1024 },
        "http_status": { "type": "integer", "minimum": 100, "maximum": 599 }
      }
    },
    "route_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "tenant_id",
        "app",
        "deployment_hash",
        "status",
        "updated_at",
        "version",
        "tier",
        "node_id",
        "secrets_version"
      ],
      "description": "artifact.md section 5 route-table entry plus the F3 fields: version (#97), app, tier, node_id (tenant assignment), secrets_version; and from 0.3 the optional process (#254) and database (section 14).",
      "properties": {
        "hostname": { "$ref": "#/$defs/hostname" },
        "tenant_id": { "$ref": "#/$defs/tenant_id" },
        "app": { "$ref": "#/$defs/app" },
        "deployment_hash": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["active", "draining"] },
        "updated_at": { "$ref": "#/$defs/unix_ms" },
        "version": { "$ref": "#/$defs/route_version" },
        "tier": { "$ref": "#/$defs/tier" },
        "node_id": { "$ref": "#/$defs/node_id" },
        "secrets_version": {
          "type": "integer",
          "minimum": 0,
          "description": "The app's secret-set version pinned by this deployment. 0 = no secrets set."
        },
        "process": {
          "enum": ["shared", "own"],
          "description": "0.3: shared = the tenant's cells run in the node's shared worker process; own = in a child process of the tenant's own (#254). Missing means shared."
        },
        "database": {
          "$ref": "#/$defs/database_id",
          "description": "0.3: the tenant file the entry's cells open. Missing means the tenant's own file (database = tenant_id)."
        }
      }
    },
    "route_removal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "deployment_hash", "version"],
      "properties": {
        "hostname": { "$ref": "#/$defs/hostname" },
        "deployment_hash": { "$ref": "#/$defs/sha256" },
        "version": { "$ref": "#/$defs/route_version" }
      }
    },
    "node_register": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "node_id", "worker_version", "region", "max_cells"],
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "node_register" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "node_id": { "$ref": "#/$defs/node_id" },
        "worker_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]{1,64})?$" },
        "region": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
        "max_cells": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "listen_url": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^https?://[a-z0-9.:\\[\\]-]{1,200}(:[0-9]{1,5})?/?$",
          "description": "0.3: the base URL of the node listener (section 15), on an address only the control plane reaches. Missing: the node serves no section 15 endpoint (F3 nodes)."
        }
      }
    },
    "node_registered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "node_id",
        "heartbeat_interval_ms",
        "unhealthy_after_ms",
        "resync_interval_ms",
        "route_version"
      ],
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "node_registered" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "node_id": { "$ref": "#/$defs/node_id" },
        "heartbeat_interval_ms": { "type": "integer", "minimum": 1000, "maximum": 60000 },
        "unhealthy_after_ms": { "type": "integer", "minimum": 3000, "maximum": 600000 },
        "resync_interval_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "route_version": { "$ref": "#/$defs/route_version" },
        "callback_token": {
          "type": "string",
          "pattern": "^renox_cb_[a-z2-7]{32}$",
          "description": "0.3: present when node_register carried listen_url. The bearer the control plane presents on the node listener until the next registration; the node keeps it in memory only."
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "node_id", "sent_at", "route_version", "cells"],
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "heartbeat" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "node_id": { "$ref": "#/$defs/node_id" },
        "sent_at": { "$ref": "#/$defs/unix_ms" },
        "route_version": { "$ref": "#/$defs/route_version" },
        "cells": { "type": "integer", "minimum": 0, "description": "Warm cells on the node." },
        "disk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "free_bytes", "watermark"],
          "description": "Deploy API 0.4 (section 7), optional: the data directory's level from the node's disk watermarks (disk.rs, #103: warn from 80 % used, critical from 90 %, when no new cell is created, and from 95 %, when writes are refused); watermark is the percent the level crossed (80, 90 or 95), null at ok.",
          "properties": {
            "level": { "enum": ["ok", "warn", "critical"] },
            "free_bytes": { "type": "integer", "minimum": 0 },
            "watermark": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 }
          },
          "if": { "properties": { "level": { "const": "ok" } } },
          "then": { "properties": { "watermark": { "type": "null" } } },
          "else": { "properties": { "watermark": { "type": "integer" } } }
        }
      }
    },
    "heartbeat_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "route_version"],
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "heartbeat_ack" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "route_version": {
          "$ref": "#/$defs/route_version",
          "description": "The control plane's current route version; a node that holds less resyncs."
        }
      }
    },
    "route_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "version", "entries"],
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "route_snapshot" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "version": { "$ref": "#/$defs/route_version" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/route_entry" } }
      }
    },
    "route_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "prev_version", "version", "upserts", "removals"],
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "route_delta" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "prev_version": { "$ref": "#/$defs/route_version" },
        "version": { "$ref": "#/$defs/route_version" },
        "upserts": { "type": "array", "items": { "$ref": "#/$defs/route_entry" } },
        "removals": { "type": "array", "items": { "$ref": "#/$defs/route_removal" } }
      }
    },
    "resync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "version"],
      "description": "Asks the node to fetch a full snapshot now (sent after a control-plane restart or when deltas were lost).",
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "resync" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "version": { "$ref": "#/$defs/route_version" }
      }
    },
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "activation_id",
        "tenant_id",
        "app",
        "deployment_hash",
        "tier",
        "secrets_version",
        "probe",
        "deadline_ms"
      ],
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "prepare" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "activation_id": { "$ref": "#/$defs/activation_id" },
        "tenant_id": { "$ref": "#/$defs/tenant_id" },
        "app": { "$ref": "#/$defs/app" },
        "deployment_hash": { "$ref": "#/$defs/sha256" },
        "tier": { "$ref": "#/$defs/tier" },
        "secrets_version": { "type": "integer", "minimum": 0 },
        "probe": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["path", "timeout_ms"],
          "description": "null: the app has no GET route without parameters; only cell creation is checked.",
          "properties": {
            "path": { "type": "string", "pattern": "^/([A-Za-z0-9._~-]+(/[A-Za-z0-9._~-]+)*)?$" },
            "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 30000 }
          }
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000,
          "description": "Time the node has to answer with prepare_result."
        }
      }
    },
    "prepare_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "activation_id", "node_id", "ok"],
      "if": { "properties": { "ok": { "const": false } } },
      "then": { "required": ["error"] },
      "else": { "not": { "required": ["error"] } },
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "prepare_result" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "activation_id": { "$ref": "#/$defs/activation_id" },
        "node_id": { "$ref": "#/$defs/node_id" },
        "ok": { "type": "boolean" },
        "migrations_applied": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}/[0-9]{3}_[a-z0-9_]{1,64}\\.sql$" }
        },
        "error": { "$ref": "#/$defs/activation_error" }
      }
    },
    "secrets_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "tenant_id", "app", "deployment_hash", "version", "secrets"],
      "description": "Plaintext secret values for one deployment, filtered to the names its manifest declares. Sent only over TLS to the node the tenant is assigned to, with Cache-Control: no-store; the node keeps it in memory only.",
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "secrets_bundle" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "tenant_id": { "$ref": "#/$defs/tenant_id" },
        "app": { "$ref": "#/$defs/app" },
        "deployment_hash": { "$ref": "#/$defs/sha256" },
        "version": { "type": "integer", "minimum": 0 },
        "secrets": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": { "$ref": "#/$defs/secret_name" },
          "additionalProperties": { "type": "string", "minLength": 8, "maxLength": 65536 }
        }
      }
    },
    "certificate_update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "hostname", "version", "not_after"],
      "description": "A certificate for hostname was issued or renewed; the node fetches it with GET /v1/nodes/{node_id}/certificates/{hostname} and reloads its certificate store. Keys never travel on the stream.",
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "certificate_update" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "hostname": { "$ref": "#/$defs/hostname" },
        "version": { "type": "integer", "minimum": 1 },
        "not_after": { "$ref": "#/$defs/unix_ms" }
      }
    },
    "certificate_remove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "hostname", "version"],
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "certificate_remove" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "hostname": { "$ref": "#/$defs/hostname" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "certificate_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "hostname", "version", "not_after", "chain_pem", "key_pem"],
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "certificate_bundle" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "hostname": { "$ref": "#/$defs/hostname" },
        "version": { "type": "integer", "minimum": 1 },
        "not_after": { "$ref": "#/$defs/unix_ms" },
        "chain_pem": { "type": "string", "pattern": "^-----BEGIN CERTIFICATE-----\\n", "maxLength": 65536 },
        "key_pem": { "type": "string", "pattern": "^-----BEGIN PRIVATE KEY-----\\n", "maxLength": 16384 }
      }
    },
    "log_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ts",
        "tenant_id",
        "deployment_hash",
        "request_id",
        "module",
        "level",
        "message",
        "fields",
        "source"
      ],
      "description": "One tenant log line as written by op_log (ops.md section 4), already redacted on the node, plus `source`.",
      "properties": {
        "ts": { "$ref": "#/$defs/unix_ms" },
        "tenant_id": { "$ref": "#/$defs/tenant_id" },
        "deployment_hash": { "$ref": "#/$defs/sha256" },
        "request_id": { "type": ["string", "null"], "pattern": "^[0-9A-Za-z_-]{8,64}$" },
        "module": { "type": "string", "maxLength": 256 },
        "level": { "enum": ["debug", "info", "warn", "error"] },
        "message": { "type": "string", "maxLength": 8300 },
        "fields": { "type": ["object", "null"] },
        "source": {
          "enum": ["server", "client", "platform"],
          "description": "platform (0.3): written by the control plane itself (failover, restore, export, import, operator actions; fields.kind names which). A node never sends it; ingestLogs refuses a batch that does."
        }
      }
    },
    "log_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "node_id", "lines"],
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "log_batch" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "node_id": { "$ref": "#/$defs/node_id" },
        "lines": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/log_line" } }
      }
    },
    "database_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}(\\.[a-z][a-z0-9-]{0,49})?$",
      "description": "A tenant file: the tenant id for the tenant's shared file, or <tenant_id>.<app> for an app with a database of its own (a staging app or an app created by a restore, deploy-api.md section 14)."
    },
    "generation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "A Litestream generation: one continuous WAL history of a tenant file."
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start", "end"],
      "description": "One generation and the time range a restore can reach inside it.",
      "properties": {
        "id": { "$ref": "#/$defs/generation_id" },
        "start": { "$ref": "#/$defs/unix_ms" },
        "end": { "$ref": "#/$defs/unix_ms" }
      }
    },
    "replica": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["file", "s3"] },
        "region": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$",
          "description": "s3 only: the bucket's region (UAE regions in controlled mode)."
        }
      }
    },
    "database_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_bytes", "quota_bytes", "wal_bytes"],
      "properties": {
        "size_bytes": { "type": "integer", "minimum": 0 },
        "quota_bytes": { "type": "integer", "minimum": 0 },
        "wal_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "restore_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "tenant_id", "database", "timestamp", "reason", "deadline_ms"],
      "description": "POST /nodes/{node_id}/tenants/{tenant_id}/restore (section 15): the control plane asks the node to restore a tenant file from its replica before any route points there (FO3). Idempotent.",
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "restore_request" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "tenant_id": { "$ref": "#/$defs/tenant_id" },
        "database": { "$ref": "#/$defs/database_id" },
        "source_database": {
          "$ref": "#/$defs/database_id",
          "description": "Restore from this file's replica into database (a restore to a new app). Missing: from database's own replica."
        },
        "timestamp": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Restore the state as of this time (Unix ms); null = the latest replicated state."
        },
        "reason": { "enum": ["failover", "restore", "move"] },
        "deadline_ms": { "type": "integer", "minimum": 1000, "maximum": 120000 }
      }
    },
    "restore_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "node_id",
        "tenant_id",
        "database",
        "source",
        "generation",
        "file_sha256",
        "restored_to",
        "elapsed_ms"
      ],
      "description": "200 answer of the restore request: the file is in place, passed PRAGMA quick_check, and the node may now open it.",
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "restore_result" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "node_id": { "$ref": "#/$defs/node_id" },
        "tenant_id": { "$ref": "#/$defs/tenant_id" },
        "database": { "$ref": "#/$defs/database_id" },
        "source": {
          "enum": ["replica", "local"],
          "description": "replica: restored now; local: the file was already present and passed PRAGMA quick_check (a repeated request), nothing changed."
        },
        "generation": {
          "anyOf": [{ "$ref": "#/$defs/generation_id" }, { "type": "null" }],
          "description": "The generation restored from; null when source is local and the file was never replicated."
        },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "restored_to": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "The time of the last transaction in the restored file, when the replica says it."
        },
        "elapsed_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "replication_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "node_id",
        "tenant_id",
        "database",
        "replication",
        "state",
        "replica",
        "last_sync_at",
        "lag_seconds",
        "retention_hours",
        "snapshot_interval_seconds",
        "generations",
        "db"
      ],
      "description": "GET /nodes/{node_id}/tenants/{tenant_id}/replication (section 15): what the node reports about one tenant file.",
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "replication_status" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "node_id": { "$ref": "#/$defs/node_id" },
        "tenant_id": { "$ref": "#/$defs/tenant_id" },
        "database": { "$ref": "#/$defs/database_id" },
        "replication": { "enum": ["none", "litestream"] },
        "state": {
          "enum": ["off", "starting", "replicating", "stopped"],
          "description": "The sidecar state machine of #255: off (replication none, or no write yet), starting, replicating, stopped (cell evicted and the last frames shipped)."
        },
        "replica": { "anyOf": [{ "$ref": "#/$defs/replica" }, { "type": "null" }] },
        "last_sync_at": { "type": ["integer", "null"], "minimum": 0 },
        "lag_seconds": { "type": ["number", "null"], "minimum": 0 },
        "retention_hours": { "type": "integer", "minimum": 0 },
        "snapshot_interval_seconds": { "type": "integer", "minimum": 0 },
        "generations": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/generation" },
          "description": "Newest first."
        },
        "db": { "$ref": "#/$defs/database_size" }
      }
    },
    "tenant_dropped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "node_id", "tenant_id", "cells_drained", "file"],
      "description": "200 answer of DELETE /nodes/{node_id}/tenants/{tenant_id} (FO4): the node drained the tenant's cells and refuses the tenant from now on.",
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "tenant_dropped" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "node_id": { "$ref": "#/$defs/node_id" },
        "tenant_id": { "$ref": "#/$defs/tenant_id" },
        "cells_drained": { "type": "integer", "minimum": 0 },
        "file": {
          "enum": ["kept", "removed"],
          "description": "removed only after the replica confirmed the last frames; otherwise kept and quarantined from serving."
        }
      }
    },
    "import_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "node_id", "tenant_id", "database", "size_bytes", "sha256", "tables"],
      "description": "200 answer of PUT /nodes/{node_id}/tenants/{tenant_id}/import: the file passed PRAGMA quick_check and the authorizer's table-name rules and replaced the staging app's file.",
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "import_result" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "node_id": { "$ref": "#/$defs/node_id" },
        "tenant_id": { "$ref": "#/$defs/tenant_id" },
        "database": { "$ref": "#/$defs/database_id" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "tables": {
          "type": "array",
          "maxItems": 1000,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*__[a-z0-9_]+$" }
        }
      }
    },
    "move_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "tenant_id", "target", "reason", "operator"],
      "description": "POST /nodes/{node_id}/tenants/{tenant_id}/move (section 17): the node runs its [process] microvm_hook for the tenant.",
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "move_request" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "tenant_id": { "$ref": "#/$defs/tenant_id" },
        "target": { "const": "microvm" },
        "reason": { "type": "string", "minLength": 10, "maxLength": 500 },
        "operator": { "type": "string", "pattern": "^(operator|acct_[0-9A-Za-z]{16,32})$" }
      }
    },
    "move_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "node_id", "tenant_id", "target", "state", "hook_exit_code"],
      "description": "200 answer of the move request: the hook's exit code (0 moved; anything else failed, the tenant stays where it is and stops being moving).",
      "properties": {
        "$comment": { "type": "string" },
        "type": { "const": "move_result" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "node_id": { "$ref": "#/$defs/node_id" },
        "tenant_id": { "$ref": "#/$defs/tenant_id" },
        "target": { "const": "microvm" },
        "state": { "enum": ["moved", "failed"] },
        "hook_exit_code": { "type": "integer", "minimum": 0, "maximum": 255 }
      },
      "if": { "properties": { "state": { "const": "moved" } } },
      "then": { "properties": { "hook_exit_code": { "const": 0 } } },
      "else": { "properties": { "hook_exit_code": { "minimum": 1 } } }
    }
  }
}
