{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renox.dev/contracts/artifact/v1/manifest.schema.json",
  "title": "Renox artifact manifest, artifact contract versions 0, 1, 1.1 and 1.2",
  "description": "manifest.json at the root of an artifact. Prose: docs/contracts/artifact.md section 3. Semantic rules the schema cannot express (route conflicts, entry files exist, tier bounds, page field combinations, templates, security, modules) are V4-V23 in section 6. Version 1.1 (artifact.version 1) adds modules, slots, and module-prefixed ids. Version 1.2 (artifact.version 1) adds entries: the export names of each code entry and its eager flag (ops.md 1.4.0, lazy route modules).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "app",
    "code",
    "routes",
    "permissions"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "enum": [
            0,
            1
          ]
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "timezone"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "timezone": {
          "type": "string",
          "description": "IANA zone name; checked against Intl by V4.",
          "pattern": "^(UTC|[A-Za-z_]+(/[A-Za-z0-9_+-]+){1,2})$"
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "entry"
      ],
      "properties": {
        "format": {
          "enum": [
            "esm-dir",
            "eszip"
          ]
        },
        "entry": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/moduleId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/modulePath"
          }
        }
      }
    },
    "entries": {
      "type": "object",
      "description": "Version 1.2: code.entry id -> { exports, eager }. exports are the module's static export names, recorded by renox build; the worker refuses an artifact whose recorded exports differ from the module's (V23, ops.md 1.4.0 section 11). eager false lets the runtime evaluate a route module on its first request. Absent: every entry is eager and the exports are checked at isolate creation (1.1 behaviour).",
      "maxProperties": 10000,
      "propertyNames": {
        "$ref": "#/$defs/moduleId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entryInfo"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "secrets"
      ],
      "properties": {
        "network": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/networkEntry"
          }
        },
        "secrets": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "description": "Overrides that may only lower the tier default. Bounds are the paid-tier values.",
      "properties": {
        "cpu_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 16,
          "maximum": 512
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    "templates": {
      "type": "object",
      "description": "Version 1. Template id -> entry; one file templates/<id>.jinja per key (V14).",
      "maxProperties": 10000,
      "propertyNames": {
        "$ref": "#/$defs/templateId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/template"
      }
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "modules": {
      "type": [
        "object",
        "array"
      ],
      "description": "Version 1.1: the installed modules as an array, copied from renox.lock (manifest.md section 5) in its topological order, which is the migration order. An empty object is the version 0 and 1 form of no modules (maxProperties applies to that form only; maxItems and items to the array).",
      "maxProperties": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/moduleEntry"
      }
    },
    "slots": {
      "type": "object",
      "description": "Version 1.1: slot name -> the partials that fill it, in render order (priority, then module name). V18, V22.",
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/dottedName"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module",
            "template"
          ],
          "properties": {
            "module": {
              "$ref": "#/$defs/installedName"
            },
            "template": {
              "$ref": "#/$defs/templateId"
            },
            "requires": {
              "$ref": "#/$defs/dottedName"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "method": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS",
        "HEAD"
      ]
    },
    "moduleId": {
      "type": "string",
      "description": "Source path of a code module without extension: functions/... for function routes and pages/... for page routes of the app (version 1); modules/<name>/functions/..., modules/<name>/pages/..., and modules/<name>/services or /hooks for an installed module (version 1.1). V7 and V18 check which prefix each use takes.",
      "maxLength": 512,
      "pattern": "^((modules/[a-z][a-z0-9_]{0,31}/)?(functions|pages)(/(?!\\.\\.?(/|$))[A-Za-z0-9_.\\[\\]-]+)+|modules/[a-z][a-z0-9_]{0,31}/(services|hooks))$"
    },
    "modulePath": {
      "type": "string",
      "description": "Relative to code/ (esm-dir) or file:///<path> inside bundle.eszip (eszip). No . or .. segments.",
      "maxLength": 512,
      "pattern": "^(?!.*(^|/)\\.\\.?(/|$))[A-Za-z0-9_.\\[\\]-]+(/[A-Za-z0-9_.\\[\\]-]+)*\\.(js|mjs)$"
    },
    "routePath": {
      "type": "string",
      "description": "Route pattern: static segments, :param, or *catchall (last only; checked by V8).",
      "maxLength": 1024,
      "pattern": "^(/|(/([A-Za-z0-9._~-]+|:[a-z_][a-z0-9_]{0,31}|\\*[a-z_][a-z0-9_]{0,31}))+)$"
    },
    "networkEntry": {
      "type": "string",
      "description": "Allowlist entry, ops.md section 2: [http://](*.)host[:port], lower case, or an IP literal.",
      "maxLength": 270,
      "pattern": "^(http://)?((\\*\\.)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+|[0-9]{1,3}(\\.[0-9]{1,3}){3}|\\[[0-9a-f:.]+\\])(:[0-9]{1,5})?$"
    },
    "route": {
      "description": "ws and sse (F5) are reserved.",
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "page"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/pageRoute"
      },
      "else": {
        "$ref": "#/$defs/functionRoute"
      }
    },
    "templateId": {
      "type": "string",
      "description": "Source path of the template without extension: pages/... or partials/... of the app, or modules/<name>/pages/... and modules/<name>/partials/... of an installed module (version 1.1); the file is templates/<id>.jinja.",
      "maxLength": 500,
      "pattern": "^(modules/[a-z][a-z0-9_]{0,31}/)?(pages|partials)(/(?!\\.\\.?(/|$))[A-Za-z0-9_.\\[\\]-]+)+$"
    },
    "fragmentName": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]{0,63}$"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "page",
            "layout",
            "partial",
            "error",
            "not_found"
          ]
        },
        "fragments": {
          "type": "object",
          "description": "The fragment map: every fragment reachable when rendering the page, including its layouts.",
          "maxProperties": 1000,
          "propertyNames": {
            "$ref": "#/$defs/fragmentName"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target"
            ],
            "properties": {
              "target": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_:.-]{0,127}$"
                  }
                ]
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "page"
          }
        }
      },
      "then": {
        "required": [
          "fragments"
        ]
      },
      "else": {
        "properties": {
          "fragments": false
        }
      }
    },
    "functionRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "method",
        "path",
        "module",
        "export"
      ],
      "properties": {
        "kind": {
          "const": "function"
        },
        "method": {
          "$ref": "#/$defs/method"
        },
        "path": {
          "$ref": "#/$defs/routePath"
        },
        "module": {
          "$ref": "#/$defs/moduleId"
        },
        "export": {
          "$ref": "#/$defs/method"
        }
      }
    },
    "pageRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "description": "Version 1. Field combinations (.html only, .ts only, pair) are checked by V15.",
      "properties": {
        "kind": {
          "const": "page"
        },
        "path": {
          "$ref": "#/$defs/routePath"
        },
        "module": {
          "$ref": "#/$defs/moduleId"
        },
        "load": {
          "type": "boolean"
        },
        "actions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          }
        },
        "template": {
          "$ref": "#/$defs/templateId"
        }
      }
    },
    "cspSource": {
      "type": "string",
      "maxLength": 256,
      "description": "https origin with an optional *. host wildcard and path, data:, blob:, or (with allow_unsafe, V16) 'unsafe-inline' / 'unsafe-eval'.",
      "pattern": "^(https://(\\*\\.)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+(:[0-9]{1,5})?(/[A-Za-z0-9._~%!$&()*+,;=:@/-]*)?|data:|blob:|'unsafe-inline'|'unsafe-eval')$"
    },
    "origin": {
      "type": "string",
      "maxLength": 270,
      "pattern": "^https?://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*(:[0-9]{1,5})?$"
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "description": "Version 1: renox.toml [security], resolved. Absent fields take the docs/04 defaults (artifact.md section 3, Security).",
      "properties": {
        "csp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "script_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "style_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "img_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "connect_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "frame_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "font_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "allow_unsafe": {
              "type": "boolean"
            },
            "report_only": {
              "type": "boolean"
            }
          }
        },
        "cors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "origins": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/origin"
              }
            },
            "methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/method"
              }
            },
            "headers": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]{1,64}$"
              }
            },
            "credentials": {
              "type": "boolean"
            },
            "max_age_s": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400
            }
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "referrer_policy": {
              "enum": [
                "no-referrer",
                "no-referrer-when-downgrade",
                "origin",
                "origin-when-cross-origin",
                "same-origin",
                "strict-origin",
                "strict-origin-when-cross-origin"
              ]
            },
            "permissions_allow": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            }
          }
        },
        "ratelimit": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "path",
              "requests",
              "window_s",
              "key"
            ],
            "properties": {
              "method": {
                "$ref": "#/$defs/method"
              },
              "path": {
                "$ref": "#/$defs/routePath"
              },
              "requests": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "window_s": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "key": {
                "enum": [
                  "ip"
                ],
                "description": "\"user\" is reserved for F4."
              }
            }
          }
        }
      }
    },
    "installedName": {
      "type": "string",
      "description": "A module name (manifest.md MF1; V17 checks the rest).",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "dottedName": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]{0,63}(\\.[a-z][a-z0-9_]{0,63})+$"
    },
    "secretName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "modulePermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "secrets",
        "slots",
        "hooks"
      ],
      "properties": {
        "tables": {
          "type": "string",
          "maxLength": 40,
          "description": "Exactly \"<name>__*\" (V17)."
        },
        "network": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/networkEntry"
          }
        },
        "secrets": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/secretName"
          }
        },
        "slots": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dottedName"
          }
        },
        "hooks": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dottedName"
          }
        }
      }
    },
    "moduleEntry": {
      "type": "object",
      "additionalProperties": false,
      "description": "One installed module (artifact.md section 3, \"Modules\"). Every field but exports is copied from its renox.lock entry (V17).",
      "required": [
        "name",
        "version",
        "hash",
        "source",
        "mount",
        "isolation",
        "dependencies",
        "config",
        "permissions",
        "approved",
        "exports"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/installedName"
        },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "hash": {
          "type": "string",
          "description": "SHA-256 of the module tree (manifest.md section 5).",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(official|path:(?![/\\\\])(?![A-Za-z]:)[^\\u0000-\\u001f\\\\:]+|git:https://[A-Za-z0-9._~%/-]+(:[0-9]{1,5})?[A-Za-z0-9._~%/-]*#[0-9a-f]{40})$"
        },
        "mount": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(/|(/[A-Za-z0-9._~-]+)+)$"
        },
        "isolation": {
          "enum": [
            "shared",
            "isolate"
          ]
        },
        "dependencies": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/installedName"
          }
        },
        "config": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        },
        "permissions": {
          "$ref": "#/$defs/modulePermissions",
          "description": "What the module gets at run time: its manifest's [permissions] (V22: a subset of approved)."
        },
        "approved": {
          "$ref": "#/$defs/modulePermissions",
          "description": "The renox.lock approved snapshot."
        },
        "exports": {
          "type": "object",
          "additionalProperties": false,
          "description": "The module's public API from its manifest [exports]: what the broker checks calls, hooks, and events against (ops.md 1.3.0).",
          "properties": {
            "services": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
              }
            },
            "events": {
              "type": "object",
              "maxProperties": 256,
              "propertyNames": {
                "$ref": "#/$defs/dottedName"
              },
              "additionalProperties": {
                "type": "object",
                "description": "The payload schema."
              }
            },
            "hooks": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/dottedName"
              }
            },
            "views": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9_]*__public_[a-z0-9_]+_v[1-9][0-9]*$"
              }
            }
          }
        }
      }
    },
    "overridesIndex": {
      "type": "object",
      "additionalProperties": false,
      "description": "overrides.json at the artifact root (version 1.1, V20): each file under overrides/ with the template it replaces and the sha256 of the original module file at the installed version.",
      "required": [
        "version",
        "files"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "version": {
          "const": 0
        },
        "files": {
          "type": "object",
          "maxProperties": 1000,
          "propertyNames": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^[a-z][a-z0-9_]{0,31}/(pages|partials)(/(?!\\.\\.?(/|$))[A-Za-z0-9_.\\[\\]-]+)+\\.html$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "template",
              "original_sha256"
            ],
            "properties": {
              "template": {
                "$ref": "#/$defs/templateId"
              },
              "original_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "entryInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exports"
      ],
      "description": "Version 1.2: what renox build recorded for one code entry (artifact.md section 3, \"Entries\").",
      "properties": {
        "exports": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,127}$"
          },
          "description": "The module's static export names, sorted."
        },
        "eager": {
          "type": "boolean",
          "description": "true: evaluated at isolate creation. false (route modules only): evaluated on the first request that needs it. Default true."
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "Version 0 has no templates, no security, no modules or slots, and only function routes.",
      "if": {
        "required": [
          "artifact"
        ],
        "properties": {
          "artifact": {
            "required": [
              "version"
            ],
            "properties": {
              "version": {
                "const": 0
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "templates": false,
          "security": false,
          "routes": {
            "items": {
              "properties": {
                "kind": {
                  "const": "function"
                }
              }
            }
          },
          "slots": false,
          "modules": {
            "type": "object",
            "maxProperties": 0
          }
        }
      }
    }
  ]
}
