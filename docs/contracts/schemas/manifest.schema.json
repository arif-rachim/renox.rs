{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renox.dev/contracts/artifact/v0/manifest.schema.json",
  "title": "Renox artifact manifest, artifact contract version 0",
  "description": "manifest.json at the root of an artifact. Prose: docs/contracts/artifact.md section 3. Semantic rules the schema cannot express (route conflicts, entry files exist, tier bounds) are V4-V12 in section 6.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "app", "code", "routes", "permissions"],
  "properties": {
    "$comment": { "type": "string" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "const": 0 }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "timezone"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "timezone": {
          "type": "string",
          "description": "IANA zone name; checked against Intl by V4.",
          "pattern": "^(UTC|[A-Za-z_]+(/[A-Za-z0-9_+-]+){1,2})$"
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "entry"],
      "properties": {
        "format": { "enum": ["esm-dir", "eszip"] },
        "entry": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/moduleId" },
          "additionalProperties": { "$ref": "#/$defs/modulePath" }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/route" }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "secrets"],
      "properties": {
        "network": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/networkEntry" }
        },
        "secrets": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "description": "Overrides that may only lower the tier default. Bounds are the paid-tier values.",
      "properties": {
        "cpu_ms": { "type": "integer", "minimum": 1, "maximum": 500 },
        "wall_ms": { "type": "integer", "minimum": 1000, "maximum": 60000 },
        "memory_mb": { "type": "integer", "minimum": 16, "maximum": 512 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    },
    "modules": {
      "type": "object",
      "description": "Reserved, F4. Must be empty in version 0.",
      "maxProperties": 0
    }
  },
  "$defs": {
    "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"] },
    "moduleId": {
      "type": "string",
      "description": "Source path of the route module without extension, relative to the app root. F1: functions/ only.",
      "maxLength": 512,
      "pattern": "^functions(/(?!\\.\\.?(/|$))[A-Za-z0-9_.\\[\\]-]+)+$"
    },
    "modulePath": {
      "type": "string",
      "description": "Relative to code/ (esm-dir) or file:///<path> inside bundle.eszip (eszip). No . or .. segments.",
      "maxLength": 512,
      "pattern": "^(?!.*(^|/)\\.\\.?(/|$))[A-Za-z0-9_.\\[\\]-]+(/[A-Za-z0-9_.\\[\\]-]+)*\\.(js|mjs)$"
    },
    "routePath": {
      "type": "string",
      "description": "Route pattern: static segments, :param, or *catchall (last only; checked by V8).",
      "maxLength": 1024,
      "pattern": "^(/|(/([A-Za-z0-9._~-]+|:[a-z_][a-z0-9_]{0,31}|\\*[a-z_][a-z0-9_]{0,31}))+)$"
    },
    "networkEntry": {
      "type": "string",
      "description": "Allowlist entry, ops.md section 2: [http://](*.)host[:port], lower case, or an IP literal.",
      "maxLength": 270,
      "pattern": "^(http://)?((\\*\\.)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+|[0-9]{1,3}(\\.[0-9]{1,3}){3}|\\[[0-9a-f:.]+\\])(:[0-9]{1,5})?$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "method", "path", "module", "export"],
      "properties": {
        "kind": { "const": "function", "description": "page (F2), ws and sse (F5) are reserved." },
        "method": { "$ref": "#/$defs/method" },
        "path": { "$ref": "#/$defs/routePath" },
        "module": { "$ref": "#/$defs/moduleId" },
        "export": { "$ref": "#/$defs/method" }
      }
    }
  }
}
