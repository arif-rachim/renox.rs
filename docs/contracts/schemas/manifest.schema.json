{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renox.dev/contracts/artifact/v1/manifest.schema.json",
  "title": "Renox artifact manifest, artifact contract versions 0 and 1",
  "description": "manifest.json at the root of an artifact. Prose: docs/contracts/artifact.md section 3. Semantic rules the schema cannot express (route conflicts, entry files exist, tier bounds, page field combinations, templates, security) are V4-V16 in section 6.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "app",
    "code",
    "routes",
    "permissions"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "enum": [
            0,
            1
          ]
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "timezone"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "timezone": {
          "type": "string",
          "description": "IANA zone name; checked against Intl by V4.",
          "pattern": "^(UTC|[A-Za-z_]+(/[A-Za-z0-9_+-]+){1,2})$"
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "entry"
      ],
      "properties": {
        "format": {
          "enum": [
            "esm-dir",
            "eszip"
          ]
        },
        "entry": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/moduleId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/modulePath"
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "secrets"
      ],
      "properties": {
        "network": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/networkEntry"
          }
        },
        "secrets": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "description": "Overrides that may only lower the tier default. Bounds are the paid-tier values.",
      "properties": {
        "cpu_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 16,
          "maximum": 512
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    "templates": {
      "type": "object",
      "description": "Version 1. Template id -> entry; one file templates/<id>.jinja per key (V14).",
      "maxProperties": 10000,
      "propertyNames": {
        "$ref": "#/$defs/templateId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/template"
      }
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "modules": {
      "type": "object",
      "description": "Reserved, F4. Must be empty in version 0.",
      "maxProperties": 0
    }
  },
  "$defs": {
    "method": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS",
        "HEAD"
      ]
    },
    "moduleId": {
      "type": "string",
      "description": "Source path of the route module without extension, relative to the app root: functions/... for function routes, pages/... for page routes (version 1). V7 checks which prefix each route kind uses.",
      "maxLength": 512,
      "pattern": "^(functions|pages)(/(?!\\.\\.?(/|$))[A-Za-z0-9_.\\[\\]-]+)+$"
    },
    "modulePath": {
      "type": "string",
      "description": "Relative to code/ (esm-dir) or file:///<path> inside bundle.eszip (eszip). No . or .. segments.",
      "maxLength": 512,
      "pattern": "^(?!.*(^|/)\\.\\.?(/|$))[A-Za-z0-9_.\\[\\]-]+(/[A-Za-z0-9_.\\[\\]-]+)*\\.(js|mjs)$"
    },
    "routePath": {
      "type": "string",
      "description": "Route pattern: static segments, :param, or *catchall (last only; checked by V8).",
      "maxLength": 1024,
      "pattern": "^(/|(/([A-Za-z0-9._~-]+|:[a-z_][a-z0-9_]{0,31}|\\*[a-z_][a-z0-9_]{0,31}))+)$"
    },
    "networkEntry": {
      "type": "string",
      "description": "Allowlist entry, ops.md section 2: [http://](*.)host[:port], lower case, or an IP literal.",
      "maxLength": 270,
      "pattern": "^(http://)?((\\*\\.)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+|[0-9]{1,3}(\\.[0-9]{1,3}){3}|\\[[0-9a-f:.]+\\])(:[0-9]{1,5})?$"
    },
    "route": {
      "description": "ws and sse (F5) are reserved.",
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "page"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/pageRoute"
      },
      "else": {
        "$ref": "#/$defs/functionRoute"
      }
    },
    "templateId": {
      "type": "string",
      "description": "Source path of the template without extension; the file is templates/<id>.jinja.",
      "maxLength": 500,
      "pattern": "^(pages|partials)(/(?!\\.\\.?(/|$))[A-Za-z0-9_.\\[\\]-]+)+$"
    },
    "fragmentName": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]{0,63}$"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "page",
            "layout",
            "partial",
            "error",
            "not_found"
          ]
        },
        "fragments": {
          "type": "object",
          "description": "The fragment map: every fragment reachable when rendering the page, including its layouts.",
          "maxProperties": 1000,
          "propertyNames": {
            "$ref": "#/$defs/fragmentName"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target"
            ],
            "properties": {
              "target": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_:.-]{0,127}$"
                  }
                ]
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "page"
          }
        }
      },
      "then": {
        "required": [
          "fragments"
        ]
      },
      "else": {
        "properties": {
          "fragments": false
        }
      }
    },
    "functionRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "method",
        "path",
        "module",
        "export"
      ],
      "properties": {
        "kind": {
          "const": "function"
        },
        "method": {
          "$ref": "#/$defs/method"
        },
        "path": {
          "$ref": "#/$defs/routePath"
        },
        "module": {
          "$ref": "#/$defs/moduleId"
        },
        "export": {
          "$ref": "#/$defs/method"
        }
      }
    },
    "pageRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "description": "Version 1. Field combinations (.html only, .ts only, pair) are checked by V15.",
      "properties": {
        "kind": {
          "const": "page"
        },
        "path": {
          "$ref": "#/$defs/routePath"
        },
        "module": {
          "$ref": "#/$defs/moduleId"
        },
        "load": {
          "type": "boolean"
        },
        "actions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          }
        },
        "template": {
          "$ref": "#/$defs/templateId"
        }
      }
    },
    "cspSource": {
      "type": "string",
      "maxLength": 256,
      "description": "https origin with an optional *. host wildcard and path, data:, blob:, or (with allow_unsafe, V16) 'unsafe-inline' / 'unsafe-eval'.",
      "pattern": "^(https://(\\*\\.)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+(:[0-9]{1,5})?(/[A-Za-z0-9._~%!$&()*+,;=:@/-]*)?|data:|blob:|'unsafe-inline'|'unsafe-eval')$"
    },
    "origin": {
      "type": "string",
      "maxLength": 270,
      "pattern": "^https?://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*(:[0-9]{1,5})?$"
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "description": "Version 1: renox.toml [security], resolved. Absent fields take the docs/04 defaults (artifact.md section 3, Security).",
      "properties": {
        "csp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "script_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "style_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "img_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "connect_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "frame_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "font_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "allow_unsafe": {
              "type": "boolean"
            },
            "report_only": {
              "type": "boolean"
            }
          }
        },
        "cors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "origins": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/origin"
              }
            },
            "methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/method"
              }
            },
            "headers": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]{1,64}$"
              }
            },
            "credentials": {
              "type": "boolean"
            },
            "max_age_s": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400
            }
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "referrer_policy": {
              "enum": [
                "no-referrer",
                "no-referrer-when-downgrade",
                "origin",
                "origin-when-cross-origin",
                "same-origin",
                "strict-origin",
                "strict-origin-when-cross-origin"
              ]
            },
            "permissions_allow": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            }
          }
        },
        "ratelimit": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "path",
              "requests",
              "window_s",
              "key"
            ],
            "properties": {
              "method": {
                "$ref": "#/$defs/method"
              },
              "path": {
                "$ref": "#/$defs/routePath"
              },
              "requests": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "window_s": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "key": {
                "enum": [
                  "ip"
                ],
                "description": "\"user\" is reserved for F4."
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "Version 0 has no templates, no security, and only function routes.",
      "if": {
        "required": [
          "artifact"
        ],
        "properties": {
          "artifact": {
            "required": [
              "version"
            ],
            "properties": {
              "version": {
                "const": 0
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "templates": false,
          "security": false,
          "routes": {
            "items": {
              "properties": {
                "kind": {
                  "const": "function"
                }
              }
            }
          }
        }
      }
    }
  ]
}
