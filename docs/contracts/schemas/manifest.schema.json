{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renox.dev/contracts/artifact/v1/manifest.schema.json",
  "title": "Renox artifact manifest, artifact contract versions 0, 1, 1.1, 1.2, 1.3 and 1.4",
  "description": "manifest.json at the root of an artifact. Prose: docs/contracts/artifact.md section 3. Semantic rules the schema cannot express (route conflicts, entry files exist, tier bounds, page field combinations, templates, security, modules) are V4-V23 in section 6. Version 1.1 (artifact.version 1) adds modules, slots, and module-prefixed ids. Version 1.2 (artifact.version 1) adds entries: the export names of each code entry and its eager flag (ops.md 1.4.0, lazy route modules). Version 1.3 (artifact.version 1) adds the route kinds ws, sse, tool and job, the guard of a route, and the authz and realtime blocks of the app and of each module (ops.md 1.5.0); rules V24-V27.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "app",
    "code",
    "routes",
    "permissions"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "enum": [
            0,
            1
          ]
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "timezone"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "timezone": {
          "type": "string",
          "description": "IANA zone name; checked against Intl by V4.",
          "pattern": "^(UTC|[A-Za-z_]+(/[A-Za-z0-9_+-]+){1,2})$"
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "entry"
      ],
      "properties": {
        "format": {
          "enum": [
            "esm-dir",
            "eszip"
          ]
        },
        "entry": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/moduleId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/modulePath"
          }
        }
      }
    },
    "entries": {
      "type": "object",
      "description": "Version 1.2: code.entry id -> { exports, eager }. exports are the module's static export names, recorded by renox build; the worker refuses an artifact whose recorded exports differ from the module's (V23, ops.md 1.4.0 section 11). eager false lets the runtime evaluate a route module on its first request. Absent: every entry is eager and the exports are checked at isolate creation (1.1 behaviour).",
      "maxProperties": 10000,
      "propertyNames": {
        "$ref": "#/$defs/moduleId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entryInfo"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "secrets"
      ],
      "properties": {
        "network": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/networkEntry"
          }
        },
        "secrets": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "description": "Overrides that may only lower the tier default. Bounds are the paid-tier values.",
      "properties": {
        "cpu_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 16,
          "maximum": 512
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    "templates": {
      "type": "object",
      "description": "Version 1. Template id -> entry; one file templates/<id>.jinja per key (V14).",
      "maxProperties": 10000,
      "propertyNames": {
        "$ref": "#/$defs/templateId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/template"
      }
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "modules": {
      "type": [
        "object",
        "array"
      ],
      "description": "Version 1.1: the installed modules as an array, copied from renox.lock (manifest.md section 5) in its topological order, which is the migration order. An empty object is the version 0 and 1 form of no modules (maxProperties applies to that form only; maxItems and items to the array).",
      "maxProperties": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/moduleEntry"
      }
    },
    "slots": {
      "type": "object",
      "description": "Version 1.1: slot name -> the partials that fill it, in render order (priority, then module name). V18, V22.",
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/dottedName"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module",
            "template"
          ],
          "properties": {
            "module": {
              "$ref": "#/$defs/installedName"
            },
            "template": {
              "$ref": "#/$defs/templateId"
            },
            "requires": {
              "$ref": "#/$defs/dottedName"
            }
          }
        }
      }
    },
    "authz": {
      "$ref": "#/$defs/authz"
    },
    "realtime": {
      "$ref": "#/$defs/realtime"
    },
    "storage": {
      "$ref": "#/$defs/storage"
    },
    "ai": {
      "$ref": "#/$defs/ai"
    }
  },
  "$defs": {
    "method": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS",
        "HEAD"
      ]
    },
    "moduleId": {
      "type": "string",
      "description": "Source path of a code module without extension: functions/... for function routes (functions/ws/, functions/sse/ and functions/tools/ for the version 1.3 kinds), pages/... for page routes, jobs/... for job routes of the app; modules/<name>/functions/..., modules/<name>/pages/..., modules/<name>/tools/..., modules/<name>/jobs/..., and modules/<name>/services or /hooks for an installed module. V7 and V18 check which prefix each use takes.",
      "maxLength": 512,
      "pattern": "^((modules/[a-z][a-z0-9_]{0,31}/)?(functions|pages|jobs|tools)(/(?!\\.\\.?(/|$))[A-Za-z0-9_.\\[\\]-]+)+|modules/[a-z][a-z0-9_]{0,31}/(services|hooks))$"
    },
    "modulePath": {
      "type": "string",
      "description": "Relative to code/ (esm-dir) or file:///<path> inside bundle.eszip (eszip). No . or .. segments.",
      "maxLength": 512,
      "pattern": "^(?!.*(^|/)\\.\\.?(/|$))[A-Za-z0-9_.\\[\\]-]+(/[A-Za-z0-9_.\\[\\]-]+)*\\.(js|mjs)$"
    },
    "routePath": {
      "type": "string",
      "description": "Route pattern: static segments, :param, or *catchall (last only; checked by V8).",
      "maxLength": 1024,
      "pattern": "^(/|(/([A-Za-z0-9._~-]+|:[a-z_][a-z0-9_]{0,31}|\\*[a-z_][a-z0-9_]{0,31}))+)$"
    },
    "networkEntry": {
      "type": "string",
      "description": "Allowlist entry, ops.md section 2: [http://](*.)host[:port], lower case, or an IP literal.",
      "maxLength": 270,
      "pattern": "^(http://)?((\\*\\.)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+|[0-9]{1,3}(\\.[0-9]{1,3}){3}|\\[[0-9a-f:.]+\\])(:[0-9]{1,5})?$"
    },
    "route": {
      "type": "object",
      "required": [
        "kind"
      ],
      "description": "One route object, by kind (artifact.md section 3). Version 0: function only; 1: page; 1.3: ws, sse, tool, job; 1.4: webhook.",
      "properties": {
        "kind": {
          "enum": [
            "function",
            "page",
            "ws",
            "sse",
            "tool",
            "job",
            "webhook"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "function"
                ]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/functionRoute"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "page"
                ]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/pageRoute"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "ws",
                  "sse"
                ]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/realtimeRoute"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "tool"
                ]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/toolRoute"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "job"
                ]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/jobRoute"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "webhook"
                ]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/webhookRoute"
          }
        }
      ]
    },
    "templateId": {
      "type": "string",
      "description": "Source path of the template without extension: pages/... or partials/... of the app, or modules/<name>/pages/... and modules/<name>/partials/... of an installed module (version 1.1); the file is templates/<id>.jinja.",
      "maxLength": 500,
      "pattern": "^(modules/[a-z][a-z0-9_]{0,31}/)?(pages|partials)(/(?!\\.\\.?(/|$))[A-Za-z0-9_.\\[\\]-]+)+$"
    },
    "fragmentName": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]{0,63}$"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "page",
            "layout",
            "partial",
            "error",
            "not_found"
          ]
        },
        "fragments": {
          "type": "object",
          "description": "The fragment map: every fragment reachable when rendering the page, including its layouts.",
          "maxProperties": 1000,
          "propertyNames": {
            "$ref": "#/$defs/fragmentName"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target"
            ],
            "properties": {
              "target": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_:.-]{0,127}$"
                  }
                ]
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "page"
          }
        }
      },
      "then": {
        "required": [
          "fragments"
        ]
      },
      "else": {
        "properties": {
          "fragments": false
        }
      }
    },
    "functionRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "method",
        "path",
        "module",
        "export"
      ],
      "properties": {
        "kind": {
          "const": "function"
        },
        "method": {
          "$ref": "#/$defs/method"
        },
        "path": {
          "$ref": "#/$defs/routePath"
        },
        "module": {
          "$ref": "#/$defs/moduleId"
        },
        "export": {
          "$ref": "#/$defs/method"
        },
        "guard": {
          "$ref": "#/$defs/guard"
        }
      }
    },
    "pageRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "description": "Version 1. Field combinations (.html only, .ts only, pair) are checked by V15.",
      "properties": {
        "kind": {
          "const": "page"
        },
        "path": {
          "$ref": "#/$defs/routePath"
        },
        "module": {
          "$ref": "#/$defs/moduleId"
        },
        "load": {
          "type": "boolean"
        },
        "actions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          }
        },
        "template": {
          "$ref": "#/$defs/templateId"
        },
        "guard": {
          "$ref": "#/$defs/guard"
        }
      }
    },
    "cspSource": {
      "type": "string",
      "maxLength": 256,
      "description": "https origin with an optional *. host wildcard and path, data:, blob:, or (with allow_unsafe, V16) 'unsafe-inline' / 'unsafe-eval'.",
      "pattern": "^(https://(\\*\\.)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+(:[0-9]{1,5})?(/[A-Za-z0-9._~%!$&()*+,;=:@/-]*)?|data:|blob:|'unsafe-inline'|'unsafe-eval')$"
    },
    "origin": {
      "type": "string",
      "maxLength": 270,
      "pattern": "^https?://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*(:[0-9]{1,5})?$"
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "description": "Version 1: renox.toml [security], resolved. Absent fields take the docs/04 defaults (artifact.md section 3, Security).",
      "properties": {
        "csp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "script_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "style_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "img_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "connect_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "frame_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "font_src": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cspSource"
              }
            },
            "allow_unsafe": {
              "type": "boolean"
            },
            "report_only": {
              "type": "boolean"
            }
          }
        },
        "cors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "origins": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/origin"
              }
            },
            "methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/method"
              }
            },
            "headers": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]{1,64}$"
              }
            },
            "credentials": {
              "type": "boolean"
            },
            "max_age_s": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400
            }
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "referrer_policy": {
              "enum": [
                "no-referrer",
                "no-referrer-when-downgrade",
                "origin",
                "origin-when-cross-origin",
                "same-origin",
                "strict-origin",
                "strict-origin-when-cross-origin"
              ]
            },
            "permissions_allow": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            }
          }
        },
        "ratelimit": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "path",
              "requests",
              "window_s",
              "key"
            ],
            "properties": {
              "method": {
                "$ref": "#/$defs/method"
              },
              "path": {
                "$ref": "#/$defs/routePath"
              },
              "requests": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "window_s": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "key": {
                "enum": [
                  "ip"
                ],
                "description": "\"user\" is reserved for F4."
              }
            }
          }
        }
      }
    },
    "installedName": {
      "type": "string",
      "description": "A module name (manifest.md MF1; V17 checks the rest).",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "dottedName": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]{0,63}(\\.[a-z][a-z0-9_]{0,63})+$"
    },
    "secretName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "modulePermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "secrets",
        "slots",
        "hooks"
      ],
      "properties": {
        "tables": {
          "type": "string",
          "maxLength": 40,
          "description": "Exactly \"<name>__*\" (V17)."
        },
        "network": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/networkEntry"
          }
        },
        "secrets": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/secretName"
          }
        },
        "slots": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dottedName"
          }
        },
        "hooks": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dottedName"
          }
        },
        "roles": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "description": "Version 1.3: the roles the module may assign, exactly the keys of its authz.default_roles (V22)."
        }
      }
    },
    "moduleEntry": {
      "type": "object",
      "additionalProperties": false,
      "description": "One installed module (artifact.md section 3, \"Modules\"). Every field but exports is copied from its renox.lock entry (V17). Version 1.3 adds authz and realtime, copied from the module's manifest.",
      "required": [
        "name",
        "version",
        "hash",
        "source",
        "mount",
        "isolation",
        "dependencies",
        "config",
        "permissions",
        "approved",
        "exports"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/installedName"
        },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "hash": {
          "type": "string",
          "description": "SHA-256 of the module tree (manifest.md section 5).",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(official|path:(?![/\\\\])(?![A-Za-z]:)[^\\u0000-\\u001f\\\\:]+|git:https://[A-Za-z0-9._~%/-]+(:[0-9]{1,5})?[A-Za-z0-9._~%/-]*#[0-9a-f]{40}|registry:[a-z0-9][a-z0-9-]{0,38}/[a-z][a-z0-9_]{0,31})$"
        },
        "mount": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(/|(/[A-Za-z0-9._~-]+)+)$"
        },
        "isolation": {
          "enum": [
            "shared",
            "isolate"
          ]
        },
        "dependencies": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/installedName"
          }
        },
        "config": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        },
        "permissions": {
          "$ref": "#/$defs/modulePermissions",
          "description": "What the module gets at run time: its manifest's [permissions] (V22: a subset of approved)."
        },
        "approved": {
          "$ref": "#/$defs/modulePermissions",
          "description": "The renox.lock approved snapshot."
        },
        "exports": {
          "type": "object",
          "additionalProperties": false,
          "description": "The module's public API from its manifest [exports]: what the broker checks calls, hooks, and events against (ops.md 1.3.0).",
          "properties": {
            "services": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
              }
            },
            "events": {
              "type": "object",
              "maxProperties": 256,
              "propertyNames": {
                "$ref": "#/$defs/dottedName"
              },
              "additionalProperties": {
                "type": "object",
                "description": "The payload schema."
              }
            },
            "hooks": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/dottedName"
              }
            },
            "views": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9_]*__public_[a-z0-9_]+_v[1-9][0-9]*$"
              }
            }
          }
        },
        "authz": {
          "$ref": "#/$defs/authz"
        },
        "realtime": {
          "$ref": "#/$defs/realtime"
        },
        "storage": {
          "$ref": "#/$defs/moduleStorage"
        }
      }
    },
    "overridesIndex": {
      "type": "object",
      "additionalProperties": false,
      "description": "overrides.json at the artifact root (version 1.1, V20): each file under overrides/ with the template it replaces and the sha256 of the original module file at the installed version.",
      "required": [
        "version",
        "files"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "version": {
          "const": 0
        },
        "files": {
          "type": "object",
          "maxProperties": 1000,
          "propertyNames": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^[a-z][a-z0-9_]{0,31}/(pages|partials)(/(?!\\.\\.?(/|$))[A-Za-z0-9_.\\[\\]-]+)+\\.html$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "template",
              "original_sha256"
            ],
            "properties": {
              "template": {
                "$ref": "#/$defs/templateId"
              },
              "original_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "entryInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exports"
      ],
      "description": "Version 1.2: what renox build recorded for one code entry (artifact.md section 3, \"Entries\").",
      "properties": {
        "exports": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,127}$"
          },
          "description": "The module's static export names, sorted."
        },
        "eager": {
          "type": "boolean",
          "description": "true: evaluated at isolate creation. false (route modules only): evaluated on the first request that needs it. Default true."
        }
      }
    },
    "actionName": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]{0,63}(\\.[a-z][a-z0-9_]{0,63})+$",
      "description": "An authorization action, <resource>.<verb> (docs/11-authorization.md; manifest.md [authz])."
    },
    "tableName": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]{0,31}__[a-z0-9_]{1,64}$",
      "description": "A table under a module prefix (app__ for the app); V25 and V26 check the owner."
    },
    "columnName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "description": "Version 1.3: the module's export const guard (ops.md section 17), evaluated by the cell before the handler and on fragment requests. resource.id is a literal or :<param> of the route's pattern (V25).",
      "properties": {
        "action": {
          "$ref": "#/$defs/actionName"
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^([a-z][a-z0-9_]{0,31}:)?[A-Z][A-Za-z0-9_]{0,63}$"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "authz": {
      "type": "object",
      "additionalProperties": false,
      "description": "Version 1.3 (artifact.md section 3, \"Authorization and realtime\"): the resolved [authz] of the app (renox.toml) or of a module (module.toml, on its entry). V25 and V26 check the references.",
      "properties": {
        "actions": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/actionName"
          }
        },
        "ownership": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "$ref": "#/$defs/tableName"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner"
            ],
            "properties": {
              "owner": {
                "$ref": "#/$defs/columnName"
              },
              "org": {
                "$ref": "#/$defs/columnName"
              }
            }
          }
        },
        "entities": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attrs"
            ],
            "properties": {
              "table": {
                "$ref": "#/$defs/tableName"
              },
              "id": {
                "$ref": "#/$defs/columnName"
              },
              "attrs": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/columnName"
                }
              }
            }
          }
        },
        "default_roles": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/actionName"
            }
          }
        },
        "sensitive": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/actionName"
          }
        }
      }
    },
    "realtime": {
      "type": "object",
      "additionalProperties": false,
      "description": "Version 1.3: the resolved [realtime] of the app or of a module. feeds: table -> topic pattern with {column} placeholders (ops.md section 18, \"Change feed\"; V26).",
      "properties": {
        "feeds": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "$ref": "#/$defs/tableName"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^([A-Za-z0-9_.-]|\\{[a-z][a-z0-9_]{0,63}\\})+(:([A-Za-z0-9_.-]|\\{[a-z][a-z0-9_]{0,63}\\})+)*$",
            "description": "A topic pattern: segments split on ':', none empty, with {column} placeholders (ops.md section 18)."
          }
        }
      }
    },
    "realtimeRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "module"
      ],
      "description": "Version 1.3: a ws (functions/ws/**) or sse (functions/sse/**) route; GET only in the matcher (V8); the module exports ws or sse (ops.md section 18).",
      "properties": {
        "kind": {
          "enum": [
            "ws",
            "sse"
          ]
        },
        "path": {
          "$ref": "#/$defs/routePath"
        },
        "module": {
          "$ref": "#/$defs/moduleId"
        },
        "guard": {
          "$ref": "#/$defs/guard"
        }
      }
    },
    "toolRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "module",
        "description",
        "input",
        "action"
      ],
      "description": "Version 1.3: an App MCP tool of the app (functions/tools/*) or of a module ([[tools]], modules/<name>/tools/*); reached through /mcp, no path (ops.md section 19). V25 checks name uniqueness, the action and the input keywords.",
      "properties": {
        "kind": {
          "const": "tool"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "module": {
          "$ref": "#/$defs/moduleId"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "input": {
          "type": "object",
          "description": "JSON Schema (the keyword subset of validate.ts) derived from the tool's input schema."
        },
        "action": {
          "$ref": "#/$defs/actionName"
        },
        "confirm": {
          "type": "boolean"
        }
      }
    },
    "jobRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "module",
        "schedule"
      ],
      "description": "Version 1.3: a scheduled job of the app (jobs/*) or of a module (modules/<name>/jobs/*); no path (ops.md section 20). V27 checks the schedule and tz.",
      "properties": {
        "kind": {
          "const": "job"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "module": {
          "$ref": "#/$defs/moduleId"
        },
        "schedule": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[0-9*,/-]+ [0-9*,/-]+ [0-9*,/-]+ [0-9*,/-]+ [0-9*,/-]+$",
          "description": "Five fields: minute hour day-of-month month day-of-week; numbers, *, lists, ranges, steps (V27)."
        },
        "tz": {
          "type": "string",
          "pattern": "^(UTC|[A-Za-z_]+(/[A-Za-z0-9_+-]+){1,2})$",
          "description": "IANA zone, checked against Intl by V27; UTC when absent."
        }
      }
    },
    "webhookRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "module",
        "export"
      ],
      "description": "Version 1.4: an inbound webhook of the app (functions/webhooks/*) or of a module; POST only, CSRF-exempt, no guard (ops.md section 22). V28 checks the module and the path.",
      "properties": {
        "kind": {
          "const": "webhook"
        },
        "path": {
          "$ref": "#/$defs/routePath"
        },
        "module": {
          "$ref": "#/$defs/moduleId"
        },
        "export": {
          "const": "POST"
        },
        "provider": {
          "enum": [
            "stripe",
            "checkout",
            "telr",
            "paytabs",
            "ngenius",
            "tabby",
            "tamara",
            "apple",
            "google",
            "generic"
          ]
        }
      }
    },
    "storageTypes": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 127,
        "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,62}/[a-z0-9][a-z0-9!#$&^_.+-]{0,62}$"
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Version 1.4: the app's renox.toml [storage] (artifact.md section 3, \"Storage, AI, and the SBOM\"; ops.md section 21).",
      "properties": {
        "allowed_types": {
          "$ref": "#/$defs/storageTypes"
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "widths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 16,
                "maximum": 4096
              },
              "description": "Ascending (V29)."
            }
          }
        }
      }
    },
    "moduleStorage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Version 1.4: a module's [storage] from its module.toml; images widths are the app's.",
      "properties": {
        "allowed_types": {
          "$ref": "#/$defs/storageTypes"
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "description": "Version 1.4: the app's renox.toml [ai] (ops.md section 23).",
      "properties": {
        "mode": {
          "enum": [
            "direct",
            "gateway"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "Version 0 has no templates, no security, no modules or slots, and only function routes.",
      "if": {
        "required": [
          "artifact"
        ],
        "properties": {
          "artifact": {
            "required": [
              "version"
            ],
            "properties": {
              "version": {
                "const": 0
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "templates": false,
          "security": false,
          "routes": {
            "items": {
              "properties": {
                "kind": {
                  "const": "function"
                }
              }
            }
          },
          "slots": false,
          "modules": {
            "type": "object",
            "maxProperties": 0
          },
          "authz": false,
          "realtime": false,
          "storage": false,
          "ai": false
        }
      }
    }
  ]
}
