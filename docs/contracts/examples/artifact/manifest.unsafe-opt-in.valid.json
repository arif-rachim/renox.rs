{
  "$comment": "valid: 'unsafe-eval' with the explicit csp.allow_unsafe opt-in (artifact.md V16)",
  "artifact": {
    "version": 1
  },
  "app": {
    "name": "shop",
    "timezone": "UTC"
  },
  "code": {
    "format": "esm-dir",
    "entry": {
      "pages/products/[id]": "pages/products/[id].js"
    }
  },
  "routes": [
    {
      "kind": "page",
      "path": "/products/:id",
      "module": "pages/products/[id]",
      "load": true,
      "actions": [
        "addToCart"
      ],
      "template": "pages/products/[id]"
    }
  ],
  "templates": {
    "pages/_layouts/main": {
      "kind": "layout"
    },
    "pages/products/[id]": {
      "kind": "page",
      "fragments": {
        "product": {
          "target": "product"
        },
        "cart_badge": {
          "target": "cart-badge"
        }
      }
    }
  },
  "permissions": {
    "network": [],
    "secrets": []
  },
  "security": {
    "csp": {
      "script_src": [
        "'unsafe-eval'"
      ],
      "allow_unsafe": true
    }
  }
}
