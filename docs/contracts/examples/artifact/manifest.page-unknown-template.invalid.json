{
  "$comment": "invalid: the page's template is not a key of templates (artifact.md V15) [expect: V15]",
  "artifact": {
    "version": 1
  },
  "app": {
    "name": "shop",
    "timezone": "UTC"
  },
  "code": {
    "format": "esm-dir",
    "entry": {
      "pages/products/[id]": "pages/products/[id].js"
    }
  },
  "routes": [
    {
      "kind": "page",
      "path": "/products/:id",
      "module": "pages/products/[id]",
      "load": true,
      "actions": [
        "addToCart"
      ],
      "template": "pages/products/show"
    }
  ],
  "templates": {
    "pages/_layouts/main": {
      "kind": "layout"
    },
    "pages/products/[id]": {
      "kind": "page",
      "fragments": {
        "product": {
          "target": "product"
        },
        "cart_badge": {
          "target": "cart-badge"
        }
      }
    }
  },
  "permissions": {
    "network": [],
    "secrets": []
  }
}
